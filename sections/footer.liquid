{%- comment -%}
  PLACEHOLDER — the real footer (menu blocks, newsletter, social, locale and
  currency selectors) is phase 2, build spec §9.
{%- endcomment -%}

{%- if settings.show_seam_dividers -%}
  <hr class="seam seam--inset">
{%- endif -%}

<div class="section footer">
  <div class="page-width">
    <div class="footer__inner">
      <nav class="footer__menu" aria-label="{{ 'general.menu' | t }}">
        <ul class="cluster">
          {%- for link in section.settings.menu.links -%}
            <li><a class="link text-body-sm" href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>

      {%- if section.settings.show_payment_icons -%}
        <ul class="cluster footer__payment">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <p class="footer__copyright caption">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
