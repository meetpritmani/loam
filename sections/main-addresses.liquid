{%- comment -%}
  Customer addresses. Handles: zero saved addresses, editing an existing
  address, deleting an address, and countries with no provinces.

  The add/edit forms use <details> so they work with JavaScript disabled;
  rpl-customer.js only upgrades the province field and adds delete confirmation.
{%- endcomment -%}

<script src="{{ 'rpl-customer.js' | asset_url }}" defer="defer"></script>

<div class="rpl-color-{{ section.settings.color_scheme }}">
  <div class="rpl-container rpl-container--narrow rpl-section">
    <h1>{{ 'customer.addresses.title' | t }}</h1>
    <p><a href="{{ routes.account_url }}">{{ 'customer.account.return' | t }}</a></p>

    <details class="rpl-address__new">
      <summary class="rpl-button">{{ 'customer.addresses.add_new' | t }}</summary>

      {%- form 'customer_address', customer.new_address, data-address-form: '' -%}
        {% render 'address-fields', form: form, address: customer.new_address, id_prefix: 'AddressNew' %}
        <div class="rpl-account-form__actions">
          <button class="rpl-button" type="submit">{{ 'customer.addresses.add' | t }}</button>
        </div>
      {%- endform -%}
    </details>

    {%- if customer.addresses.size > 0 -%}
      <ul class="rpl-list-unstyled rpl-address-list">
        {%- paginate customer.addresses by 10 -%}
          {%- for address in customer.addresses -%}
            {%- liquid
              assign id_prefix = 'Address' | append: address.id
              assign delete_message = 'customer.addresses.delete_confirm' | t
            -%}
            <li class="rpl-address">
              {%- if address == customer.default_address -%}
                <p class="rpl-badge rpl-badge--subtle">{{ 'customer.addresses.default' | t }}</p>
              {%- endif -%}

              {{ address | format_address }}

              <div class="rpl-address__actions">
                <details>
                  <summary class="rpl-button rpl-button--secondary">{{ 'customer.addresses.edit' | t }}</summary>
                  {%- form 'customer_address', address, data-address-form: '' -%}
                    {% render 'address-fields', form: form, address: address, id_prefix: id_prefix %}
                    <div class="rpl-account-form__actions">
                      <button class="rpl-button" type="submit">{{ 'customer.addresses.update' | t }}</button>
                    </div>
                  {%- endform -%}
                </details>

                <form method="post" action="{{ address.url }}" data-address-delete="{{ delete_message | escape }}">
                  <input type="hidden" name="_method" value="delete">
                  <button class="rpl-button rpl-button--secondary" type="submit">
                    {{- 'customer.addresses.delete' | t -}}
                  </button>
                </form>
              </div>
            </li>
          {%- endfor -%}

          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      </ul>
    {%- else -%}
      <p class="rpl-muted">{{ 'customer.addresses.none' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .rpl-address__new {
    margin-block: var(--rpl-space-md);
  }

  .rpl-address__new > summary,
  .rpl-address__actions summary {
    display: inline-flex;
    list-style: none;
  }

  .rpl-address__new > summary::-webkit-details-marker,
  .rpl-address__actions summary::-webkit-details-marker {
    display: none;
  }

  .rpl-address-list {
    display: grid;
    gap: var(--rpl-space-md);
  }

  .rpl-address {
    padding-block-end: var(--rpl-space-md);
    border-block-end: 1px solid rgb(var(--rpl-color-foreground) / 0.12);
  }

  .rpl-address__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--rpl-space-2xs);
    margin-block-start: var(--rpl-space-2xs);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_addresses.name",
  "tag": "section",
  "class": "rpl-section-main-addresses",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
