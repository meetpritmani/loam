{%- comment -%}
  main-blog.liquid — the journal index.

  §9.4: every card links through, and the list ends in a capture point rather
  than in pagination. A blog is the top of a funnel; a reader who finishes
  scrolling and finds nothing to do goes back to wherever they came from.

  Tag filtering is a plain list of links to Shopify's own `/blogs/x/tagged/y`
  routes. No JavaScript, no hand-built query strings, and the current tag is
  marked with aria-current so the filter is legible to assistive tech and not
  only by colour.

  A blog with no posts is a real state on a fresh install, so it renders an
  empty state with a route into the catalogue rather than a bare heading over
  nothing.
{%- endcomment -%}

{%- liquid
  assign card_sizes = '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 92vw'

  assign recovery = settings.cro_empty_cart_collection
  assign recovery_url = recovery.url | default: routes.all_products_collection_url

  assign show_tags = false
  if section.settings.show_tags and blog.all_tags.size > 0
    assign show_tags = true
  endif
-%}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="blog-list">
      <div class="blog-list__header">
        <h1 class="h2">{{ blog.title | escape }}</h1>

        {%- if section.settings.description != blank -%}
          <p class="blog-list__intro text-muted">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>

      {%- if show_tags -%}
        <nav class="blog-list__tags" aria-label="{{ 'blog.filter_by_tag' | t }}">
          <ul class="cluster">
            <li>
              <a
                class="blog-list__tag"
                href="{{ blog.url }}"
                {% if current_tags == empty %}aria-current="page"{% endif %}
              >
                {{- 'blog.all_posts' | t -}}
              </a>
            </li>
            {%- for tag in blog.all_tags -%}
              <li>
                <a
                  class="blog-list__tag"
                  href="{{ blog.url }}/tagged/{{ tag | handleize }}"
                  {% if current_tags contains tag %}aria-current="page"{% endif %}
                >
                  {{- tag | escape -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if blog.articles_count == 0 -%}
        {%- liquid
          assign empty_heading = 'blog.empty_heading' | t
          assign empty_text = 'blog.empty_text' | t
          assign empty_label = 'cart.continue_shopping' | t
        -%}
        {%- render 'empty-state',
          heading: empty_heading,
          text: empty_text,
          link_url: recovery_url,
          link_label: empty_label,
          icon: 'leaf'
        -%}
      {%- else -%}
        {%- paginate blog.articles by section.settings.posts_per_page -%}
          <ul class="grid blog-list__grid" style="--grid-cols: {{ section.settings.columns }}; --grid-cols-tablet: 2; --grid-cols-mobile: 1;">
            {%- for article in blog.articles -%}
              {%- comment -%}
                The first card is the LCP candidate on this template, so it
                loads eagerly. `forloop.first | default: 'lazy'` looks like it
                would do this and does not — `default` only replaces nil and
                false, so a true first iteration would emit loading="true".
              {%- endcomment -%}
              {%- liquid
                assign card_loading = 'lazy'
                if forloop.first
                  assign card_loading = 'eager'
                endif
              -%}
              <li>
                {%- render 'card-article',
                  article: article,
                  heading_tag: 'h2',
                  sizes: card_sizes,
                  loading: card_loading
                -%}
              </li>
            {%- endfor -%}
          </ul>

          {%- render 'pagination', paginate: paginate, anchor: '#main' -%}
        {%- endpaginate -%}
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%}
  §9.4: capture at the foot of the list. Below the posts, below pagination —
  a form placed between the reader and the next page of articles interrupts
  the thing they came to do.
{%- endcomment -%}
{%- if section.settings.show_newsletter -%}
  <div class="section color-{{ section.settings.newsletter_color_scheme }}">
    <div class="page-width">
      <div class="newsletter-section newsletter-section--center">
        {%- if section.settings.newsletter_heading != blank -%}
          <h2 class="h3">{{ section.settings.newsletter_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.newsletter_text != blank -%}
          <p class="text-muted">{{ section.settings.newsletter_text | escape }}</p>
        {%- endif -%}

        {%- assign blog_newsletter_id = 'blog-' | append: section.id -%}
        {%- render 'newsletter-form',
          id: blog_newsletter_id,
          class: 'newsletter-section__form',
          fine_print: section.settings.newsletter_fine_print
        -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main_blog.name",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-paper"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.main_blog.description.label",
      "default": "Field notes on materials, wear and repair. Written by the people who make the shoes."
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:sections.main_blog.show_tags.label",
      "default": true
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.main_blog.columns.label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "t:sections.main_blog.posts_per_page.label",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    },
    {
      "type": "header",
      "content": "t:sections.main_blog.headers.newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.main_blog.show_newsletter.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "newsletter_color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-sand"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:labels.heading",
      "default": "Get first access."
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "t:labels.text",
      "default": "New colourways, restocks, and the occasional field note. Two emails a month, no more."
    },
    {
      "type": "text",
      "id": "newsletter_fine_print",
      "label": "t:sections.footer.blocks.newsletter.fine_print.label",
      "default": "Unsubscribe any time."
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 64
    }
  ]
}
{% endschema %}
