{%- comment -%}
  main-product.liquid — the product page (§9.7).

  Two columns on desktop: media on the left, a sticky info column on the
  right so Add to Cart stays reachable however long the description runs.
  One column on mobile, media first.

  The info column is built from blocks so a merchant can reorder it. The
  order that ships puts title, price and the picker above the fold at 375px
  with Add to Cart immediately beneath — that is the §9.7 requirement and the
  reason the preset order is what it is.

  App blocks are supported (`@app`), which the Theme Store requires.
{%- endcomment -%}

{%- liquid
  comment
    section_id has to be the section's REAL id, unprefixed — it doubles as
    the Section Rendering API's `section_id` query param (see
    VariantPicker.refreshRegions in global.js, which builds
    `productUrl + '?variant=...&section_id=' + this.section`). A "product-"
    prefix was on this line before, presumably meant only to namespace the
    HTML element ids built from it below (qty_id, the lightbox ids, buy-
    buttons' form_id) — but Shopify's Section Rendering API takes it
    literally too, and a section_id that does not name a real section on
    the current template 404s outright rather than degrading, which is
    exactly what broke every variant click on this page. section.id
    (e.g. `template--21279671484486__main`) is already unique enough on
    its own to double as the HTML id prefix; nothing needs the extra text.
  endcomment
  assign current = product.selected_or_first_available_variant
  assign section_id = section.id
  assign media_count = product.media.size
-%}

{%- comment -%}
  The id the recently-viewed row reads. It lives on this section rather than
  on that one so the list still records a visit when a merchant has removed
  the recently-viewed section from the template.
{%- endcomment -%}
<div
  class="section color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
  data-recently-viewed-id="{{ product.id }}"
>
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}
      {%- render 'breadcrumbs', class: 'product__breadcrumbs' -%}
    {%- endif -%}

    <div class="product">
      {%- comment -%}
        ---------------- Media ----------------
        A stacked grid, not a single stage with thumbnails: every image
        renders at once, two per row, and each one is a lightbox trigger
        rather than a swap target. Variant switching still needs a media
        target to land on, so `<product-gallery>` keeps `data-media-id` per
        item and scrolls to it — see `show()` in global.js.
      {%- endcomment -%}
      <product-gallery class="product__gallery" data-count="{{ media_count }}">
        {%- if media_count > 0 -%}
          {%- for media in product.media -%}
            {%- liquid
              assign img_loading = 'lazy'
              assign img_priority = 'auto'
              if forloop.first
                assign img_loading = 'eager'
                assign img_priority = 'high'
              endif
              assign media_alt = media.alt | default: product.title
            -%}
            <div class="product__gallery-item media media--{{ section.settings.image_ratio }}" data-media-id="{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  <button
                    type="button"
                    class="product__gallery-trigger"
                    data-drawer-toggle
                    aria-controls="pdp-lightbox-{{ section_id }}-{{ forloop.index }}"
                    aria-label="{{ 'products.product.view_larger' | t }} {{ forloop.index }}"
                  >
                    {%- render 'image-fallback',
                      image: media,
                      fallback: 'demo-product-1.webp',
                      alt: media_alt,
                      sizes: '(min-width: 990px) 25vw, 50vw',
                      widths: '400, 600, 800, 1000, 1200',
                      loading: img_loading,
                      fetchpriority: img_priority
                    -%}
                    <span class="product__gallery-zoom" aria-hidden="true">
                      {%- render 'icon', icon: 'search', size: 16 -%}
                    </span>
                  </button>
                {%- when 'video' -%}
                  {{ media | video_tag: image_size: '1200x', controls: true, muted: true }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- when 'model' -%}
                  {{ media | model_viewer_tag }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%}
            A product with no media still has to look deliberate — this is the
            state a merchant sees while they are still uploading.
          {%- endcomment -%}
          <div class="product__gallery-item media media--{{ section.settings.image_ratio }}">
            {%- render 'image-fallback',
              fallback: 'demo-product-1.webp',
              alt: product.title,
              sizes: '(min-width: 990px) 25vw, 50vw',
              widths: '400, 600, 800, 1000, 1200',
              loading: 'eager',
              fetchpriority: 'high'
            -%}
          </div>
        {%- endif -%}
      </product-gallery>

      {%- comment -%}
        ---------------- Lightboxes ----------------
        One <loam-drawer> per image rather than one shared drawer whose
        content gets swapped — that reuses the drawer's existing dialog
        semantics, focus trap, Escape-to-close and scroll lock exactly as
        built, with no new JS at all. `.drawer__panel--lightbox` is the only
        new CSS: a centred, scale-and-fade panel instead of the side-slide
        every other drawer in the theme uses.
      {%- endcomment -%}
      {%- if media_count > 0 -%}
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            {%- liquid
              assign lightbox_id = 'pdp-lightbox-' | append: section_id | append: '-' | append: forloop.index
              assign lightbox_title_id = lightbox_id | append: '-title'
              assign lightbox_alt = media.alt | default: product.title
            -%}
            <loam-drawer id="{{ lightbox_id }}">
              <div class="drawer" role="dialog" aria-modal="true" aria-labelledby="{{ lightbox_title_id }}">
                <div class="drawer__overlay drawer__overlay--lightbox" data-drawer-close></div>
                <div class="drawer__panel drawer__panel--lightbox">
                  <h2 class="visually-hidden" id="{{ lightbox_title_id }}">
                    {{ product.title | escape }} — {{ 'products.product.media_gallery' | t }} {{ forloop.index }}
                  </h2>
                  <button
                    type="button"
                    class="icon-button drawer__lightbox-close"
                    data-drawer-close
                    aria-label="{{ 'accessibility.close_drawer' | t }}"
                  >
                    {%- render 'icon', icon: 'close' -%}
                  </button>
                  <div class="drawer__lightbox-media">
                    {%- render 'image-fallback',
                      image: media,
                      fallback: 'demo-product-1.webp',
                      alt: lightbox_alt,
                      class: 'drawer__lightbox-img',
                      sizes: '90vw',
                      widths: '600, 900, 1200, 1600, 2000',
                      loading: 'lazy'
                    -%}
                  </div>
                </div>
              </div>
            </loam-drawer>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%} ---------------- Info ---------------- {%- endcomment -%}
      <div class="product__info">
        <div class="product__info-inner" data-product-info>
          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when 'vendor' -%}
                {%- if product.vendor != blank -%}
                  <p class="product__vendor caption" {{ block.shopify_attributes }}>
                    {{- product.vendor | escape -}}
                  </p>
                {%- endif -%}

              {%- when 'title' -%}
                <h1 class="product__title h2" {{ block.shopify_attributes }}>
                  {{- product.title | escape -}}
                </h1>

              {%- when 'badges' -%}
                <div {{ block.shopify_attributes }}>
                  {%- render 'product-badges', product: product, variant: current -%}
                </div>

              {%- when 'price' -%}
                <div class="product__price" data-price-target {{ block.shopify_attributes }}>
                  {%- render 'price', product: product, variant: current, show_tax_note: true -%}
                </div>

              {%- when 'material' -%}
                {%- assign material = product.metafields.custom.material -%}
                {%- if material != blank -%}
                  <div {{ block.shopify_attributes }}>
                    {%- render 'material-tag',
                      material: material,
                      composition: product.metafields.custom.material_composition.value,
                      story: product.metafields.custom.material_story.value
                    -%}
                  </div>
                {%- endif -%}

              {%- when 'carbon' -%}
                {%- assign footprint = product.metafields.custom.carbon_footprint -%}
                {%- if footprint != blank -%}
                  <p class="product__carbon caption" {{ block.shopify_attributes }}>
                    {%- render 'icon', icon: 'leaf', size: 16 -%}
                    <span>{{ 'products.product.carbon_footprint_html' | t: amount: footprint }}</span>
                  </p>
                {%- endif -%}

              {%- when 'variant_picker' -%}
                <div {{ block.shopify_attributes }}>
                  {%- render 'variant-picker', product: product, section_id: section_id -%}
                  {%- if block.settings.show_size_guide -%}
                    {%- render 'size-guide', product: product, section_id: section_id -%}
                  {%- endif -%}
                </div>

              {%- when 'low_stock' -%}
                <div data-low-stock {{ block.shopify_attributes }}>
                  {%- render 'low-stock', variant: current -%}
                </div>

              {%- when 'buy_buttons' -%}
                <div class="product__buy" data-buy-block {{ block.shopify_attributes }}>
                  {%- render 'buy-buttons',
                    product: product,
                    section_id: section_id,
                    show_qty: block.settings.show_quantity
                  -%}
                </div>

              {%- when 'pickup' -%}
                {%- comment -%}
                  Theme Store requirement: pickup availability, without
                  adding to cart. store_availabilities belongs to the
                  variant, not the product, so this fetches its own
                  section rather than rendering synchronously — see the
                  comment in pickup-availability.liquid and the
                  <pickup-availability> element in global.js.
                {%- endcomment -%}
                <pickup-availability
                  class="pickup-availability"
                  data-root-url="{{ routes.root_url }}"
                  data-variant-id="{{ current.id }}"
                  {{ block.shopify_attributes }}
                ></pickup-availability>

              {%- when 'trust' -%}
                <div {{ block.shopify_attributes }}>
                  {%- render 'trust-row', show_payment: settings.cro_show_payment_icons_pdp -%}
                </div>

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="product__description rte" {{ block.shopify_attributes }}>
                    {{- product.description -}}
                  </div>
                {%- endif -%}

              {%- when 'accordion' -%}
                {%- liquid
                  assign body = block.settings.content
                  if block.settings.source == 'care' and product.metafields.custom.care != blank
                    assign body = product.metafields.custom.care
                  elsif block.settings.source == 'description' and product.description != blank
                    assign body = product.description
                  endif
                -%}
                <div class="accordion" {{ block.shopify_attributes }}>
                  {%- render 'accordion',
                    heading: block.settings.heading,
                    content: body,
                    open: block.settings.open
                  -%}
                </div>

              {%- when 'share' -%}
                {%- assign share_url = request.origin | append: product.url -%}
                <div {{ block.shopify_attributes }}>
                  {%- render 'share', url: share_url, title: product.title -%}
                </div>

              {%- when '@app' -%}
                {%- render block -%}

            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- render 'sticky-atc', product: product, section_id: section_id -%}

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "t:sections.main_product.blocks.vendor.name", "limit": 1 },
    { "type": "title", "name": "t:sections.main_product.blocks.title.name", "limit": 1 },
    { "type": "badges", "name": "t:sections.main_product.blocks.badges.name", "limit": 1 },
    { "type": "price", "name": "t:sections.main_product.blocks.price.name", "limit": 1 },
    { "type": "material", "name": "t:sections.main_product.blocks.material.name", "limit": 1 },
    { "type": "carbon", "name": "t:sections.main_product.blocks.carbon.name", "limit": 1 },
    {
      "type": "variant_picker",
      "name": "t:sections.main_product.blocks.variant_picker.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_size_guide",
          "label": "t:sections.main_product.blocks.variant_picker.show_size_guide.label",
          "info": "t:sections.main_product.blocks.variant_picker.show_size_guide.info",
          "default": true
        }
      ]
    },
    { "type": "low_stock", "name": "t:sections.main_product.blocks.low_stock.name", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "t:sections.main_product.blocks.buy_buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_quantity",
          "label": "t:sections.main_product.blocks.buy_buttons.show_quantity.label",
          "default": true
        }
      ]
    },
    { "type": "pickup", "name": "t:sections.main_product.blocks.pickup.name", "limit": 1 },
    { "type": "trust", "name": "t:sections.main_product.blocks.trust.name", "limit": 1 },
    { "type": "description", "name": "t:sections.main_product.blocks.description.name", "limit": 1 },
    {
      "type": "accordion",
      "name": "t:sections.main_product.blocks.accordion.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Shipping & returns"
        },
        {
          "type": "select",
          "id": "source",
          "label": "t:sections.main_product.blocks.accordion.source.label",
          "options": [
            { "value": "custom", "label": "t:sections.main_product.blocks.accordion.source.options.custom" },
            { "value": "care", "label": "t:sections.main_product.blocks.accordion.source.options.care" },
            { "value": "description", "label": "t:sections.main_product.blocks.accordion.source.options.description" }
          ],
          "default": "custom"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:labels.text",
          "default": "<p>Free returns for 30 days. Carbon neutral shipping on every order, arriving in two to four working days.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "t:sections.main_product.blocks.accordion.open.label",
          "info": "t:sections.main_product.blocks.accordion.open.info",
          "default": false
        }
      ]
    },
    { "type": "share", "name": "t:sections.main_product.blocks.share.name", "limit": 1 }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-paper"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:sections.main_product.show_breadcrumbs.label",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.product_cards.card_image_ratio.label",
      "options": [
        { "value": "square", "label": "t:settings.product_cards.card_image_ratio.options.square" },
        { "value": "portrait", "label": "t:settings.product_cards.card_image_ratio.options.portrait" },
        { "value": "landscape", "label": "t:settings.product_cards.card_image_ratio.options.landscape" }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "label": "t:labels.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "label": "t:labels.padding_bottom",
      "default": 64
    }
  ]
}
{% endschema %}
