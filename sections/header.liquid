{%- comment -%}
  PLACEHOLDER — the real header (mega menu, predictive search, mobile drawer,
  cart count via Section Rendering API) is phase 2, build spec §9.

  This version already sits inside <sticky-header> and uses icon.liquid, so
  the shell, the sticky behaviour and the --header-height custom property are
  live and testable from phase 1.
{%- endcomment -%}

<sticky-header class="sticky-header" data-sticky="{{ section.settings.enable_sticky }}">
  <div class="header page-width">
    <a class="header__logo link" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        {%- render 'image-fallback',
          image: settings.logo,
          alt: shop.name,
          widths: '120,240,360,480',
          sizes: '(min-width: 750px) 200px, 140px',
          loading: 'eager'
        -%}
      {%- else -%}
        <span class="h4">{{ shop.name | escape }}</span>
      {%- endif -%}
    </a>

    <nav class="header__nav only-desktop" aria-label="{{ 'general.menu' | t }}">
      <ul class="cluster">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a
              class="link text-body-sm"
              href="{{ link.url }}"
              {% if link.active %}aria-current="page"{% endif %}
            >
              {{- link.title | escape -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__actions">
      <a class="icon-button" href="{{ routes.search_url }}" aria-label="{{ 'general.search' | t }}">
        {%- render 'icon', icon: 'search' -%}
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a
          class="icon-button only-desktop"
          href="{{ routes.account_url }}"
          aria-label="{{ 'general.account' | t }}"
        >
          {%- render 'icon', icon: 'account' -%}
        </a>
      {%- endif -%}

      <a class="icon-button" href="{{ routes.cart_url }}" aria-label="{{ 'accessibility.cart_count' | t: count: cart.item_count }}">
        {%- render 'icon', icon: 'cart' -%}
        {%- if cart.item_count > 0 -%}
          <span class="header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>
</sticky-header>

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "t:sections.header.enable_sticky.label",
      "default": true
    }
  ]
}
{% endschema %}
