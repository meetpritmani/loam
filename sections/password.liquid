{%- comment -%}
  PLACEHOLDER — rebuilt in phase 4 (build spec §9, Templates).
{%- endcomment -%}

<div class="section">
  <div class="page-width page-width--narrow text-center stack">
    <p class="caption">{{ 'password.opening_soon' | t }}</p>
    <h1 class="h1">{{ shop.name | escape }}</h1>

    {%- if shop.password_message != blank -%}
      <div class="rte">{{ shop.password_message }}</div>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="field__error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="field">
        <label class="field__label" for="password-input">{{ 'password.password' | t }}</label>
        <input
          class="field__input"
          type="password"
          name="password"
          id="password-input"
          autocomplete="current-password"
        >
      </div>

      <button class="button button--primary" type="submit">{{ 'password.enter' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": []
}
{% endschema %}
