{%- comment -%}
  PLACEHOLDER — rebuilt in phase 4 as main-collection-banner + main-collection
  with collection.filters, sort, and Section Rendering API pagination
  (build spec §9, Templates).
{%- endcomment -%}

<div class="section">
  <div class="page-width stack">
    <h1 class="h1">{{ collection.title | escape }}</h1>

    {%- paginate collection.products by 24 -%}
      <p class="caption">
        {{- 'collections.product_count' | t: count: collection.products_count -}}
      </p>

      <div class="grid" style="--grid-cols: 4; --grid-cols-mobile: 2;">
        {%- for product in collection.products -%}
          <div class="card">
            <a class="media media--portrait" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
              {%- render 'image-fallback',
                image: product.featured_image,
                alt: product.title,
                sizes: '(min-width: 990px) 25vw, 50vw'
              -%}
            </a>
            <div class="card__body">
              <h2 class="h5">
                <a class="card__link link" href="{{ product.url }}">{{ product.title | escape }}</a>
              </h2>
              <p class="price">{{ product.price | money }}</p>
            </div>
          </div>
        {%- else -%}
          <p class="text-muted">{{ 'collections.empty' | t }}</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="text-center" aria-label="{{ 'general.pagination.label' | t }}">
          {{- paginate | default_pagination -}}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "settings": []
}
{% endschema %}
