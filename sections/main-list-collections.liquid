{%- comment -%}
  Collection index. Handles a store with zero collections.
{%- endcomment -%}

{%- liquid
  assign collections_list = collections
  if section.settings.sort == 'alphabetical'
    assign collections_list = collections | sort: 'title'
  endif
-%}

<div class="rpl-color-{{ section.settings.color_scheme }}">
  <div class="rpl-container rpl-section">
    <h1>{{ 'sections.collection_list.title' | t }}</h1>

    {%- if collections_list.size > 0 -%}
      <ul class="rpl-grid rpl-collection-list">
        {%- for collection in collections_list -%}
          {%- assign collection_alt = collection.featured_image.alt | default: collection.title -%}
          <li class="rpl-reveal">
            <div class="rpl-card">
              {% render 'responsive-image',
                image: collection.featured_image,
                alt: collection_alt,
                loading: 'lazy',
                sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                widths: '330, 533, 720, 940, 1200',
                wrapper_ratio: 'landscape',
                placeholder: 'collection-1'
              %}
              <div class="rpl-card__content">
                <h2 class="rpl-card__title">
                  <a class="rpl-card__link" href="{{ collection.url }}">{{ collection.title | escape }}</a>
                </h2>
                {%- if collection.all_products_count > 0 -%}
                  <p class="rpl-caption rpl-muted">
                    {{- 'sections.collection_list.count' | t: count: collection.all_products_count -}}
                  </p>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="rpl-empty-state">
        <p class="rpl-muted">{{ 'sections.collection_list.empty' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .rpl-collection-list {
    --rpl-grid-columns-mobile: 1;
    --rpl-grid-columns-desktop: 3;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_list_collections.name",
  "tag": "section",
  "class": "rpl-section-list-collections",
  "settings": [
    {
      "type": "select",
      "id": "sort",
      "label": "t:sections.main_list_collections.settings.sort.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.main_list_collections.settings.sort.options__1.label"
        },
        {
          "value": "alphabetical",
          "label": "t:sections.main_list_collections.settings.sort.options__2.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
