# Copy to .env and fill in. .env is gitignored and must never be committed —
# `npm run check:secrets` refuses any staged file containing a shpat_ token.
#
# The app is created in the DEMO store only:
#   Settings -> Apps and sales channels -> Develop apps -> Create an app
#
# Scopes (§12.1):
#   write_products, read_products
#   write_files, read_files
#   write_content, read_content
#   write_themes, read_themes
#   write_online_store_navigation
#   write_publications, read_publications
#   write_metaobjects, read_metaobjects

SHOPIFY_STORE=fernway-demo.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pinned deliberately. Never `unstable`.
#
# The build spec pins 2025-07. That version reached end of life on
# 16 July 2026 and no longer resolves — Shopify "falls forward" to a newer
# version, which means a pinned request silently runs against a schema you did
# not choose. 2026-07 is the current stable release (Shopify ships quarterly on
# the first of the quarter; 2026-10 is not out yet).
#
# Re-check https://shopify.dev/docs/api/usage/versioning before a seeding run.
# Each stable version is supported for a minimum of 12 months.
SHOPIFY_API_VERSION=2026-07
