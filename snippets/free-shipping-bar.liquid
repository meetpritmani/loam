{%- comment -%}
  free-shipping-bar.liquid — progress toward the free-shipping threshold.

  §9.6: the figure is the real cart total measured against the merchant's own
  threshold, and the achieved state is rendered as well as the remaining one.
  A bar that only ever says "spend more" never tells the shopper they are
  already done, which is the moment it is actually worth showing.

  Threshold of 0, the setting switched off, or an empty cart → nothing is
  rendered at all. Not an empty wrapper: an empty wrapper still occupies its
  margin and shifts the first cart line down.

  Shared by the drawer and the cart page so the two can never disagree about
  how far away free shipping is.

  Params:
    class (string, optional)
{%- endcomment -%}

{%- liquid
  assign threshold = settings.cart_free_shipping_threshold | times: 100

  assign render_bar = false
  if settings.cart_show_free_shipping_bar and threshold > 0 and cart.item_count > 0
    assign render_bar = true
  endif

  assign remaining = threshold | minus: cart.total_price

  comment
    Formatted here, not inline in the `t:` call. A filter after a `t:`
    argument binds to the output of `t`, not to the argument, so
    `t: amount: remaining | money` would money-format the finished sentence.
  endcomment
  assign remaining_money = remaining | money

  comment
    Guarded: `divided_by: 0` is a Liquid error, not a zero, and a merchant
    who clears the threshold field would take the whole cart down with it.
  endcomment
  assign progress_percent = 0
  if threshold > 0
    assign progress_percent = cart.total_price | times: 100 | divided_by: threshold
    if progress_percent > 100
      assign progress_percent = 100
    endif
  endif
-%}

{%- if render_bar -%}
  <div class="shipping-bar {{ class }}">
    <p class="shipping-bar__label text-body-sm">
      {%- if remaining > 0 -%}
        {{ 'cart.free_shipping_progress_html' | t: amount: remaining_money }}
      {%- else -%}
        {%- render 'icon', icon: 'check', size: 14 -%}
        {{ 'cart.free_shipping_reached' | t }}
      {%- endif -%}
    </p>

    <div
      class="shipping-bar__track"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ progress_percent }}"
      aria-label="{{ 'cart.free_shipping_label' | t }}"
    >
      <span class="shipping-bar__fill" style="--progress: {{ progress_percent }}%;"></span>
    </div>
  </div>
{%- endif -%}
