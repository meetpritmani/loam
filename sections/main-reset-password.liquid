{%- comment -%}
  main-reset-password.liquid — set a new password from an emailed link.

  §9.5: "single clear action, success state routes onward to the store, never
  to a dead confirmation page." Shopify signs the customer in on success and
  redirects to the account page, so the onward route here is the one thing
  this template controls before that: a link back into the catalogue under
  the form, for anyone who arrives, changes their mind, and would otherwise
  have nowhere to go but the back button.

  One action on the page. Two password fields, because confirming a password
  you cannot see is worth the second field, and one button.
{%- endcomment -%}

{%- liquid
  assign recovery = settings.cro_empty_cart_collection
  assign recovery_url = recovery.url | default: routes.all_products_collection_url
-%}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width page-width--narrow">
    <div class="customer__panel customer__panel--single">
      <h1 class="h3">{{ 'customers.reset_password.title' | t }}</h1>
      <p class="text-muted">{{ 'customers.reset_password.subtext' | t }}</p>

      {%- form 'reset_customer_password', class: 'customer__form' -%}
        {%- if form.errors -%}
          <div class="customer__errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="reset-password">
            {{- 'customers.reset_password.password' | t -}}
          </label>
          <input
            class="field__input"
            id="reset-password"
            type="password"
            name="customer[password]"
            autocomplete="new-password"
            required
          >
        </div>

        <div class="field">
          <label class="field__label" for="reset-password-confirm">
            {{- 'customers.reset_password.password_confirm' | t -}}
          </label>
          <input
            class="field__input"
            id="reset-password-confirm"
            type="password"
            name="customer[password_confirmation]"
            autocomplete="new-password"
            required
          >
        </div>

        <button class="button button--primary button--full" type="submit">
          {{ 'customers.reset_password.submit' | t }}
        </button>
      {%- endform -%}

      <p class="customer__aside text-body-sm">
        <a class="link-underline" href="{{ recovery_url }}">
          {{- 'cart.continue_shopping' | t -}}
        </a>
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_reset_password.name",
  "tag": "section",
  "class": "section-main-reset-password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-paper"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 80
    }
  ]
}
{% endschema %}
