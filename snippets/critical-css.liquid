{%- comment -%}
  Critical CSS — inlined in <head> so above-the-fold content paints without a
  blocking stylesheet request. Deliberately kept small: reset, static tokens,
  type, container, skip link, focus ring, button base, header shell.

  Everything below the fold lives in assets/base.css, which is loaded
  non-render-blocking. Rule: if a style is not needed for the first viewport of
  the *slowest* template, it does not belong here.
{%- endcomment -%}

<style data-rpl-critical>
  :root {
    --rpl-space-3xs: 0.25rem;
    --rpl-space-2xs: 0.5rem;
    --rpl-space-xs: 0.75rem;
    --rpl-space-sm: 1rem;
    --rpl-space-md: 1.5rem;
    --rpl-space-lg: 2.5rem;
    --rpl-space-xl: 4rem;
    --rpl-space-2xl: 6rem;

    --rpl-radius-sm: 4px;
    --rpl-radius-full: 999px;

    --rpl-duration-fast: 120ms;
    --rpl-duration-base: 240ms;
    --rpl-duration-slow: 400ms;
    --rpl-ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);

    --rpl-focus-ring-width: 2px;
    --rpl-focus-ring-offset: 2px;

    --rpl-header-height: 4rem;
    --rpl-z-header: 40;
    --rpl-z-overlay: 60;
    --rpl-z-drawer: 70;
    --rpl-z-skip-link: 100;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: var(--rpl-font-body-family);
    font-style: var(--rpl-font-body-style);
    font-weight: var(--rpl-font-body-weight);
    font-size: calc(1rem * var(--rpl-font-body-scale));
    line-height: 1.6;
    letter-spacing: 0.005em;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    margin: 0 0 var(--rpl-space-sm);
    font-family: var(--rpl-font-heading-family);
    font-style: var(--rpl-font-heading-style);
    font-weight: var(--rpl-font-heading-weight);
    text-transform: var(--rpl-font-heading-transform);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  h1 {
    font-size: calc(clamp(1.75rem, 1.2rem + 2.2vw, 3rem) * var(--rpl-font-heading-scale));
  }

  h2 {
    font-size: calc(clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem) * var(--rpl-font-heading-scale));
  }

  h3 {
    font-size: calc(clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem) * var(--rpl-font-heading-scale));
  }

  h4 {
    font-size: calc(1.125rem * var(--rpl-font-heading-scale));
  }

  h5,
  h6 {
    font-size: calc(1rem * var(--rpl-font-heading-scale));
  }

  p {
    margin: 0 0 var(--rpl-space-sm);
  }

  a {
    color: currentcolor;
  }

  img,
  svg,
  video,
  iframe {
    max-width: 100%;
    height: auto;
    display: block;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
    color: inherit;
  }

  :focus-visible {
    outline: var(--rpl-focus-ring-width) solid rgb(var(--rpl-color-foreground));
    outline-offset: var(--rpl-focus-ring-offset);
    border-radius: var(--rpl-radius-sm);
  }

  .rpl-visually-hidden {
    position: absolute !important; /* documented: must win over any layout context to stay off-screen without display:none, which would hide it from screen readers */
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .rpl-skip-link {
    position: absolute;
    z-index: var(--rpl-z-skip-link);
    top: var(--rpl-space-2xs);
    left: var(--rpl-space-2xs);
    padding: var(--rpl-space-2xs) var(--rpl-space-sm);
    background-color: rgb(var(--rpl-color-background));
    color: rgb(var(--rpl-color-foreground));
    border-radius: var(--rpl-radius-sm);
    transform: translateY(-200%);
  }

  .rpl-skip-link:focus {
    transform: translateY(0);
  }

  .rpl-page-container {
    display: flex;
    flex-direction: column;
    flex: 1 0 auto;
  }

  .rpl-main {
    flex: 1 0 auto;
  }

  .rpl-container {
    width: 100%;
    max-width: var(--rpl-page-width);
    margin-inline: auto;
    padding-inline: var(--rpl-space-sm);
  }

  @media screen and (min-width: 750px) {
    .rpl-container {
      padding-inline: var(--rpl-space-lg);
    }
  }

  .rpl-section {
    padding-block: var(--rpl-space-lg);
  }

  .rpl-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--rpl-space-2xs);
    min-height: 44px;
    padding: var(--rpl-space-2xs) var(--rpl-space-md);
    border: var(--rpl-buttons-border-width) solid rgb(var(--rpl-color-button));
    border-radius: var(--rpl-buttons-radius);
    background-color: rgb(var(--rpl-color-button));
    color: rgb(var(--rpl-color-button-text));
    font-size: calc(0.9375rem * var(--rpl-font-body-scale));
    font-weight: var(--rpl-font-body-weight-bold);
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: opacity var(--rpl-duration-fast) var(--rpl-ease);
    box-shadow: 0 4px 10px rgb(var(--rpl-color-shadow) / var(--rpl-buttons-shadow-opacity));
  }

  .rpl-button:hover {
    opacity: 0.85;
  }

  .rpl-button[disabled],
  .rpl-button[aria-disabled='true'] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .rpl-button--secondary {
    background-color: transparent;
    color: rgb(var(--rpl-color-secondary-button-text));
    border-color: rgb(var(--rpl-color-secondary-button-text));
  }

  .rpl-button--link {
    min-height: 0;
    padding: 0;
    border: 0;
    background: none;
    color: rgb(var(--rpl-color-foreground));
    text-decoration: underline;
    text-underline-offset: 0.2em;
    box-shadow: none;
  }

  .rpl-button--full {
    width: 100%;
  }

  .rpl-header-shell {
    position: relative;
    z-index: var(--rpl-z-header);
    min-height: var(--rpl-header-height);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important; /* documented: overrides per-component durations that would otherwise reintroduce motion for users who opted out */
      animation-iteration-count: 1 !important; /* documented: same reason */
      transition-duration: 0.01ms !important; /* documented: same reason */
      scroll-behavior: auto !important; /* documented: same reason */
    }
  }
</style>
