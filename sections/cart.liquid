{%- comment -%}
  PLACEHOLDER — rebuilt in phase 2/4 as main-cart with Section Rendering API
  updates and @app block support (build spec §9).
{%- endcomment -%}

<div class="section">
  <div class="page-width stack">
    <h1 class="h1">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <p class="text-muted">{{ 'cart.empty' | t }}</p>
      <p>
        <a class="button button--primary" href="{{ routes.all_products_collection_url }}">
          {{ 'cart.continue_shopping' | t }}
        </a>
      </p>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <table>
          <caption class="visually-hidden">{{ 'cart.title' | t }}</caption>
          <thead>
            <tr>
              <th scope="col" class="visually-hidden">{{ 'products.product.media_gallery' | t }}</th>
              <th scope="col" class="text-start">{{ 'customers.order.product' | t }}</th>
              <th scope="col" class="text-start">{{ 'cart.quantity' | t }}</th>
              <th scope="col" class="text-end">{{ 'customers.order.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <a class="media media--square" href="{{ item.url }}" tabindex="-1" aria-hidden="true" style="width: 80px;">
                    {%- render 'image-fallback', image: item.image, alt: item.title, sizes: '80px' -%}
                  </a>
                </td>
                <td>
                  <a class="link" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                  <p class="text-muted text-body-sm">{{ item.variant.title }}</p>
                  <a class="button button--tertiary" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
                </td>
                <td>
                  <label class="visually-hidden" for="quantity-{{ item.index | plus: 1 }}">{{ 'cart.quantity' | t }}</label>
                  <input
                    class="field__input"
                    type="number"
                    id="quantity-{{ item.index | plus: 1 }}"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    style="width: 6rem;"
                  >
                </td>
                <td class="text-end price">{{ item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cluster">
          <button class="button button--secondary" type="submit" name="update">{{ 'cart.update' | t }}</button>
          <button class="button button--primary" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        </div>

        <p class="text-muted text-body-sm">{{ 'cart.taxes_and_shipping_note' | t }}</p>
      </form>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "settings": []
}
{% endschema %}
