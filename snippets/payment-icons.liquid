{%- comment -%}
  payment-icons.liquid — the gateways the shop has actually enabled.

  §9.6: never a hardcoded image strip. `shop.enabled_payment_types` is the
  only source, so the icons are always true for the store rendering them.
  A shop with nothing enabled renders nothing rather than an empty list.

  The list is decorative reassurance next to a purchase action, so it is
  labelled for assistive tech and the individual marks are not announced.

  Params:
    class  (string, optional)
{%- endcomment -%}

{%- if shop.enabled_payment_types.size > 0 -%}
  <ul class="payment-icons {{ class }}" aria-label="{{ 'footer.payment_methods' | t }}">
    {%- for type in shop.enabled_payment_types -%}
      <li>{{ type | payment_type_svg_tag: class: 'payment-icons__icon' }}</li>
    {%- endfor -%}
  </ul>
{%- endif -%}
