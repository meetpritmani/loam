{%- comment -%}
  main-article.liquid — one journal post.

  §9.4 asks for a related products block "where the article mentions a
  product". That judgement belongs to whoever wrote the post, not to the
  theme, so the products come from this section's own `related_products`
  picker — a merchant using an alternate template per article can set a
  different list per post; one using the shared template sets one list for
  the whole blog. Nothing is inferred from the body text and nothing is
  picked at random: an article with nothing picked shows no product row.

  Newsletter capture sits at the end, after the body and after the related
  products. §9.4 is explicit that it is not placed mid-scroll — an inline
  form interrupts the read, and a reader who has not finished the article has
  not yet been given a reason to subscribe.

  Reading order top to bottom: breadcrumbs, title, byline, image, body,
  tags, share, related products, comments, newsletter, back to the blog. The
  page never ends without a route onward.
{%- endcomment -%}

{%- liquid
  assign related = section.settings.related_products
  assign related_count = related.size

  capture card_sizes
    render 'grid-sizes', columns: 4, tablet_columns: 3
  endcapture
  assign card_sizes = card_sizes | strip

  assign share_url = request.origin | append: article.url
  assign article_date = article.published_at | date: format: 'date'
  assign article_image_alt = article.image.alt | default: article.title
-%}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <article class="article">
      <header class="article__header">
        {%- if section.settings.show_breadcrumbs -%}
          {%- render 'breadcrumbs', class: 'article__breadcrumbs' -%}
        {%- endif -%}

        <h1 class="h1 article__title">{{ article.title | escape }}</h1>

        {%- comment -%}
          §9.5: author and date visible, for credibility. A post with no
          byline reads as marketing copy whoever wrote it.
        {%- endcomment -%}
        <p class="article__meta caption">
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article_date }}</time>
          {%- if article.author != blank -%}
            <span aria-hidden="true">·</span>
            <span>{{ article.author | escape }}</span>
          {%- endif -%}
        </p>
      </header>

      {%- if article.image and section.settings.show_image -%}
        <div class="article__media media media--landscape">
          {%- render 'image-fallback',
            image: article.image,
            alt: article_image_alt,
            widths: '600,900,1200,1600,2000',
            sizes: '(min-width: 1100px) 1000px, 92vw',
            loading: 'eager',
            fetchpriority: 'high'
          -%}
        </div>
      {%- endif -%}

      <div class="article__body rte">
        {{ article.content }}
      </div>

      <footer class="article__footer">
        {%- if article.tags.size > 0 and section.settings.show_tags -%}
          <ul class="cluster article__tags" aria-label="{{ 'blog.filter_by_tag' | t }}">
            {%- for tag in article.tags -%}
              <li>
                <a class="blog-list__tag" href="{{ blog.url }}/tagged/{{ tag | handleize }}">
                  {{- tag | escape -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.show_share -%}
          {%- render 'share', url: share_url, title: article.title, class: 'article__share' -%}
        {%- endif -%}
      </footer>
    </article>
  </div>
</div>

{%- if related_count > 0 -%}
  <div class="section color-{{ section.settings.related_color_scheme }}">
    <div class="page-width">
      <div class="section__header">
        <h2 class="h3 section__title">{{ section.settings.related_heading | escape }}</h2>
      </div>
      <ul class="grid" style="--grid-cols: 4; --grid-cols-tablet: 3; --grid-cols-mobile: 2;">
        {%- for product in related limit: 4 -%}
          <li>
            {%- render 'card-product',
              product: product,
              heading_tag: 'h3',
              sizes: card_sizes
            -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{%- if blog.comments_enabled? -%}
  <div class="section color-{{ section.settings.color_scheme }}">
    <div class="page-width page-width--narrow">
      <div class="article-comments">
        {%- if article.comments_count > 0 -%}
          <h2 class="h4">{{ 'blog.article_comments' | t }}</h2>
          {%- paginate article.comments by section.settings.comments_per_page -%}
            <ul class="article-comments__list">
              {%- for comment in article.comments -%}
                <li class="article-comments__item">
                  <div class="rte text-body-sm">{{ comment.content }}</div>
                  <p class="caption">
                    {{- comment.author | escape }}
                    <span aria-hidden="true">·</span>
                    <time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">
                      {{- comment.created_at | date: format: 'date' -}}
                    </time>
                  </p>
                </li>
              {%- endfor -%}
            </ul>
            {%- render 'pagination', paginate: paginate, anchor: '#main' -%}
          {%- endpaginate -%}
        {%- endif -%}

        {%- form 'new_comment', article, class: 'article-comments__form' -%}
          <h2 class="h5">{{ 'blog.comment_form_title' | t }}</h2>

          {%- comment -%}
            Same pattern as contact-form.liquid: loop every failed field
            rather than hardcoding one, so a name/body validation error is
            never silently swallowed.
          {%- endcomment -%}
          {%- if form.errors -%}
            <ul class="article-comments__errors" role="alert">
              {%- for field in form.errors -%}
                <li class="field__error">
                  {{- form.errors.translated_fields[field] | capitalize }}
                  {{ form.errors.messages[field] -}}
                </li>
              {%- endfor -%}
            </ul>
          {%- elsif form.posted_successfully? -%}
            <p class="field__hint" role="status">{{ 'blog.comment_success' | t }}</p>
          {%- endif -%}

          <div class="article-comments__fields">
            <div class="field">
              <label class="field__label" for="comment-author">{{ 'blog.comment_form_name' | t }}</label>
              <input
                class="field__input"
                id="comment-author"
                type="text"
                name="comment[author]"
                value="{{ form.author }}"
                autocomplete="name"
                required
              >
            </div>

            <div class="field">
              <label class="field__label" for="comment-email">{{ 'blog.comment_form_email' | t }}</label>
              <input
                class="field__input"
                id="comment-email"
                type="email"
                name="comment[email]"
                value="{{ form.email }}"
                autocomplete="email"
                required
              >
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="comment-body">{{ 'blog.comment_form_body' | t }}</label>
            <textarea class="field__textarea" id="comment-body" name="comment[body]" rows="5" required>
              {{- form.body -}}
            </textarea>
          </div>

          <button class="button button--secondary" type="submit">
            {{ 'blog.comment_form_submit' | t }}
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
{%- endif -%}

{%- if section.settings.show_newsletter -%}
  <div class="section color-{{ section.settings.newsletter_color_scheme }}">
    <div class="page-width">
      <div class="newsletter-section newsletter-section--center">
        {%- if section.settings.newsletter_heading != blank -%}
          <h2 class="h3">{{ section.settings.newsletter_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.newsletter_text != blank -%}
          <p class="text-muted">{{ section.settings.newsletter_text | escape }}</p>
        {%- endif -%}

        {%- assign article_newsletter_id = 'article-' | append: section.id -%}
        {%- render 'newsletter-form',
          id: article_newsletter_id,
          class: 'newsletter-section__form',
          fine_print: section.settings.newsletter_fine_print
        -%}
      </div>
    </div>
  </div>
{%- endif -%}

<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width text-center">
    <a class="link-underline" href="{{ blog.url }}">
      {{- 'blog.back_to_blog' | t: title: blog.title -}}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_article.name",
  "tag": "section",
  "class": "section-main-article",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-paper"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:sections.main_product.show_breadcrumbs.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.main_article.show_image.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:sections.main_blog.show_tags.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "t:sections.main_article.show_share.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_article.headers.related"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main_article.related_paragraph"
    },
    {
      "type": "product_list",
      "id": "related_products",
      "label": "t:sections.main_article.related_products.label",
      "limit": 4
    },
    {
      "type": "text",
      "id": "related_heading",
      "label": "t:labels.heading",
      "default": "From the article"
    },
    {
      "type": "color_scheme",
      "id": "related_color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-paper"
    },
    {
      "type": "header",
      "content": "t:sections.main_blog.headers.newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.main_blog.show_newsletter.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "newsletter_color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-sand"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:labels.heading",
      "default": "Get first access."
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "t:labels.text",
      "default": "New colourways, restocks, and the occasional field note. Two emails a month, no more."
    },
    {
      "type": "text",
      "id": "newsletter_fine_print",
      "label": "t:sections.footer.blocks.newsletter.fine_print.label",
      "default": "Unsubscribe any time."
    },
    {
      "type": "range",
      "id": "comments_per_page",
      "label": "t:sections.main_article.comments_per_page.label",
      "min": 5,
      "max": 50,
      "step": 5,
      "default": 20
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 48
    }
  ]
}
{% endschema %}
