{%- comment -%}
  Search results. Uses Shopify's native search object — no custom index.

  Handles: no search performed yet, a term with zero results, mixed result
  types (product / article / page), and results with no image.
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} .rpl-product-grid {
    --rpl-grid-columns-mobile: {{ section.settings.columns_mobile }};
    --rpl-grid-columns-desktop: {{ section.settings.columns_desktop }};
  }
{% endstyle %}

<div class="rpl-color-{{ section.settings.color_scheme }}">
  <div class="rpl-container rpl-section">
    <h1>{{ 'general.search.results_heading' | t }}</h1>

    <form class="rpl-search-form" action="{{ routes.search_url }}" method="get" role="search">
      <div class="rpl-field">
        <label class="rpl-visually-hidden" for="SearchInput">{{ 'general.search.search' | t }}</label>
        <div class="rpl-search-form__row">
          <input
            class="rpl-input"
            type="search"
            name="q"
            id="SearchInput"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.placeholder' | t }}"
          >
          <button class="rpl-button" type="submit">{{ 'general.search.submit' | t }}</button>
        </div>
      </div>
      <input type="hidden" name="options[prefix]" value="last">
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="rpl-search__count" role="status">
          {{- 'general.search.results_with_count' | t: count: search.results_count -}}
        </p>

        {%- paginate search.results by section.settings.results_per_page -%}
          <ul class="rpl-grid rpl-product-grid" id="SearchResults">
            {%- for item in search.results -%}
              <li class="rpl-reveal">
                {%- case item.object_type -%}
                  {%- when 'product' -%}
                    {% render 'product-card', product: item, show_vendor: section.settings.show_vendor %}
                  {%- else -%}
                    {%- liquid
                      assign item_image = item.image | default: item.featured_image
                      assign item_alt = item.title
                    -%}
                    <div class="rpl-card">
                      {%- if item_image != blank -%}
                        {% render 'responsive-image',
                          image: item_image,
                          alt: item_alt,
                          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                          widths: '165, 330, 533, 720',
                          wrapper_ratio: 'landscape'
                        %}
                      {%- endif -%}
                      <div class="rpl-card__content">
                        <h2 class="rpl-card__title">
                          <a class="rpl-card__link" href="{{ item.url }}">{{ item.title | escape }}</a>
                        </h2>
                        {%- if item.content != blank -%}
                          <p class="rpl-caption rpl-muted">{{ item.content | strip_html | truncate: 120 }}</p>
                        {%- endif -%}
                      </div>
                    </div>
                {%- endcase -%}
              </li>
            {%- endfor -%}
          </ul>

          {% render 'pagination', paginate: paginate, anchor: '#SearchResults' %}
        {%- endpaginate -%}
      {%- else -%}
        <div class="rpl-empty-state">
          <p class="rpl-muted">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .rpl-search-form {
    max-width: 32rem;
    margin-block-end: var(--rpl-space-md);
  }

  .rpl-search-form__row {
    display: flex;
    gap: var(--rpl-space-2xs);
  }

  .rpl-search__count {
    margin-block-end: var(--rpl-space-md);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_search.name",
  "tag": "section",
  "class": "rpl-section-main-search",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "t:sections.main_search.settings.results_per_page.label",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:sections.all.columns_desktop.label",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.all.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.all.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.all.columns_mobile.options__2.label"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.all.show_vendor.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
