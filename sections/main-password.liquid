{%- comment -%}
  main-password.liquid — the storefront behind a password.

  §9.5: "explains what the store is and when it opens. Email capture is the
  primary action." A password page whose only control is a password field
  converts nobody — the visitor who has the password is a handful of staff,
  and everyone else arrived from a launch post and is worth an address.

  So the signup is the filled button and the staff login is a <details>
  disclosure below it. Not hidden — §9.1 forbids a close button that cannot
  be reached, and the same reasoning applies to a login a shop owner cannot
  find. It is one click, labelled, and keyboard reachable.

  The disclosure opens itself when a password attempt failed, so a mistyped
  password does not collapse the form the visitor was just using.
{%- endcomment -%}

<div class="section password-page color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow">
    <div class="password-page__inner">
      <header class="password-page__header">
        {%- if settings.logo != blank -%}
          {%- assign logo_alt = shop.name -%}
          <div class="password-page__logo" style="--logo-width: {{ settings.logo_width }}px;">
            {%- render 'image-fallback',
              image: settings.logo,
              alt: logo_alt,
              widths: '120,240,360,480',
              sizes: '240px',
              loading: 'eager'
            -%}
          </div>
        {%- else -%}
          <h1 class="h2">{{ shop.name | escape }}</h1>
        {%- endif -%}

        {%- if section.settings.eyebrow != blank -%}
          <p class="caption">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
      </header>

      {%- comment -%}
        What the store is, and when it opens. The merchant's own password
        message from admin comes first when they have written one — it is
        the field Shopify already prompts them to fill.
      {%- endcomment -%}
      {%- if shop.password_message != blank -%}
        <div class="rte password-page__message">{{ shop.password_message }}</div>
      {%- elsif section.settings.text != blank -%}
        <p class="password-page__message text-muted">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.opening_date != blank -%}
        <p class="password-page__date caption">{{ section.settings.opening_date | escape }}</p>
      {%- endif -%}

      {%- comment -%}
        The primary action. One filled button on the page (§9.2 rule 1); the
        password form below uses a secondary button.
      {%- endcomment -%}
      <div class="password-page__signup">
        {%- if section.settings.newsletter_heading != blank -%}
          <h2 class="h5">{{ section.settings.newsletter_heading | escape }}</h2>
        {%- endif -%}

        {%- assign password_newsletter_id = 'password-' | append: section.id -%}
        {%- render 'newsletter-form',
          id: password_newsletter_id,
          class: 'password-page__form',
          tags: 'newsletter,prelaunch',
          fine_print: section.settings.newsletter_fine_print
        -%}
      </div>

      {%- comment -%}
        The <details> is INSIDE the form, not around it. `form.errors` only
        exists within a {% form %} block, so a disclosure wrapping the form
        could never read it and a rejected password would silently collapse
        the field the shop owner had just typed into.
      {%- endcomment -%}
      {%- form 'storefront_password', class: 'password-page__login-form' -%}
        <details class="password-page__login" {% if form.errors %}open{% endif %}>
          <summary class="link-underline">{{ 'password.title' | t }}</summary>

          <div class="password-page__login-body">
            <p class="field__hint">{{ 'password.subtext' | t }}</p>

            {%- if form.errors -%}
              <p class="field__error" role="alert">{{ form.errors | default_errors }}</p>
            {%- endif -%}

            <div class="field">
              <label class="field__label" for="store-password">{{ 'password.password' | t }}</label>
              <input
                class="field__input"
                id="store-password"
                type="password"
                name="password"
                autocomplete="current-password"
                {% if form.errors %}aria-invalid="true"{% endif %}
              >
            </div>

            <button class="button button--secondary" type="submit">{{ 'password.enter' | t }}</button>
          </div>
        </details>
      {%- endform -%}

      <p class="password-page__credit text-body-sm text-muted">
        {{ powered_by_link }}
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-paper"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero.eyebrow.label",
      "default": "Opening soon"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text",
      "info": "t:sections.main_password.text.info",
      "default": "Shoes made from merino wool, eucalyptus fibre and sugarcane foam. We are finishing the first run now."
    },
    {
      "type": "text",
      "id": "opening_date",
      "label": "t:sections.main_password.opening_date.label",
      "info": "t:sections.main_password.opening_date.info",
      "default": "Doors open in March"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:labels.heading",
      "default": "Be told first."
    },
    {
      "type": "text",
      "id": "newsletter_fine_print",
      "label": "t:sections.footer.blocks.newsletter.fine_print.label",
      "default": "One email when we open. Nothing before it."
    }
  ]
}
{% endschema %}
