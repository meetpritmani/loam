{%- comment -%}
  404 page. Must never depend on a product, collection, or metafield existing.
{%- endcomment -%}

<div class="rpl-color-{{ section.settings.color_scheme }}">
  <div class="rpl-container rpl-container--narrow rpl-section rpl-empty-state">
    <h1>{{ 'templates.404.title' | t }}</h1>
    <p class="rpl-muted">{{ 'templates.404.subtext' | t }}</p>
    <a class="rpl-button" href="{{ routes.all_products_collection_url }}">
      {{- 'general.continue_shopping' | t -}}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "tag": "section",
  "class": "rpl-section-main-404",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
