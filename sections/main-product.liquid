{%- comment -%}
  SCAFFOLD — see PROGRESS.md.

  The no-JS product form is complete and correct on its own: a plain <select>
  posts the chosen variant id, the server has already rendered the right
  price/availability/SKU for it, and every image is in the page (no gallery
  interaction required to see them). rpl-product.js enhances this rather than
  replacing it — collapsing the media list into a thumbnail-driven gallery,
  updating price/availability/SKU/media when the select changes, and adding a
  mobile sticky add-to-cart bar. All of it is gated behind the existing
  .js/.no-js class already set pre-paint in theme.liquid, so there's no
  flash of enhanced-then-collapsing UI.

  Price/availability text is still rendered by Liquid, not reconstructed in
  JS: every variant gets a hidden price block (via snippets/price.liquid, so
  currency/market conversion stays correct) and three hidden button-label
  spans (available/sold out/unavailable, so labels stay translated); the JS
  only toggles which one is visible. This avoids hand-rolling money
  formatting or hardcoding English strings in JS.

  Handles: 1 variant, 10+ variants, no image, 1 image, many images, sold out,
  unavailable variants, no description, no vendor, no SKU, products with and
  without selling plans, variants with and without their own featured image.
{%- endcomment -%}

<script src="{{ 'rpl-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign product_form_id = 'ProductForm-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign has_selling_plans = false
  if product.selling_plan_groups.size > 0
    assign has_selling_plans = true
  endif
-%}

<div class="rpl-color-{{ section.settings.color_scheme }}">
  <div class="rpl-container rpl-section rpl-product">
    <div class="rpl-product__layout">
      <div
        class="rpl-product__media"
        data-product-gallery
        data-image-available-template="{{ 'products.product.media.image_available' | t: index: '{index}' | escape }}"
        id="ProductGallery-{{ section.id }}"
      >
        {%- if product.media.size > 0 -%}
          <ul class="rpl-list-unstyled rpl-product__media-list" role="group" aria-label="{{ 'products.product.media.gallery_viewer' | t }}">
            {%- for media in product.media limit: section.settings.media_limit -%}
              {%- liquid
                assign media_alt = media.alt | default: product.title
                assign media_loading = 'lazy'
                assign media_priority = 'auto'
                if forloop.first
                  assign media_loading = 'eager'
                  assign media_priority = 'high'
                endif
              -%}
              <li
                data-media-id="{{ media.id }}"
                id="ProductMedia-{{ section.id }}-{{ media.id }}"
                role="tabpanel"
                aria-labelledby="ProductThumbnail-{{ section.id }}-{{ media.id }}"
                {% if forloop.first %}
                  data-media-active
                {% endif %}
              >
                {% render 'responsive-image',
                  image: media.preview_image,
                  alt: media_alt,
                  loading: media_loading,
                  fetchpriority: media_priority,
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  widths: '360, 533, 720, 940, 1200, 1500',
                  wrapper_ratio: 'adapt',
                  placeholder: 'product-1'
                %}
              </li>
            {%- endfor -%}
          </ul>

          {%- if product.media.size > 1 -%}
            <ul
              class="rpl-list-unstyled rpl-product__thumbnails rpl-js-only"
              role="tablist"
              aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
              data-product-thumbnails
            >
              {%- for media in product.media limit: section.settings.media_limit -%}
                <li>
                  <button
                    type="button"
                    class="rpl-product__thumbnail"
                    id="ProductThumbnail-{{ section.id }}-{{ media.id }}"
                    role="tab"
                    aria-controls="ProductMedia-{{ section.id }}-{{ media.id }}"
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                    tabindex="{% unless forloop.first %}-1{% endunless %}"
                    data-media-target="{{ media.id }}"
                  >
                    {% render 'responsive-image',
                      image: media.preview_image,
                      alt: media.alt | default: product.title,
                      loading: 'lazy',
                      sizes: '64px',
                      widths: '64, 128',
                      wrapper_ratio: 'square'
                    %}
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- else -%}
          <div class="rpl-media rpl-media--ratio">
            {{ 'product-1' | placeholder_svg_tag: 'rpl-media__placeholder' }}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%}
        Read by rpl-product.js to find each variant's availability/SKU/
        featured media without another network request. Deliberately just
        `product.variants`, not the whole product — price is never read from
        here (see the hidden per-variant price blocks below), and skipping
        product.description avoids shipping its full rich-text HTML twice
        (already rendered further down) into a <script> tag.
      {%- endcomment -%}
      <script type="application/json" data-product-json>
        {{ product.variants | json }}
      </script>

      <div class="rpl-product__info">
        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <p class="rpl-caption rpl-muted">
            <span class="rpl-visually-hidden">{{ 'products.product.vendor' | t }}</span>
            {{ product.vendor | escape }}
          </p>
        {%- endif -%}

        <h1 class="rpl-product__title">{{ product.title | escape }}</h1>

        {%- comment -%}
          One hidden price block per variant (via snippets/price.liquid, so
          currency/market conversion and translated badges stay correct),
          plus a "no variant selected" state for invalid option combos.
          rpl-product.js only toggles `hidden` — it never reconstructs the
          price string itself.
        {%- endcomment -%}
        <div class="rpl-product__price" data-product-price>
          {%- for variant in product.variants -%}
            <div data-price-variant="{{ variant.id }}" {% unless variant == current_variant %}hidden{% endunless %}>
              {% render 'price', product: variant, show_badges: true %}
            </div>
          {%- endfor -%}
          <div data-price-variant="unavailable" {% if current_variant %}hidden{% endif %}>
            {% render 'price', product: product, use_variant: true, show_badges: true %}
          </div>
        </div>

        {%- if has_selling_plans and settings.show_selling_plan_savings -%}
          <p class="rpl-caption rpl-muted rpl-product__subscription-note">
            {% render 'icon', icon: 'refresh' %}
            {{ 'products.product.subscription.cancel_anytime' | t }}
          </p>
        {%- endif -%}

        {%- form 'product', product, id: product_form_id, class: 'rpl-product-form' -%}
          {%- unless product.has_only_default_variant -%}
            <div class="rpl-field rpl-product-form__variants">
              <label class="rpl-field__label" for="VariantSelect-{{ section.id }}">
                {{- product.options_with_values | map: 'name' | join: ' / ' -}}
              </label>
              <select class="rpl-select" id="VariantSelect-{{ section.id }}" name="id" data-product-variant-select>
                {%- for variant in product.variants -%}
                  <option
                    value="{{ variant.id }}"
                    {% if variant == current_variant %}
                      selected
                    {% endif %}
                    {% unless variant.available %}
                      disabled
                    {% endunless %}
                  >
                    {{ variant.title }}
                    {%- unless variant.available %} - {{ 'products.product.sold_out' | t }}{% endunless %}
                    - {{ variant.price | money }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {%- endunless -%}

          {%- if has_selling_plans -%}
            <fieldset class="rpl-product-form__plans">
              <legend class="rpl-field__label">{{ 'products.product.subscription.delivery_frequency' | t }}</legend>

              <label class="rpl-plan-option" for="SellingPlan-{{ section.id }}-none">
                <input
                  type="radio"
                  id="SellingPlan-{{ section.id }}-none"
                  name="selling_plan"
                  value=""
                  {% unless settings.subscription_default_selected %}
                    checked
                  {% endunless %}
                >
                <span>{{ 'products.product.subscription.one_time' | t }}</span>
              </label>

              {%- for group in product.selling_plan_groups -%}
                {%- for plan in group.selling_plans -%}
                  {%- assign plan_input_id = 'SellingPlan-' | append: section.id | append: '-' | append: plan.id -%}
                  <label class="rpl-plan-option" for="{{ plan_input_id }}">
                    <input
                      type="radio"
                      id="{{ plan_input_id }}"
                      name="selling_plan"
                      value="{{ plan.id }}"
                      {% if settings.subscription_default_selected and forloop.first and forloop.parentloop.first %}
                        checked
                      {% endif %}
                    >
                    <span>{{ plan.name | escape }}</span>
                  </label>
                {%- endfor -%}
              {%- endfor -%}
            </fieldset>
          {%- endif -%}

          <div class="rpl-field rpl-product-form__quantity">
            <label class="rpl-field__label" for="Quantity-{{ section.id }}">
              {{- 'products.product.quantity.label' | t -}}
            </label>
            <input
              class="rpl-input rpl-product-form__quantity-input"
              type="number"
              id="Quantity-{{ section.id }}"
              name="quantity"
              value="1"
              min="1"
              step="1"
              inputmode="numeric"
            >
          </div>

          {%- comment -%}
            Populated by rpl-cart.js when settings.cart_type is "drawer" and
            the AJAX add fails (e.g. sold out mid-request). Empty and hidden
            otherwise — the no-JS path relies on Shopify's own /cart/add
            error page instead.
          {%- endcomment -%}
          <p class="rpl-form-status" role="alert" data-cart-form-error hidden></p>

          <button
            class="rpl-button rpl-button--full rpl-product-form__submit"
            type="submit"
            name="add"
            data-product-submit
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            {%- comment -%}
              Three pre-translated states; rpl-product.js only toggles which
              one is visible on variant change, so it never hardcodes an
              English label.
            {%- endcomment -%}
            <span data-submit-text-unavailable {% unless current_variant == blank %}hidden{% endunless %}>
              {{- 'products.product.unavailable' | t -}}
            </span>
            <span data-submit-text-available {% unless current_variant.available %}hidden{% endunless %}>
              {{- 'products.product.add_to_cart' | t -}}
            </span>
            <span data-submit-text-soldout {% if current_variant == blank or current_variant.available %}hidden{% endif %}>
              {{- 'products.product.sold_out' | t -}}
            </span>
          </button>

          {%- if section.settings.show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        {%- endform -%}

        {%- if product.description != blank -%}
          <div class="rpl-rte rpl-product__description">{{ product.description }}</div>
        {%- endif -%}

        {%- if section.settings.show_sku -%}
          <p class="rpl-caption rpl-muted" data-product-sku {% if current_variant.sku == blank %}hidden{% endif %}>
            {{- 'products.product.sku' | t -}}: <span data-sku-value>{{ current_variant.sku | escape }}</span>
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- comment -%}
  Mobile-only sticky add-to-cart bar. Hidden by default and with no fallback
  content, so it's a pure JS enhancement: rpl-product.js reveals it once the
  real submit button scrolls out of view and its button just resubmits the
  real form (`requestSubmit`), so quantity/variant/selling-plan all come
  along for free — nothing here duplicates the add-to-cart logic. On desktop
  .rpl-product__info is already `position: sticky` (see stylesheet below), so
  this bar only ever needs to show below the 990px breakpoint.
{%- endcomment -%}
<div class="rpl-color-{{ section.settings.color_scheme }} rpl-sticky-atc rpl-js-only" data-sticky-atc hidden>
  <div class="rpl-container rpl-sticky-atc__inner">
    <div class="rpl-sticky-atc__info">
      <p class="rpl-sticky-atc__title">{{ product.title | escape }}</p>
      <div class="rpl-sticky-atc__price" data-sticky-atc-price></div>
    </div>
    <button type="button" class="rpl-button rpl-sticky-atc__submit" data-product-submit data-sticky-atc-submit>
      <span data-submit-text-unavailable {% unless current_variant == blank %}hidden{% endunless %}>
        {{- 'products.product.unavailable' | t -}}
      </span>
      <span data-submit-text-available {% unless current_variant.available %}hidden{% endunless %}>
        {{- 'products.product.add_to_cart' | t -}}
      </span>
      <span data-submit-text-soldout {% if current_variant == blank or current_variant.available %}hidden{% endif %}>
        {{- 'products.product.sold_out' | t -}}
      </span>
    </button>
  </div>
</div>

{% stylesheet %}
  .rpl-product__layout {
    display: grid;
    gap: var(--rpl-space-lg);
  }

  .rpl-product__media-list {
    display: grid;
    gap: var(--rpl-space-2xs);
  }

  /* Collapses to a single visible slide only when JS is available — .js is
     already set on <html> before first paint (see layout/theme.liquid), so
     there's no flash of the stacked no-JS layout before this applies. */
  .js .rpl-product__media-list > li {
    display: none;
  }

  .js .rpl-product__media-list > li[data-media-active] {
    display: block;
  }

  .rpl-product__thumbnails {
    display: flex;
    flex-wrap: wrap;
    gap: var(--rpl-space-3xs);
    margin-block-start: var(--rpl-space-2xs);
  }

  .rpl-product__thumbnail {
    display: block;
    width: 4rem;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--rpl-media-radius);
    background: none;
    cursor: pointer;
    overflow: hidden;
  }

  .rpl-product__thumbnail[aria-selected='true'] {
    border-color: rgb(var(--rpl-color-foreground));
  }

  .rpl-product__info {
    display: flex;
    flex-direction: column;
    gap: var(--rpl-space-2xs);
  }

  .rpl-product__title {
    margin: 0;
  }

  .rpl-product__subscription-note {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
  }

  .rpl-product__subscription-note .rpl-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  .rpl-product-form {
    display: flex;
    flex-direction: column;
    gap: var(--rpl-space-sm);
    margin-block: var(--rpl-space-sm);
  }

  .rpl-product-form__plans {
    display: flex;
    flex-direction: column;
    gap: var(--rpl-space-3xs);
    margin: 0;
    padding: var(--rpl-space-2xs);
    border: 1px solid rgb(var(--rpl-color-foreground) / 0.2);
    border-radius: var(--rpl-card-radius);
  }

  .rpl-plan-option {
    display: flex;
    align-items: center;
    gap: var(--rpl-space-2xs);
    min-height: 44px;
    cursor: pointer;
  }

  .rpl-product-form__quantity-input {
    width: 6rem;
  }

  .rpl-product__description {
    margin-block-start: var(--rpl-space-sm);
  }

  @media screen and (min-width: 990px) {
    .rpl-product__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      align-items: start;
    }

    .rpl-product__info {
      position: sticky;
      top: var(--rpl-space-sm);
    }

    /* .rpl-product__info is sticky at this breakpoint, so the ATC button is
       always on screen — the mobile bar would be redundant here. */
    .rpl-sticky-atc {
      display: none;
    }
  }

  .rpl-sticky-atc {
    position: fixed;
    z-index: var(--rpl-z-header);
    inset-inline: 0;
    bottom: 0;
    border-block-start: 1px solid rgb(var(--rpl-color-foreground) / 0.12);
    box-shadow: 0 -4px 16px rgb(0 0 0 / 0.08);
  }

  .rpl-sticky-atc__inner {
    display: flex;
    align-items: center;
    gap: var(--rpl-space-sm);
    padding-block: var(--rpl-space-2xs);
  }

  .rpl-sticky-atc__info {
    flex: 1 1 auto;
    min-width: 0;
  }

  .rpl-sticky-atc__title {
    margin: 0;
    font-weight: var(--rpl-font-body-weight-bold);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rpl-sticky-atc__submit {
    flex: 0 0 auto;
    width: auto;
    padding-inline: var(--rpl-space-lg);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "rpl-section-main-product",
  "settings": [
    {
      "type": "range",
      "id": "media_limit",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "t:sections.main_product.settings.media_limit.label",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.all.show_vendor.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "t:sections.main_product.settings.show_sku.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "t:sections.main_product.settings.show_dynamic_checkout.label",
      "info": "t:sections.main_product.settings.show_dynamic_checkout.info",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
