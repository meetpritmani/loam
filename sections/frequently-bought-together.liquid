{%- comment -%}
  Product-page only (needs the page's own `product`). Shows the current
  product plus up to 3 merchant-picked related products as a checkbox row
  with a running total and a single "Add all to cart" button that adds
  every checked item in one /cart/add.js call.

  Per-item variant selection is a plain inline <select> (matching the rest
  of the theme's product forms), not a modal — a deliberate simplification;
  see PROGRESS.md.

  Handles: 0 related-product blocks (still shows just the current product,
  not hidden — though at that point it's just an add-to-cart, which is
  fine), a related product later unpublished/deleted (skipped), a related
  product with multiple variants (inline select, default-checked respects
  the setting), the current product itself having multiple variants.
{%- endcomment -%}

{%- if product != blank -%}
  <script src="{{ 'rpl-fbt.js' | asset_url }}" defer="defer"></script>

  <div class="rpl-color-{{ section.settings.color_scheme }}">
    <div class="rpl-container rpl-section">
      {%- if section.settings.heading != blank -%}
        <h2 class="rpl-fbt__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div
        class="rpl-fbt"
        data-fbt
        data-cart-add-url="{{ routes.cart_add_url }}"
        data-cart-url="{{ routes.cart_url }}"
        data-money-format="{{ shop.money_format | escape }}"
      >
        <ul class="rpl-list-unstyled rpl-fbt__items">
          {%- liquid
            assign current_variant = product.selected_or_first_available_variant
          -%}
          <li class="rpl-fbt__item" data-fbt-item>
            <input type="checkbox" class="rpl-fbt__checkbox" checked disabled data-fbt-checkbox>
            <div class="rpl-fbt__item-media">
              {% render 'responsive-image',
                image: current_variant.featured_image | default: product.featured_media.preview_image,
                alt: product.title,
                loading: 'lazy',
                sizes: '80px',
                widths: '80, 160',
                wrapper_ratio: 'square'
              %}
            </div>
            <div class="rpl-fbt__item-info">
              <a class="rpl-fbt__item-title" href="{{ product.url }}">{{ product.title | escape }}</a>
              {%- unless product.has_only_default_variant -%}
                <select class="rpl-select rpl-fbt__variant-select" data-fbt-variant-select data-fbt-name="id">
                  {%- for variant in product.variants -%}
                    <option
                      value="{{ variant.id }}"
                      data-price="{{ variant.price }}"
                      {% if variant == current_variant %}selected{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                    >
                      {{ variant.title }}
                      {%- unless variant.available %} - {{ 'products.product.sold_out' | t }}{% endunless %}
                    </option>
                  {%- endfor -%}
                </select>
              {%- else -%}
                <input type="hidden" data-fbt-name="id" value="{{ current_variant.id }}">
              {%- endunless -%}
              <span class="rpl-fbt__item-price" data-fbt-price data-price="{{ current_variant.price }}">
                {{- current_variant.price | money -}}
              </span>
            </div>
          </li>

          {%- for block in section.blocks -%}
            {%- liquid
              assign related = block.settings.product
              assign related_variant = related.selected_or_first_available_variant
            -%}
            {%- unless related == blank -%}
              <li class="rpl-fbt__item" data-fbt-item {{ block.shopify_attributes }}>
                <input
                  type="checkbox"
                  class="rpl-fbt__checkbox"
                  {% if section.settings.default_checked %}checked{% endif %}
                  data-fbt-checkbox
                >
                <div class="rpl-fbt__item-media">
                  {% render 'responsive-image',
                    image: related_variant.featured_image | default: related.featured_media.preview_image,
                    alt: related.title,
                    loading: 'lazy',
                    sizes: '80px',
                    widths: '80, 160',
                    wrapper_ratio: 'square'
                  %}
                </div>
                <div class="rpl-fbt__item-info">
                  <a class="rpl-fbt__item-title" href="{{ related.url }}">{{ related.title | escape }}</a>
                  {%- unless related.has_only_default_variant -%}
                    <select class="rpl-select rpl-fbt__variant-select" data-fbt-variant-select data-fbt-name="id">
                      {%- for variant in related.variants -%}
                        <option
                          value="{{ variant.id }}"
                          data-price="{{ variant.price }}"
                          {% if variant == related_variant %}selected{% endif %}
                          {% unless variant.available %}disabled{% endunless %}
                        >
                          {{ variant.title }}
                          {%- unless variant.available %} - {{ 'products.product.sold_out' | t }}{% endunless %}
                        </option>
                      {%- endfor -%}
                    </select>
                  {%- else -%}
                    <input type="hidden" data-fbt-name="id" value="{{ related_variant.id }}">
                  {%- endunless -%}
                  <span class="rpl-fbt__item-price" data-fbt-price data-price="{{ related_variant.price }}">
                    {{- related_variant.price | money -}}
                  </span>
                </div>
              </li>
            {%- endunless -%}
          {%- endfor -%}
        </ul>

        <div class="rpl-fbt__footer">
          <p class="rpl-fbt__total">
            <span>{{ 'sections.cart.total' | t }}</span>
            <span data-fbt-total>{{ current_variant.price | money }}</span>
          </p>
          <p class="rpl-form-status" role="alert" data-fbt-error hidden></p>
          <button type="button" class="rpl-button rpl-button--full" data-fbt-add-all>
            {{- 'sections.frequently_bought_together.add_all_to_cart' | t -}}
          </button>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .rpl-fbt__heading {
    margin-block-end: var(--rpl-space-md);
  }

  .rpl-fbt__items {
    display: flex;
    flex-direction: column;
    gap: var(--rpl-space-sm);
  }

  .rpl-fbt__item {
    display: grid;
    grid-template-columns: auto 80px 1fr;
    align-items: center;
    gap: var(--rpl-space-2xs);
  }

  .rpl-fbt__checkbox {
    width: 1.25rem;
    height: 1.25rem;
  }

  .rpl-fbt__item-info {
    display: flex;
    flex-direction: column;
    gap: var(--rpl-space-3xs);
    min-width: 0;
  }

  .rpl-fbt__item-title {
    font-weight: var(--rpl-font-body-weight-bold);
    text-decoration: none;
  }

  .rpl-fbt__item-title:hover {
    text-decoration: underline;
  }

  .rpl-fbt__variant-select {
    max-width: 14rem;
  }

  .rpl-fbt__item-price {
    font-weight: var(--rpl-font-body-weight-bold);
  }

  .rpl-fbt__footer {
    margin-block-start: var(--rpl-space-md);
    padding-block-start: var(--rpl-space-sm);
    border-block-start: 1px solid rgb(var(--rpl-color-foreground) / 0.12);
  }

  .rpl-fbt__total {
    display: flex;
    justify-content: space-between;
    margin: 0 0 var(--rpl-space-sm);
    font-size: calc(1.125rem * var(--rpl-font-body-scale));
    font-weight: var(--rpl-font-body-weight-bold);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.frequently_bought_together.name",
  "tag": "section",
  "class": "rpl-section-frequently-bought-together",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "Frequently bought together"
    },
    {
      "type": "checkbox",
      "id": "default_checked",
      "label": "t:sections.frequently_bought_together.settings.default_checked.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "related_product",
      "name": "t:sections.frequently_bought_together.blocks.related_product.name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.frequently_bought_together.blocks.related_product.settings.product.label"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "t:sections.frequently_bought_together.name"
    }
  ]
}
{% endschema %}
