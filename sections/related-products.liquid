{%- comment -%}
  related-products.liquid — "you might also like", from Shopify.

  §9.4: sourced from `recommendations`, never a random collection slice. The
  distinction matters — a slice of the same collection shows the shopper
  things they have already scrolled past, while the recommendations API is
  fed by the store's own order and browsing data.

  Shopify only populates `recommendations.products` when the request carries
  `product_id` and `limit`, which a normal page load does not. So the section
  ships empty and <lazy-section> fetches this same section back through the
  recommendations route once the row nears the viewport. Fetching on approach
  rather than on load keeps the request off the critical path: this row sits
  well below the fold and has no business competing with the PDP's LCP.

  Hidden entirely below the minimum (§9.4, default 3). A row of one or two
  products reads as a thin catalogue rather than a recommendation, and the
  heading makes a promise the row does not keep. Empty means empty: the
  custom element renders nothing at all, not a heading over blank space.
{%- endcomment -%}

{%- liquid
  assign limit = section.settings.products_to_show
  assign minimum = section.settings.minimum_products

  assign fetch_url = routes.product_recommendations_url
  assign fetch_url = fetch_url | append: '?section_id=' | append: section.id
  assign fetch_url = fetch_url | append: '&product_id=' | append: product.id
  assign fetch_url = fetch_url | append: '&limit=' | append: limit

  assign render_row = false
  if recommendations.performed and recommendations.products_count >= minimum
    assign render_row = true
  endif

  capture card_sizes
    render 'grid-sizes', columns: section.settings.columns, tablet_columns: 3
  endcapture
  assign card_sizes = card_sizes | strip
-%}

<lazy-section data-url="{{ fetch_url }}" data-name="related-products">
  {%- if render_row -%}
    <div
      class="section color-{{ section.settings.color_scheme }}"
      style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
    >
      <div class="page-width">
        <div class="section__header">
          <h2 class="h3 section__title">{{ section.settings.heading | escape }}</h2>
        </div>

        <ul class="grid" style="--grid-cols: {{ section.settings.columns }}; --grid-cols-tablet: 3; --grid-cols-mobile: 2;">
          {%- for recommendation in recommendations.products -%}
            <li>
              {%- render 'card-product',
                product: recommendation,
                heading_tag: 'h3',
                sizes: card_sizes
              -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}
</lazy-section>

{% schema %}
{
  "name": "t:sections.related_products.name",
  "tag": "section",
  "class": "section-related-products",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-paper"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "You might also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.related_products.products_to_show.label",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "minimum_products",
      "label": "t:sections.related_products.minimum_products.label",
      "info": "t:sections.related_products.minimum_products.info",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.main_collection.columns.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 32
    }
  ]
}
{% endschema %}
