{%- comment -%}
  Password reset, reached from the recovery email link.
{%- endcomment -%}

<div class="rpl-color-{{ section.settings.color_scheme }}">
  <div class="rpl-container rpl-container--narrow rpl-section">
    <div class="rpl-account-form">
      <h1>{{ 'customer.reset_password.title' | t }}</h1>
      <p class="rpl-muted">{{ 'customer.reset_password.subtext' | t }}</p>

      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}
          <div class="rpl-form-status" role="alert" tabindex="-1">
            <p>{{ form.errors | default_errors }}</p>
          </div>
        {%- endif -%}

        <div class="rpl-field">
          <label class="rpl-field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
          <input
            class="rpl-input"
            type="password"
            name="customer[password]"
            id="ResetPassword"
            autocomplete="new-password"
            required
          >
        </div>

        <div class="rpl-field">
          <label class="rpl-field__label" for="ResetPasswordConfirm">
            {{- 'customer.reset_password.password_confirm' | t -}}
          </label>
          <input
            class="rpl-input"
            type="password"
            name="customer[password_confirmation]"
            id="ResetPasswordConfirm"
            autocomplete="new-password"
            required
          >
        </div>

        <button class="rpl-button" type="submit">{{ 'customer.reset_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_reset_password.name",
  "tag": "section",
  "class": "rpl-section-main-reset",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
