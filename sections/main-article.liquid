{%- comment -%}
  Article template. Handles: no featured image, comments disabled, comments
  enabled with zero comments, moderated comments, and form validation errors.
{%- endcomment -%}

{%- liquid
  assign article_alt = article.image.alt | default: article.title
  assign number_of_comments = article.comments_count
  # A just-posted comment on a moderated blog is not yet in comments_count.
  if comment and comment.status == 'pending'
    assign number_of_comments = article.comments_count | plus: 1
  endif
-%}

<div class="rpl-color-{{ section.settings.color_scheme }}">
  <article class="rpl-container rpl-container--narrow rpl-section rpl-article">
    <header class="rpl-article__header">
      <h1>{{ article.title | escape }}</h1>
      <p class="rpl-caption rpl-muted">
        {%- if section.settings.show_date -%}
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
            {{- article.published_at | date: format: 'date' -}}
          </time>
        {%- endif -%}
        {%- if section.settings.show_author and article.author != blank -%}
          {% if section.settings.show_date %} &middot; {% endif %}{{ article.author | escape }}
        {%- endif -%}
      </p>
    </header>

    {%- if article.image != blank -%}
      {% render 'responsive-image',
        image: article.image,
        alt: article_alt,
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '(min-width: 750px) 46rem, 100vw',
        widths: '533, 720, 940, 1200, 1500',
        wrapper_ratio: 'landscape'
      %}
    {%- endif -%}

    <div class="rpl-rte rpl-article__content">{{ article.content }}</div>

    {%- if blog.comments_enabled? -%}
      <div class="rpl-article__comments" id="comments">
        <h2>{{ 'blogs.article.comments' | t: count: number_of_comments }}</h2>

        {%- if number_of_comments > 0 -%}
          <ul class="rpl-list-unstyled rpl-comment-list">
            {%- if comment and comment.status == 'pending' -%}
              <li class="rpl-comment" id="{{ comment.id }}">
                <p class="rpl-comment__body">{{ comment.content }}</p>
                <p class="rpl-caption rpl-muted">{{ comment.author | escape }}</p>
              </li>
            {%- endif -%}
            {%- paginate article.comments by 20 -%}
              {%- for comment in article.comments -%}
                <li class="rpl-comment" id="{{ comment.id }}">
                  <p class="rpl-comment__body">{{ comment.content }}</p>
                  <p class="rpl-caption rpl-muted">
                    {{ comment.author | escape }} &middot;
                    <time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">
                      {{- comment.created_at | date: format: 'date' -}}
                    </time>
                  </p>
                </li>
              {%- endfor -%}
              {% render 'pagination', paginate: paginate, anchor: '#comments' %}
            {%- endpaginate -%}
          </ul>
        {%- endif -%}

        {% form 'new_comment', article %}
          <h3>{{ 'blogs.article.comment_form_title' | t }}</h3>

          {%- if form.errors -%}
            <div class="rpl-form-status" role="alert" tabindex="-1">
              <p>{{ form.errors | default_errors }}</p>
            </div>
          {%- elsif form.posted_successfully? -%}
            <div class="rpl-form-status" role="status" tabindex="-1">
              <p>
                {%- if blog.moderated? -%}
                  {{ 'blogs.article.success_moderated' | t }}
                {%- else -%}
                  {{ 'blogs.article.success' | t }}
                {%- endif -%}
              </p>
            </div>
          {%- endif -%}

          <div class="rpl-stack">
            <div class="rpl-field">
              <label class="rpl-field__label" for="CommentAuthor">{{ 'blogs.article.name' | t }}</label>
              <input
                class="rpl-input"
                type="text"
                name="comment[author]"
                id="CommentAuthor"
                autocomplete="name"
                value="{{ form.author }}"
                required
              >
            </div>

            <div class="rpl-field">
              <label class="rpl-field__label" for="CommentEmail">{{ 'blogs.article.email' | t }}</label>
              <input
                class="rpl-input"
                type="email"
                name="comment[email]"
                id="CommentEmail"
                autocomplete="email"
                value="{{ form.email }}"
                required
              >
            </div>

            <div class="rpl-field">
              <label class="rpl-field__label" for="CommentBody">{{ 'blogs.article.message' | t }}</label>
              <textarea class="rpl-textarea" name="comment[body]" id="CommentBody" required>{{ form.body }}</textarea>
            </div>

            {%- if blog.moderated? -%}
              <p class="rpl-caption rpl-muted">{{ 'blogs.article.moderated' | t }}</p>
            {%- endif -%}

            <button class="rpl-button" type="submit">{{ 'blogs.article.post' | t }}</button>
          </div>
        {% endform %}
      </div>
    {%- endif -%}

    <p class="rpl-article__back">
      <a href="{{ blog.url }}">{{ 'blogs.article.back_to_blog' | t: title: blog.title }}</a>
    </p>
  </article>
</div>

{% stylesheet %}
  .rpl-article__header {
    margin-block-end: var(--rpl-space-md);
  }

  .rpl-article__content {
    margin-block: var(--rpl-space-md);
  }

  .rpl-article__comments {
    margin-block-start: var(--rpl-space-xl);
    padding-block-start: var(--rpl-space-md);
    border-block-start: 1px solid rgb(var(--rpl-color-foreground) / 0.12);
  }

  .rpl-comment-list {
    display: grid;
    gap: var(--rpl-space-md);
    margin-block-end: var(--rpl-space-lg);
  }

  .rpl-comment__body {
    margin-block-end: var(--rpl-space-3xs);
  }

  .rpl-article__back {
    margin-block-start: var(--rpl-space-lg);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_article.name",
  "tag": "section",
  "class": "rpl-section-main-article",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:sections.main_article.settings.show_date.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:sections.main_article.settings.show_author.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
