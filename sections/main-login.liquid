{%- comment -%}
  Customer login, including the recover-password form. Both forms live on this
  template; the recover form is revealed with :target so it works without JS.
{%- endcomment -%}

<div class="rpl-color-{{ section.settings.color_scheme }}">
  <div class="rpl-container rpl-container--narrow rpl-section">
    <div class="rpl-account-form" id="RecoverPassword">
      <h1>{{ 'customer.recover_password.title' | t }}</h1>
      <p class="rpl-muted">{{ 'customer.recover_password.subtext' | t }}</p>

      {%- form 'recover_customer_password' -%}
        {%- if form.errors -%}
          <div class="rpl-form-status" role="alert" tabindex="-1">
            <p>{{ form.errors | default_errors }}</p>
          </div>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <div class="rpl-form-status" role="status" tabindex="-1">
            <p>{{ 'customer.recover_password.success' | t }}</p>
          </div>
        {%- endif -%}

        <div class="rpl-field">
          <label class="rpl-field__label" for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
          <input
            class="rpl-input"
            type="email"
            name="email"
            id="RecoverEmail"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
          >
        </div>

        <button class="rpl-button" type="submit">{{ 'customer.recover_password.submit' | t }}</button>
        <a class="rpl-button rpl-button--link" href="#LoginForm">{{ 'customer.login_page.cancel' | t }}</a>
      {%- endform -%}
    </div>

    <div class="rpl-account-form" id="LoginForm">
      <h1>{{ 'customer.login_page.title' | t }}</h1>

      {%- form 'customer_login' -%}
        {%- if form.errors -%}
          <div class="rpl-form-status" role="alert" tabindex="-1">
            <p>{{ form.errors | default_errors }}</p>
          </div>
        {%- endif -%}

        <div class="rpl-field">
          <label class="rpl-field__label" for="LoginEmail">{{ 'customer.login_page.email' | t }}</label>
          <input
            class="rpl-input"
            type="email"
            name="customer[email]"
            id="LoginEmail"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
          >
        </div>

        {%- if form.password_needed -%}
          <div class="rpl-field">
            <label class="rpl-field__label" for="LoginPassword">{{ 'customer.login_page.password' | t }}</label>
            <input
              class="rpl-input"
              type="password"
              name="customer[password]"
              id="LoginPassword"
              autocomplete="current-password"
              required
            >
          </div>
          <a class="rpl-button rpl-button--link" href="#RecoverPassword">
            {{- 'customer.login_page.forgot_password' | t -}}
          </a>
        {%- endif -%}

        <button class="rpl-button" type="submit">{{ 'customer.login_page.sign_in' | t }}</button>
      {%- endform -%}

      {%- if shop.customer_accounts_enabled -%}
        <p>
          <a href="{{ routes.account_register_url }}">{{ 'customer.login_page.create_account' | t }}</a>
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .rpl-account-form {
    display: flex;
    flex-direction: column;
    gap: var(--rpl-space-2xs);
    max-width: 26rem;
    margin-inline: auto;
  }

  .rpl-account-form form {
    display: flex;
    flex-direction: column;
    gap: var(--rpl-space-2xs);
  }

  /* The recover form is hidden until it is the URL target, so the page works
     with JavaScript disabled and keeps a single focusable form at a time. */
  #RecoverPassword {
    display: none;
  }

  #RecoverPassword:target {
    display: flex;
  }

  #RecoverPassword:target ~ #LoginForm {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_login.name",
  "tag": "section",
  "class": "rpl-section-main-login",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
