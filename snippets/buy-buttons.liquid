{%- comment -%}
  buy-buttons.liquid — Add to Cart, then the express buttons beneath it.

  §9.6: a disabled button must explain why. Sold out and unavailable are
  different states and get different labels — "Sold out" means the shop
  stocks it and has none; "Unavailable" means that combination does not
  exist. A silently dead button is never acceptable.

  The express (dynamic checkout) buttons sit BELOW Add to Cart, not above.
  Above, they harvest shoppers who would otherwise browse on, and they skip
  the cart where the free-shipping threshold and upsells live.

  Params:
    product     (product, required)
    section_id  (string, required)
    show_qty    (boolean, optional) — default true
{%- endcomment -%}

{%- liquid
  assign current = product.selected_or_first_available_variant
  assign with_qty = show_qty | default: true, allow_false: true

  assign can_buy = false
  if current != blank and current.available
    assign can_buy = true
  endif

  assign disabled_label = 'products.product.unavailable' | t
  if current != blank
    assign disabled_label = 'products.product.sold_out' | t
  endif
-%}

{%- comment -%}
  The form id is assigned first, not built inline. A filter inside the form
  tag's arguments makes Liquid mis-parse the form TYPE — it read the type as
  "-form" and threw. theme-check only flags filter-on-argument for `render`,
  so this only shows up against the real compiler.
{%- endcomment -%}
{%- assign form_id = section_id | append: '-form' -%}
<product-form data-success-message="{{ 'products.product.added_to_cart' | t | escape }}">
{%- form 'product', product, id: form_id, class: 'buy-buttons', novalidate: 'novalidate' -%}
  <input
    type="hidden"
    name="id"
    value="{{ current.id }}"
    data-variant-id
    {% unless can_buy %}disabled{% endunless %}
  >

  {%- comment -%}
    Theme Store requirement. Has to sit inside this specific form — the
    filter binds to the form's own variant-id input, which is what lets
    Shopify keep the banner in sync on a variant change without any theme
    JS of ours. Placed first in the form, directly under the price block
    that sits immediately above buy_buttons in every product.json block
    order, per Shopify's own guidance to group price and financing info.
  {%- endcomment -%}
  {%- if can_buy -%}
    {{ form | payment_terms }}
  {%- endif -%}

  {%- if product.gift_card? -%}
    {%- comment -%}
      §7 (Pages, cont'd): a way to send the gift card to someone else — email,
      name, message, an optional send date. `recipient[...]` is the field
      shape Shopify's checkout reads for this; the checkbox IS the
      `properties[__shopify_send_gift_card_to_recipient]` field, so an
      unchecked box submits nothing (browsers omit unchecked checkboxes from
      form data) and the purchase behaves like a normal, non-gift order.
      Works with no JS: the fields below are visible and enabled by default;
      <gift-card-recipient-form> only collapses them behind the checkbox once
      it knows JS is actually running.
    {%- endcomment -%}
    {%- liquid
      assign recipient_checkbox_id = section_id | append: '-recipient-toggle'
      assign recipient_email_id = section_id | append: '-recipient-email'
      assign recipient_name_id = section_id | append: '-recipient-name'
      assign recipient_message_id = section_id | append: '-recipient-message'
      assign recipient_send_on_id = section_id | append: '-recipient-send-on'
    -%}
    <gift-card-recipient-form class="gift-card-recipient">
      <div class="field field--checkbox">
        <input
          class="field__checkbox"
          type="checkbox"
          id="{{ recipient_checkbox_id }}"
          name="properties[__shopify_send_gift_card_to_recipient]"
          value="1"
          data-recipient-toggle
        >
        <label for="{{ recipient_checkbox_id }}">{{ 'gift_card.recipient.send_as_gift' | t }}</label>
      </div>

      <div class="gift-card-recipient__fields" data-recipient-fields>
        <div class="field">
          <label class="field__label" for="{{ recipient_email_id }}">
            {{- 'gift_card.recipient.email_label' | t -}}
          </label>
          <input
            class="field__input"
            type="email"
            id="{{ recipient_email_id }}"
            name="recipient[email]"
            autocomplete="email"
            data-recipient-email
          >
        </div>

        <div class="field">
          <label class="field__label" for="{{ recipient_name_id }}">
            {{- 'gift_card.recipient.name_label' | t -}}
          </label>
          <input
            class="field__input"
            type="text"
            id="{{ recipient_name_id }}"
            name="recipient[name]"
            autocomplete="name"
          >
        </div>

        <div class="field">
          <label class="field__label" for="{{ recipient_message_id }}">
            {{- 'gift_card.recipient.message_label' | t -}}
          </label>
          <textarea
            class="field__textarea"
            id="{{ recipient_message_id }}"
            name="recipient[message]"
            rows="3"
          ></textarea>
        </div>

        <div class="field">
          <label class="field__label" for="{{ recipient_send_on_id }}">
            {{- 'gift_card.recipient.send_on_label' | t -}}
          </label>
          <input
            class="field__input"
            type="date"
            id="{{ recipient_send_on_id }}"
            name="recipient[send_on]"
            min="{{ 'now' | date: '%Y-%m-%d' }}"
          >
          <p class="field__hint text-muted">{{ 'gift_card.recipient.send_on_info' | t }}</p>
        </div>
      </div>
    </gift-card-recipient-form>
  {%- endif -%}

  {%- if with_qty -%}
    {%- liquid
      assign qty_id = section_id | append: '-qty'
      # §9.6: never offer a quantity the merchant cannot fulfil. A ceiling
      # only exists when inventory is tracked and overselling is off.
      assign qty_max = blank
      if current.inventory_management != blank and current.inventory_policy != 'continue'
        assign qty_max = current.inventory_quantity
      endif

      # There is nothing to set a quantity on when there is nothing to buy.
      assign qty_disabled = false
      unless can_buy
        assign qty_disabled = true
      endunless
    -%}
    {%- render 'quantity-input', id: qty_id, value: 1, min: 1, max: qty_max, disabled: qty_disabled -%}
  {%- endif -%}

  {%- comment -%}
    The three state labels ride along as data attributes so the client can
    swap the button between them on a variant change without another network
    round trip, and without any English in the JavaScript.
  {%- endcomment -%}
  <button
    class="button button--primary button--full buy-buttons__add"
    type="submit"
    name="add"
    data-add-button
    data-label-add="{{ 'products.product.add_to_cart' | t | escape }}"
    data-label-sold-out="{{ 'products.product.sold_out' | t | escape }}"
    data-label-unavailable="{{ 'products.product.unavailable' | t | escape }}"
    {% unless can_buy %}disabled{% endunless %}
  >
    <span data-add-label>
      {%- if can_buy -%}
        {{ 'products.product.add_to_cart' | t }}
      {%- else -%}
        {{ disabled_label }}
      {%- endif -%}
    </span>
  </button>

  {%- if settings.cro_dynamic_checkout and can_buy -%}
    <div class="buy-buttons__express">{{ form | payment_button }}</div>
  {%- endif -%}
{%- endform -%}
</product-form>
