{%- comment -%}
  Customer registration.
{%- endcomment -%}

<div class="rpl-color-{{ section.settings.color_scheme }}">
  <div class="rpl-container rpl-container--narrow rpl-section">
    <div class="rpl-account-form">
      <h1>{{ 'customer.register.title' | t }}</h1>

      {%- form 'create_customer' -%}
        {%- if form.errors -%}
          <div class="rpl-form-status" role="alert" tabindex="-1">
            <p>{{ form.errors | default_errors }}</p>
          </div>
        {%- endif -%}

        <div class="rpl-field">
          <label class="rpl-field__label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
          <input
            class="rpl-input"
            type="text"
            name="customer[first_name]"
            id="RegisterFirstName"
            autocomplete="given-name"
            value="{{ form.first_name }}"
          >
        </div>

        <div class="rpl-field">
          <label class="rpl-field__label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
          <input
            class="rpl-input"
            type="text"
            name="customer[last_name]"
            id="RegisterLastName"
            autocomplete="family-name"
            value="{{ form.last_name }}"
          >
        </div>

        <div class="rpl-field">
          <label class="rpl-field__label" for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
          <input
            class="rpl-input"
            type="email"
            name="customer[email]"
            id="RegisterEmail"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            value="{{ form.email }}"
            required
          >
        </div>

        <div class="rpl-field">
          <label class="rpl-field__label" for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
          <input
            class="rpl-input"
            type="password"
            name="customer[password]"
            id="RegisterPassword"
            autocomplete="new-password"
            required
          >
        </div>

        <button class="rpl-button" type="submit">{{ 'customer.register.submit' | t }}</button>
      {%- endform -%}

      <p>
        <a href="{{ routes.account_login_url }}">{{ 'customer.log_in' | t }}</a>
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_register.name",
  "tag": "section",
  "class": "rpl-section-main-register",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
