{% layout none %}

{%- liquid
  assign default_scheme = 'scheme-paper'
  for scheme in settings.color_schemes limit: 1
    assign default_scheme = scheme.id
  endfor
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">

    {%- render 'theme-tokens' -%}

    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}

    {%- render 'meta-tags' -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body class="shell color-{{ default_scheme }} template-gift-card">
    <main class="shell__main section" tabindex="-1">
      <div class="page-width page-width--narrow text-center stack">
        <p class="caption">{{ 'gift_card.card' | t }}</p>
        <h1 class="h0">{{ gift_card.balance | money }}</h1>

        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="field__error">{{ 'gift_card.expired' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign expires_on = gift_card.expires_on | date: '%B %e, %Y' -%}
          <p class="text-muted">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
        {%- endif -%}

        {%- if settings.logo != blank -%}
          <p>
            {%- render 'image-fallback',
              image: settings.logo,
              alt: shop.name,
              widths: '300,600',
              sizes: '300px'
            -%}
          </p>
        {%- endif -%}

        <h2 class="h3">{{ shop.name | escape }}</h2>
        <p class="text-muted">{{ 'gift_card.use_at_checkout' | t }}</p>

        <p class="h4 gift-card__code">{{ gift_card.code | format_code }}</p>

        {%- if gift_card.pass_url -%}
          <p>
            <a href="{{ gift_card.pass_url }}">
              <img
                src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
                width="200"
                height="60"
                loading="lazy"
              >
            </a>
          </p>
        {%- endif -%}

        <p>
          <a class="button button--secondary" href="{{ shop.url }}">{{ 'cart.continue_shopping' | t }}</a>
        </p>
      </div>
    </main>
  </body>
</html>
