{%- comment -%}
  featured-collection.liquid — a row of products, as a grid or a slider.

  Renders on a store with no products: when the picked collection is empty
  (or none is picked), it falls through to card-product.liquid's demo mode,
  so the section shows real-looking shoes rather than an empty grid. That is
  the install state for every buyer, and it is the state this section is
  judged in.
{%- endcomment -%}

{%- liquid
  assign collection = collections[section.settings.collection]
  assign products = collection.products
  assign count = section.settings.products_to_show

  assign has_products = false
  if products.size > 0
    assign has_products = true
  endif

  assign layout_class = 'grid'
  if section.settings.layout == 'slider'
    assign layout_class = 'scroller'
  endif

  assign columns = section.settings.columns
-%}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-block-start: {{ section.settings.padding_top | times: 0.6 | round }}px;
    --section-padding-block-end: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    --section-padding-block-start-desktop: {{ section.settings.padding_top }}px;
    --section-padding-block-end-desktop: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.show_view_all -%}
      <div class="section__header section__header--split reveal">
        <div class="stack" style="--stack-gap: var(--sp-2);">
          {%- if section.settings.eyebrow != blank -%}
            <p class="caption">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="section__title h2">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>

        {%- if section.settings.show_view_all and collection != blank -%}
          <a class="button button--tertiary" href="{{ collection.url }}">
            {{- 'general.view_all' | t -}}
            {%- render 'icon', icon: 'arrow-right', size: 16 -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="{{ layout_class }} featured-collection__items"
      style="--grid-cols: {{ columns }}; --grid-cols-tablet: {{ columns | at_most: 3 }}; --grid-cols-mobile: 2;"
    >
      {%- if has_products -%}
        {%- for product in products limit: count -%}
          <div class="reveal" style="--reveal-delay: {{ forloop.index0 | at_most: 3 | times: 60 }}ms;">
            {%- render 'card-product',
              product: product,
              sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
              loading: 'lazy'
            -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..count) -%}
          <div class="reveal" style="--reveal-delay: {{ forloop.index0 | at_most: 3 | times: 60 }}ms;">
            {%- render 'card-product',
              demo_index: i,
              sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
              loading: 'lazy'
            -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-paper"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero.eyebrow.label",
      "default": "Best sellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "The ones people keep coming back for."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:general.collection",
      "info": "t:sections.featured_collection.collection.info"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured_collection.products_to_show.label",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.featured_collection.columns.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.featured_collection.layout.label",
      "options": [
        { "value": "grid", "label": "t:options.layout.grid" },
        { "value": "slider", "label": "t:options.layout.slider" }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_collection.show_view_all.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 96
    }
  ],
  "presets": [{ "name": "t:sections.featured_collection.name" }]
}
{% endschema %}
