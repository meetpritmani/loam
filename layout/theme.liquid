<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {% comment %}
      No `dir` attribute: Liquid exposes no locale direction, so the theme is
      built RTL-safe with CSS logical properties instead (margin-inline,
      inset-inline-*, text-align: start) and inherits direction from the
      browser/locale rather than hardcoding one.
    {% endcomment %}
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {% comment %}
      Swap the no-js class before first paint so CSS can branch on JS
      availability without a flash of the fallback state.
    {% endcomment %}
    <script>
      document.documentElement.classList.replace('no-js', 'js');
    </script>

    {% render 'css-variables' %}
    {% render 'critical-css' %}

    {% comment %}
      base.css is deferred: `media="print"` keeps it out of the critical path,
      the onload handler promotes it once downloaded. The <noscript> copy keeps
      the theme fully styled with JavaScript disabled.
    {% endcomment %}
    <link
      rel="stylesheet"
      href="{{ 'base.css' | asset_url }}"
      media="print"
      onload="this.media='all';this.onload=null;"
    >
    <noscript><link rel="stylesheet" href="{{ 'base.css' | asset_url }}"></noscript>

    <script src="{{ 'rpl-core.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="rpl-template-{{ request.page_type | handle }}">
    <a class="rpl-skip-link" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {% sections 'header-group' %}

    <div class="rpl-page-container">
      <main id="MainContent" class="rpl-main" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>
    </div>

    {% sections 'footer-group' %}

    {%- comment -%}
      Rendered directly (not through a section group) so it's always present
      when cart_type is "drawer" and can't be deleted from the Theme
      Editor's section list — see sections/cart-drawer.liquid.
    {%- endcomment -%}
    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {% comment %} Shared live regions — see RPL.announce() in rpl-core.js. {% endcomment %}
    <div id="rpl-live-status" class="rpl-visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
    <div id="rpl-live-alert" class="rpl-visually-hidden" role="alert" aria-live="assertive" aria-atomic="true"></div>
  </body>
</html>
