{%- comment -%}
  collection-list.liquid — shop by category.

  Each card is a collection with an overlay caption. Blocks rather than a
  single "collections" list setting, because each card needs its own image
  override and optional custom title — a merchant almost always wants a
  lifestyle crop here rather than the collection's own image.

  Falls back to demo category names and imagery when no collection is picked,
  so the section is never an empty row on a new store.
{%- endcomment -%}

{%- liquid
  assign demo_titles = 'Men,Women,Active,Lounge' | split: ','
  assign demo_images = 'demo-collection-mens.webp,demo-collection-womens.webp,demo-collection-active.webp,demo-collection-lounge.webp' | split: ','
-%}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-block-start: {{ section.settings.padding_top | times: 0.6 | round }}px;
    --section-padding-block-end: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    --section-padding-block-start-desktop: {{ section.settings.padding_top }}px;
    --section-padding-block-end-desktop: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section__header reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="caption">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="section__title h2">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <ul class="grid" style="--grid-cols: {{ section.settings.columns }}; --grid-cols-tablet: 2; --grid-cols-mobile: {{ section.settings.columns_mobile }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign block_collection = collections[block.settings.collection]

          comment
            §9.4: "Every card links to a non-empty collection." A blank
            picker is the fresh-install demo path (§10's comment above) and
            still renders — it is not "empty" in the sense this guards
            against. A collection the merchant actually picked that
            currently holds zero products is the case that must not render:
            it would be a live, clickable card leading nowhere.
          endcomment
          assign skip_card = false
          if block.settings.collection != blank and block_collection.products_count == 0
            assign skip_card = true
          endif

          assign position = forloop.index0 | modulo: 4
          assign title = block.settings.heading | default: block_collection.title | default: demo_titles[position]
          assign url = block_collection.url | default: routes.all_products_collection_url
          assign fallback_image = demo_images[position]
        -%}
        {%- unless skip_card -%}
          <li class="reveal" style="--reveal-delay: {{ forloop.index0 | at_most: 3 | times: 60 }}ms;" {{ block.shopify_attributes }}>
            {%- render 'card-collection',
              url: url,
              title: title,
              text: block.settings.text,
              image: block.settings.image,
              fallback: fallback_image,
              ratio: section.settings.image_ratio
            -%}
          </li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-paper"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Find your pair."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.featured_collection.columns.label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.collection_list.columns_mobile.label",
      "options": [
        { "value": "1", "label": "t:options.count.one" },
        { "value": "2", "label": "t:options.count.two" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.product_cards.card_image_ratio.label",
      "options": [
        { "value": "portrait", "label": "t:settings.product_cards.card_image_ratio.options.portrait" },
        { "value": "square", "label": "t:settings.product_cards.card_image_ratio.options.square" },
        { "value": "landscape", "label": "t:settings.product_cards.card_image_ratio.options.landscape" }
      ],
      "default": "portrait"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:sections.collection_list.blocks.category.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:general.collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:sections.collection_list.blocks.category.image.info"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "info": "t:sections.collection_list.blocks.category.heading.info"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.name",
      "blocks": [
        { "type": "category", "settings": { "heading": "Men", "text": "Everyday and trail" } },
        { "type": "category", "settings": { "heading": "Women", "text": "Everyday and trail" } },
        { "type": "category", "settings": { "heading": "Active", "text": "Runners and mids" } },
        { "type": "category", "settings": { "heading": "Lounge", "text": "Wool, indoors" } }
      ]
    }
  ]
}
{% endschema %}
