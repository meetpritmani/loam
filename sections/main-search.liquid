{%- comment -%}
  main-search.liquid — search results.

  Three states, and none of them is a dead end (§9.5):

    nothing searched yet  → popular products and collections to browse
    searched, no results  → spelling help, the merchant's popular searches,
                            and a route into the catalogue
    searched, results     → products first, then articles, then pages

  Products rank above pages because a shopper searching a shop is looking to
  buy far more often than to read (§9.4). Shopify returns one relevance-ranked
  list, so the ordering is done here: the page of results is walked three
  times, once per object type. Grouping inside the page rather than requesting
  three separate searches keeps it to a single query and keeps relevance
  intact within each group.

  The form is a plain GET form. Search works with JavaScript unavailable; the
  header's predictive search is the enhancement, not the mechanism.
{%- endcomment -%}

{%- liquid
  assign popular = section.settings.popular_collection
  if popular == blank
    assign popular = settings.cro_empty_cart_collection
  endif
  if popular == blank
    assign popular = collections.all
  endif

  assign browse_url = popular.url | default: routes.all_products_collection_url

  assign grid_sizes = '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign article_sizes = '(min-width: 990px) 32vw, (min-width: 750px) 45vw, 92vw'

  assign product_count = 0
  assign article_count = 0
  assign page_count = 0
-%}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="search-page">
      <div class="search-page__header">
        <h1 class="h2">{{ 'search.title' | t }}</h1>

        <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
          <div class="field search-page__field">
            <label class="visually-hidden" for="search-page-input">
              {{- 'search.placeholder' | t -}}
            </label>
            <input
              class="field__input"
              id="search-page-input"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'search.placeholder' | t }}"
              autocomplete="off"
            >
          </div>
          <button class="button button--primary" type="submit">{{ 'search.submit' | t }}</button>
        </form>
      </div>

      {%- if search.performed -%}
        {%- if search.results_count == 0 -%}
          {%- comment -%}
            §9.5: never a bare "nothing found". Spelling help, the merchant's
            own popular searches, and a way into the catalogue.
          {%- endcomment -%}
          {%- liquid
            assign no_results_heading = 'search.no_results_html' | t: terms: search.terms
            assign no_results_text = 'search.no_results_text' | t
            assign browse_label = 'search.browse_all' | t
          -%}
          <div class="search-page__empty">
            {%- render 'empty-state',
              heading: no_results_heading,
              text: no_results_text,
              link_url: browse_url,
              link_label: browse_label,
              icon: 'search'
            -%}

            {%- if section.blocks.size > 0 -%}
              <div class="search-page__suggestions">
                <h2 class="h6">{{ 'search.popular_searches' | t }}</h2>
                <ul class="cluster search-page__chips">
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'suggestion' and block.settings.term != blank -%}
                      <li {{ block.shopify_attributes }}>
                        <a
                          class="search-page__chip"
                          href="{{ routes.search_url }}?q={{ block.settings.term | url_encode }}"
                        >
                          {{- block.settings.term | escape -}}
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          {%- paginate search.results by section.settings.results_per_page -%}
          <facet-filters
            class="search-page__facets"
            data-section="{{ section.id }}"
            data-results="[data-search-results]"
          >
            {%- liquid
              for result in search.results
                case result.object_type
                  when 'product'
                    assign product_count = product_count | plus: 1
                  when 'article'
                    assign article_count = article_count | plus: 1
                  else
                    assign page_count = page_count | plus: 1
                endcase
              endfor

              assign has_filters = false
              if search.filters.size > 0
                assign has_filters = true
              endif
            -%}

            {%- comment -%}
              Same <facet-filters> component and facets__* markup as
              main-collection.liquid — see that file's comment for why the
              filter groups are real <details>, rendered once. `search.filters`
              only ever describes the product results, same object shape as
              `collection.filters`, so `facet-controls.liquid` needs no
              changes to serve both.
            {%- endcomment -%}
            {%- if has_filters -%}
              <form class="facets" id="facets-{{ section.id }}" data-facet-form>
                {%- for param in request.url_params -%}
                  {%- unless param.first contains 'filter.' or param.first == 'sort_by' or param.first == 'page' -%}
                    <input type="hidden" name="{{ param.first }}" value="{{ param.last | escape }}">
                  {%- endunless -%}
                {%- endfor -%}

                <div class="facets__bar">
                  <p class="facets__label caption">
                    {%- render 'icon', icon: 'filter', size: 16 -%}
                    <span>{{ 'collections.filters.title' | t }}</span>
                  </p>

                  <div class="facets__inline" data-facet-inline>
                    {%- for filter in search.filters -%}
                      <details class="facets__group" data-facet-group>
                        <summary class="facets__summary">
                          <span>{{ filter.label | escape }}</span>
                          {%- render 'icon', icon: 'chevron-down', size: 14 -%}
                        </summary>
                        <div class="facets__panel">
                          {%- render 'facet-controls', filter: filter, section_id: section.id -%}
                        </div>
                      </details>
                    {%- endfor -%}
                  </div>

                  <noscript>
                    <button class="button button--secondary" type="submit">
                      {{ 'collections.filters.apply' | t }}
                    </button>
                  </noscript>
                </div>

                {%- liquid
                  assign active_count = 0
                  for filter in search.filters
                    assign active_count = active_count | plus: filter.active_values.size
                    if filter.type == 'price_range'
                      if filter.min_value.value != nil
                        assign active_count = active_count | plus: 1
                      endif
                      if filter.max_value.value != nil
                        assign active_count = active_count | plus: 1
                      endif
                    endif
                  endfor
                -%}

                {%- if active_count > 0 -%}
                  <div class="facets__active">
                    <ul class="facets__chips">
                      {%- for filter in search.filters -%}
                        {%- for value in filter.active_values -%}
                          <li>
                            <a class="chip" href="{{ value.url_to_remove }}" data-facet-link>
                              <span>{{ filter.label | escape }}: {{ value.label | escape }}</span>
                              {%- render 'icon', icon: 'close', size: 12 -%}
                              <span class="visually-hidden">{{ 'collections.filters.remove' | t }}</span>
                            </a>
                          </li>
                        {%- endfor -%}

                        {%- if filter.type == 'price_range' -%}
                          {%- liquid
                            assign price_active = false
                            if filter.min_value.value != nil
                              assign price_active = true
                            endif
                            if filter.max_value.value != nil
                              assign price_active = true
                            endif
                          -%}
                          {%- if price_active -%}
                            <li>
                              <a class="chip" href="{{ filter.url_to_remove }}" data-facet-link>
                                <span>{{ filter.label | escape }}</span>
                                {%- render 'icon', icon: 'close', size: 12 -%}
                                <span class="visually-hidden">{{ 'collections.filters.remove' | t }}</span>
                              </a>
                            </li>
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>

                    <a class="link-underline" href="{{ routes.search_url }}?q={{ search.terms | url_encode }}" data-facet-link>
                      {{ 'collections.filters.clear_all' | t }}
                    </a>
                  </div>
                {%- endif -%}
              </form>
            {%- endif -%}

            <p class="search-page__count caption" role="status" data-result-count>
              {{- 'search.results_for_html' | t: terms: search.terms, count: search.results_count -}}
            </p>

            {%- comment -%}
              The swap target: on a filter change, <facet-filters> replaces
              only this div's contents, never the count above or the facets
              form itself (§ the same reasoning main-collection.liquid
              documents — replacing the form mid-interaction would close
              whatever dropdown the shopper has open).
            {%- endcomment -%}
            <div data-search-results>
              {%- if product_count > 0 -%}
                <section class="search-page__group" aria-labelledby="search-products">
                  <h2 class="h6" id="search-products">{{ 'search.products' | t }}</h2>
                  <ul class="grid" style="--grid-cols: 4; --grid-cols-tablet: 3; --grid-cols-mobile: 2;">
                    {%- for result in search.results -%}
                      {%- if result.object_type == 'product' -%}
                        <li>
                          {%- render 'card-product',
                            product: result,
                            heading_tag: 'h3',
                            sizes: grid_sizes
                          -%}
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </section>
              {%- endif -%}

              {%- if article_count > 0 -%}
                <section class="search-page__group" aria-labelledby="search-articles">
                  <h2 class="h6" id="search-articles">{{ 'search.articles' | t }}</h2>
                  <ul class="grid" style="--grid-cols: 3; --grid-cols-tablet: 2; --grid-cols-mobile: 1;">
                    {%- for result in search.results -%}
                      {%- if result.object_type == 'article' -%}
                        <li>
                          {%- render 'card-article',
                            article: result,
                            heading_tag: 'h3',
                            sizes: article_sizes
                          -%}
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </section>
              {%- endif -%}

              {%- if page_count > 0 -%}
                <section class="search-page__group" aria-labelledby="search-pages">
                  <h2 class="h6" id="search-pages">{{ 'search.pages' | t }}</h2>
                  <ul class="search-page__pages">
                    {%- for result in search.results -%}
                      {%- unless result.object_type == 'product' or result.object_type == 'article' -%}
                        <li>
                          <a class="search-page__page-link link-underline" href="{{ result.url }}">
                            {{- result.title | escape -}}
                          </a>
                        </li>
                      {%- endunless -%}
                    {%- endfor -%}
                  </ul>
                </section>
              {%- endif -%}

              {%- render 'pagination', paginate: paginate, anchor: '#main' -%}
            </div>
          </facet-filters>
          {%- endpaginate -%}
        {%- endif -%}
      {%- else -%}
        {%- comment -%}
          §9.4: the untouched search page shows popular products and
          collections rather than an empty page under a lone input.
        {%- endcomment -%}
        {%- if popular.products.size > 0 -%}
          <section class="search-page__group" aria-labelledby="search-popular">
            <h2 class="h6" id="search-popular">{{ 'search.popular_products' | t }}</h2>
            <ul class="grid" style="--grid-cols: 4; --grid-cols-tablet: 3; --grid-cols-mobile: 2;">
              {%- for product in popular.products limit: section.settings.popular_count -%}
                <li>
                  {%- render 'card-product',
                    product: product,
                    heading_tag: 'h3',
                    sizes: grid_sizes
                  -%}
                </li>
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}

        {%- if collections.size > 0 -%}
          <section class="search-page__group" aria-labelledby="search-collections">
            <h2 class="h6" id="search-collections">{{ 'search.browse_collections' | t }}</h2>
            <ul class="grid" style="--grid-cols: 4; --grid-cols-tablet: 3; --grid-cols-mobile: 2;">
              {%- for collection in collections limit: 4 -%}
                {%- if collection.all_products_count > 0 -%}
                  <li>
                    {%- render 'card-collection',
                      collection: collection,
                      ratio: 'square',
                      sizes: grid_sizes
                    -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "tag": "section",
  "class": "section-main-search",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "suggestion",
      "name": "t:sections.main_search.blocks.suggestion.name",
      "settings": [
        {
          "type": "text",
          "id": "term",
          "label": "t:sections.main_search.blocks.suggestion.term.label",
          "default": "Merino wool"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-paper"
    },
    {
      "type": "collection",
      "id": "popular_collection",
      "label": "t:sections.main_search.popular_collection.label",
      "info": "t:sections.main_search.popular_collection.info"
    },
    {
      "type": "range",
      "id": "popular_count",
      "label": "t:sections.main_search.popular_count.label",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "t:sections.main_search.results_per_page.label",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 64
    }
  ]
}
{% endschema %}
