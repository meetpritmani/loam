{%- comment -%}
  Password (coming soon) page. Handles: no password message set, no logo,
  and a wrong-password submission.
{%- endcomment -%}

{%- liquid
  assign has_logo = false
  if settings.logo != blank or shop.brand.logo != blank
    assign has_logo = true
  endif
  assign logo_image = settings.logo | default: shop.brand.logo
  assign logo_sizes = settings.logo_width | append: 'px'
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --rpl-logo-width: {{ settings.logo_width }}px;
  }
{% endstyle %}

<div class="rpl-color-{{ section.settings.color_scheme }} rpl-password">
  <div class="rpl-container rpl-container--narrow rpl-section rpl-password__inner">
    <header class="rpl-password__header">
      {%- if has_logo -%}
        {% render 'responsive-image',
          image: logo_image,
          alt: shop.name,
          loading: 'eager',
          fetchpriority: 'high',
          class: 'rpl-password__logo',
          widths: '120, 180, 240, 360',
          sizes: logo_sizes
        %}
      {%- else -%}
        <h1 class="rpl-password__shop-name">{{ shop.name }}</h1>
      {%- endif -%}
    </header>

    <h2>{{ 'general.password_page.opening_soon' | t }}</h2>

    {%- if shop.password_message != blank -%}
      <div class="rpl-rte">{{ shop.password_message }}</div>
    {%- endif -%}

    <details class="rpl-password__login">
      <summary class="rpl-button rpl-button--secondary">
        {{- 'general.password_page.login_password_button' | t -}}
      </summary>

      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <div class="rpl-form-status" role="alert" tabindex="-1">
            <p>{{ 'general.password_page.login_form_error' | t }}</p>
          </div>
        {%- endif -%}

        <div class="rpl-field">
          <label class="rpl-field__label" for="StorefrontPassword">
            {{- 'general.password_page.login_form_password_label' | t -}}
          </label>
          <input
            class="rpl-input"
            type="password"
            name="password"
            id="StorefrontPassword"
            autocomplete="current-password"
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
            {% if form.errors %}
              aria-invalid="true"
            {% endif %}
          >
        </div>

        <button class="rpl-button" type="submit">{{ 'general.password_page.login_form_submit' | t }}</button>
      {%- endform -%}
    </details>

    <p class="rpl-caption rpl-muted">
      <a href="https://www.shopify.com" rel="nofollow">{{ 'general.password_page.admin_link_html' | t }}</a>
    </p>
  </div>
</div>

{% stylesheet %}
  .rpl-password__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--rpl-space-sm);
    min-height: 80vh;
    justify-content: center;
    text-align: center;
  }

  .rpl-password__logo {
    width: var(--rpl-logo-width, 120px);
    height: auto;
    margin-inline: auto;
  }

  .rpl-password__shop-name {
    margin: 0;
  }

  .rpl-password__login > summary {
    display: inline-flex;
    list-style: none;
  }

  .rpl-password__login > summary::-webkit-details-marker {
    display: none;
  }

  .rpl-password__login form {
    display: flex;
    flex-direction: column;
    gap: var(--rpl-space-2xs);
    max-width: 22rem;
    margin: var(--rpl-space-sm) auto 0;
    text-align: start;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_password.name",
  "tag": "section",
  "class": "rpl-section-main-password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-2"
    }
  ]
}
{% endschema %}
