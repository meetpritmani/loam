{%- comment -%}
  PLACEHOLDER — rebuilt in phase 4 (build spec §9, Templates).
{%- endcomment -%}

<article class="section">
  <div class="page-width page-width--narrow stack">
    <p class="caption">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="h1">{{ article.title | escape }}</h1>

    {%- if article.image -%}
      <div class="media media--wide">
        {%- render 'image-fallback', image: article.image, alt: article.title, sizes: '(min-width: 990px) 760px, 100vw' -%}
      </div>
    {%- endif -%}

    <div class="rte">{{ article.content }}</div>
  </div>

  {%- if blog.comments_enabled? -%}
    <div class="page-width page-width--narrow stack" id="comments">
      <h2 class="h3">{{ 'blog.article_comments' | t }}</h2>

      {%- paginate article.comments by 10 -%}
        {%- for comment in article.comments -%}
          <div class="stack">
            <p class="caption">{{ comment.author | escape }} — {{ comment.created_at | time_tag: format: 'date' }}</p>
            <div class="rte">{{ comment.content }}</div>
          </div>
        {%- endfor -%}

        {%- if paginate.pages > 1 -%}
          <nav aria-label="{{ 'general.pagination.label' | t }}">
            {{- paginate | default_pagination: anchor: 'comments' -}}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}

      {%- form 'new_comment', article -%}
        <h3 class="h4">{{ 'blog.comment_form_title' | t }}</h3>

        {{ form.errors | default_errors }}

        <div class="field">
          <label class="field__label" for="comment-author">{{ 'blog.comment_form_name' | t }}</label>
          <input class="field__input" type="text" name="comment[author]" id="comment-author" value="{{ form.author }}" required>
        </div>

        <div class="field">
          <label class="field__label" for="comment-email">{{ 'blog.comment_form_email' | t }}</label>
          <input class="field__input" type="email" name="comment[email]" id="comment-email" value="{{ form.email }}" required>
        </div>

        <div class="field">
          <label class="field__label" for="comment-body">{{ 'blog.comment_form_body' | t }}</label>
          <textarea class="field__textarea" name="comment[body]" id="comment-body" required>{{ form.body }}</textarea>
        </div>

        <button class="button button--primary" type="submit">{{ 'blog.comment_form_submit' | t }}</button>
      {%- endform -%}
    </div>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "t:sections.main_article.name",
  "settings": []
}
{% endschema %}
