{%- comment -%}
  Renders a single testimonial: star rating, quote, photo, name, and an
  optional linked product.

  Accepts:
  - block: {Object} a "testimonial" block from sections/testimonials.liquid.

  Handles: no photo (no avatar shown, not a broken image), no linked
  product, rating 1-5.

  Styled from sections/testimonials.liquid's {% stylesheet %} — snippets
  can't carry their own style tags.
{%- endcomment -%}

{%- liquid
  assign rating = block.settings.rating
  assign rating_label = 'general.rating' | t: rating: rating
-%}

<div class="rpl-testimonial-card">
  {%- if rating > 0 -%}
    <div class="rpl-testimonial-card__stars" role="img" aria-label="{{ rating_label }}">
      {%- for i in (1..5) -%}
        <span {% if i > rating %}class="rpl-testimonial-card__star--empty"{% endif %}>
          {% render 'icon', icon: 'star' %}
        </span>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if block.settings.quote != blank -%}
    <blockquote class="rpl-testimonial-card__quote rpl-rte">{{ block.settings.quote }}</blockquote>
  {%- endif -%}

  {%- if block.settings.photo != blank or block.settings.name != blank -%}
    <div class="rpl-testimonial-card__author">
      {%- if block.settings.photo != blank -%}
        <div class="rpl-testimonial-card__avatar">
          {% render 'responsive-image',
            image: block.settings.photo,
            alt: block.settings.name,
            loading: 'lazy',
            sizes: '40px',
            widths: '40, 80',
            wrapper_ratio: 'square'
          %}
        </div>
      {%- endif -%}
      {%- if block.settings.name != blank -%}
        <p class="rpl-testimonial-card__name">{{ block.settings.name | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if block.settings.product != blank -%}
    <p class="rpl-testimonial-card__product rpl-caption rpl-muted">
      <a href="{{ block.settings.product.url }}">{{ block.settings.product.title | escape }}</a>
    </p>
  {%- endif -%}
</div>
