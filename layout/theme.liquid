{%- liquid
  assign rtl_locales = 'ar,he,fa,ur,yi'
  assign locale_root = request.locale.iso_code | split: '-' | first | downcase
  assign rtl_list = rtl_locales | split: ','
  assign text_direction = 'ltr'
  if rtl_list contains locale_root
    assign text_direction = 'rtl'
  endif

  assign default_scheme = 'scheme-paper'
  for scheme in settings.color_schemes limit: 1
    assign default_scheme = scheme.id
  endfor
-%}
<!doctype html>
<html
  lang="{{ request.locale.iso_code }}"
  dir="{{ text_direction }}"
  {% unless settings.enable_reveal %}
    data-reveal="off"
  {% endunless %}
>
  <head>
    {%- comment -%}
      charset and viewport come first and stay first — charset must fall
      inside the first 1024 bytes of the document or the browser re-parses.
      Nothing that can grow (tokens, meta tags) may be placed above them.
    {%- endcomment -%}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no">

    {%- comment -%}
      Fonts: preload both families the theme actually renders, then let
      theme-tokens.liquid declare the @font-face rules with swap.
    {%- endcomment -%}
    {%- unless settings.heading_font.system? and settings.body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}
    {%- unless settings.body_font.system? -%}
      {{ settings.body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {%- endunless -%}
    {%- unless settings.heading_font.system? -%}
      {{ settings.heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {%- endunless -%}

    {%- render 'theme-tokens' -%}

    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}

    <script src="{{ 'global.js' | asset_url }}" type="module"></script>

    {%- render 'meta-tags' -%}
    {%- render 'structured-data' -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      {%- comment -%}
        No favicon uploaded yet — an empty data URI stops the browser
        probing /favicon.ico on its own, which otherwise 404s and prints a
        console error on every page of a fresh install. Not an image, so
        it is not something §6's "no bundled imagery" rule concerns.
      {%- endcomment -%}
      <link rel="icon" href="data:,">
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body class="shell color-{{ default_scheme }} template-{{ request.page_type | handle }}">
    <a class="skip-link" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main" class="shell__main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- comment -%}
      The cart drawer is a static section rather than part of a section
      group: it has to exist on every template, it is never reordered, and
      the Section Rendering API can target it by name from anywhere. It is
      not rendered at all when the merchant has chosen a cart page, so the
      markup and its JS never load for stores that do not use it.
    {%- endcomment -%}
    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {%- comment -%}
      The single polite live region for the whole theme. Cart updates, form
      results, and any failed fetch announce through global.js's announce().
    {%- endcomment -%}
    <div
      id="a11y-announcer"
      class="visually-hidden"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></div>

    <ul hidden>
      <li id="a11y-new-window-message">{{ 'accessibility.new_window' | t }}</li>
    </ul>

    {%- comment -%}
      The analytics payload for this page (§9.8). Renders nothing at all
      unless the merchant has switched the data layer on, which it is not by
      default — see the snippet for why.
    {%- endcomment -%}
    {%- render 'analytics-events', scope: 'page' -%}
  </body>
</html>
