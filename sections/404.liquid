{%- comment -%}
  PLACEHOLDER — rebuilt in phase 4 (build spec §9, Templates).
  Kept minimal and valid so the 404 template renders on the Loam shell.
{%- endcomment -%}

<div class="section">
  <div class="page-width page-width--narrow text-center stack">
    <h1 class="h1">{{ '404.title' | t }}</h1>
    <p class="text-muted">{{ '404.not_found' | t }}</p>
    <p>
      <a class="button button--primary" href="{{ routes.all_products_collection_url }}">
        {{ '404.back_to_shopping' | t }}
      </a>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "settings": []
}
{% endschema %}
