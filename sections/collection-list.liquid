{%- comment -%}
  Collection list using the native collection_list setting (merchants pick
  collections directly — no repeatable "collection" blocks duplicating what
  that setting type already does). Grid or carousel layout; carousel uses a
  native CSS scroll-snap track (real touch swipe, no JS required for that
  part) with rpl-core.js's shared [data-carousel] enhancement only adding
  the optional prev/next buttons, which stay hidden until hover/focus on
  desktop.

  Handles: 0 collections picked (section renders nothing, not an empty
  grid/track), a picked collection that was later deleted (skipped, not a
  broken card), no collection image, many collections (grid wraps /
  carousel scrolls), title-overlay on and off.
{%- endcomment -%}

{%- liquid
  assign collections = section.settings.collections
  assign valid_count = 0
  for collection in collections
    unless collection == blank
      assign valid_count = valid_count | plus: 1
    endunless
  endfor

  assign carousel_label = section.settings.heading
  if carousel_label == blank
    assign carousel_label = 'general.slideshow.name' | t
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .rpl-collection-list__grid {
    --rpl-grid-columns-mobile: 1;
    --rpl-grid-columns-desktop: {{ section.settings.columns_desktop }};
  }
{% endstyle %}

{%- if valid_count > 0 -%}
  <div class="rpl-color-{{ section.settings.color_scheme }}">
    <div class="rpl-container rpl-section">
      {%- if section.settings.heading != blank or section.settings.show_view_all -%}
        <div class="rpl-collection-list__header">
          {%- if section.settings.heading != blank -%}
            <h2 class="rpl-collection-list__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.show_view_all -%}
            <a class="rpl-button rpl-button--link" href="{{ routes.collections_url }}">
              {{- section.settings.view_all_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.layout == 'carousel' -%}
        <div class="rpl-collection-list__carousel-wrap" data-carousel>
          <ul
            class="rpl-list-unstyled rpl-collection-list__carousel"
            data-carousel-track
            tabindex="0"
            role="region"
            aria-label="{{ carousel_label | escape }}"
          >
            {%- for collection in collections -%}
              {%- unless collection == blank -%}
                <li data-carousel-item>
                  {% render 'collection-card', collection: collection, ratio: section.settings.image_ratio, show_title_overlay: section.settings.show_title_overlay %}
                </li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>

          <button type="button" class="rpl-icon-button rpl-collection-list__arrow rpl-collection-list__arrow--prev" data-carousel-prev>
            <span class="rpl-visually-hidden">{{ 'general.slideshow.previous_slide' | t }}</span>
            {% render 'icon', icon: 'chevron-left' %}
          </button>
          <button type="button" class="rpl-icon-button rpl-collection-list__arrow rpl-collection-list__arrow--next" data-carousel-next>
            <span class="rpl-visually-hidden">{{ 'general.slideshow.next_slide' | t }}</span>
            {% render 'icon', icon: 'chevron-right' %}
          </button>
        </div>
      {%- else -%}
        <ul class="rpl-grid rpl-collection-list__grid rpl-list-unstyled">
          {%- for collection in collections -%}
            {%- unless collection == blank -%}
              <li class="rpl-reveal">
                {% render 'collection-card', collection: collection, ratio: section.settings.image_ratio, show_title_overlay: section.settings.show_title_overlay %}
              </li>
            {%- endunless -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .rpl-collection-list__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--rpl-space-sm);
    margin-block-end: var(--rpl-space-md);
  }

  .rpl-collection-list__heading {
    margin: 0;
  }

  .rpl-collection-list__carousel-wrap {
    position: relative;
  }

  .rpl-collection-list__carousel {
    display: flex;
    gap: var(--rpl-grid-gap-horizontal);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--rpl-space-sm);
    padding-block-end: var(--rpl-space-2xs);
  }

  .rpl-collection-list__carousel > li {
    flex: 0 0 auto;
    width: min(80vw, 20rem);
    scroll-snap-align: start;
  }

  .rpl-collection-list__arrow {
    position: absolute;
    top: 40%;
    z-index: 1;
    background-color: rgb(var(--rpl-color-background));
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.15);
    opacity: 0;
    transition: opacity var(--rpl-duration-fast) var(--rpl-ease);
  }

  .rpl-collection-list__carousel-wrap:hover .rpl-collection-list__arrow,
  .rpl-collection-list__carousel-wrap:focus-within .rpl-collection-list__arrow {
    opacity: 1;
  }

  .rpl-collection-list__arrow--prev {
    inset-inline-start: var(--rpl-space-2xs);
  }

  .rpl-collection-list__arrow--next {
    inset-inline-end: var(--rpl-space-2xs);
  }

  @media (hover: none) {
    /* Touch devices: swipe is the primary interaction, arrows would just
       sit there permanently opaque with no hover state to hide them. */
    .rpl-collection-list__arrow {
      display: none;
    }
  }

  .rpl-collection-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .rpl-collection-card__media {
    position: relative;
  }

  .rpl-collection-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.5), transparent 50%);
    border-radius: var(--rpl-media-radius);
  }

  .rpl-collection-card__title {
    margin: var(--rpl-space-2xs) 0 0;
    font-weight: var(--rpl-font-body-weight-bold);
  }

  .rpl-collection-card__title--overlay {
    position: absolute;
    inset-inline: var(--rpl-space-sm);
    inset-block-end: var(--rpl-space-sm);
    margin: 0;
    color: #fff;
  }

  .rpl-collection-card:hover .rpl-collection-card__title {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.collection_list_section.name",
  "tag": "section",
  "class": "rpl-section-collection-list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "Shop by category"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "t:sections.collection_list_section.settings.collections.label",
      "limit": 12
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.collection_list_section.settings.layout.label",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.collection_list_section.settings.layout.options__1.label"
        },
        {
          "value": "carousel",
          "label": "t:sections.collection_list_section.settings.layout.options__2.label"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.all.columns_desktop.label",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings_schema.cards.settings.card_image_ratio.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:settings_schema.cards.settings.card_image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:settings_schema.cards.settings.card_image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:settings_schema.cards.settings.card_image_ratio.options__3.label"
        }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_title_overlay",
      "label": "t:sections.collection_list_section.settings.show_title_overlay.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.collection_list_section.settings.show_view_all.label",
      "default": false
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:sections.collection_list_section.settings.view_all_label.label",
      "default": "View all"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list_section.name"
    }
  ]
}
{% endschema %}
