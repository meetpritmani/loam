{%- comment -%}
  newsletter.liquid — email capture.

  The form itself lives in `newsletter-form.liquid`, shared with the footer,
  the blog list and the article foot, so every capture point on the store
  behaves the same way and there is only one place to change it.
{%- endcomment -%}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-block-start: {{ section.settings.padding_top | times: 0.6 | round }}px;
    --section-padding-block-end: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    --section-padding-block-start-desktop: {{ section.settings.padding_top }}px;
    --section-padding-block-end-desktop: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    <div class="newsletter-section{% if section.settings.center %} newsletter-section--center{% endif %} reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="caption">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="text-muted">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- render 'newsletter-form',
        id: section.id,
        class: 'newsletter-section__form',
        fine_print: section.settings.fine_print
      -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-sand"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Get first access."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text",
      "default": "New colourways, restocks, and the occasional field note. Two emails a month, no more."
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "t:sections.footer.blocks.newsletter.fine_print.label",
      "default": "Unsubscribe any time."
    },
    {
      "type": "checkbox",
      "id": "center",
      "label": "t:sections.impact_stats.center.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 96
    }
  ],
  "presets": [{ "name": "t:sections.newsletter.name" }]
}
{% endschema %}
