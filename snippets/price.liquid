{%- comment -%}
  Renders a product or variant price with sale, "from", and unit pricing.

  Accepts:
  - product: {Object} product or variant. Required.
  - use_variant: {Boolean} price the selected/first available variant instead
    of the product's price range.
  - show_badges: {Boolean} render Sale / Sold out badges.

  Handles: free products (0), price ranges, sold out, and products with no
  compare-at price. Never assumes compare_at_price exists.
{%- endcomment -%}

{%- liquid
  if use_variant and product.selected_or_first_available_variant != blank
    assign target = product.selected_or_first_available_variant
  else
    assign target = product
  endif

  assign compare_at = target.compare_at_price
  assign price = target.price | default: 0
  assign on_sale = false
  if compare_at > price
    assign on_sale = true
  endif

  assign show_from = false
  if use_variant != true and product.price_varies
    assign show_from = true
  endif
-%}

<div class="rpl-price{% if on_sale %} rpl-price--on-sale{% endif %}">
  <span class="rpl-visually-hidden">
    {%- if on_sale -%}
      {{ 'products.product.price.sale_price' | t }}
    {%- else -%}
      {{ 'products.product.price.regular_price' | t }}
    {%- endif -%}
  </span>

  <span class="rpl-price__current">
    {%- if show_from -%}
      {{ 'products.product.price.from_price_html' | t: price: price | money }}
    {%- else -%}
      {{ price | money }}
    {%- endif -%}
  </span>

  {%- if on_sale -%}
    <span class="rpl-visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
    <s class="rpl-price__compare">{{ compare_at | money }}</s>
  {%- endif -%}

  {%- if target.unit_price_measurement -%}
    <span class="rpl-price__unit rpl-caption rpl-muted">
      <span class="rpl-visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
      {{ target.unit_price | money }}
      <span aria-hidden="true">/</span>
      <span class="rpl-visually-hidden">{{ 'accessibility.unit_price_separator' | t }}</span>
      {%- if target.unit_price_measurement.reference_value != 1 -%}
        {{- target.unit_price_measurement.reference_value -}}
      {%- endif -%}
      {{ target.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}

  {%- if show_badges -%}
    {%- if product.available == false -%}
      <span class="rpl-badge rpl-badge--subtle">{{ 'products.product.sold_out' | t }}</span>
    {%- elsif on_sale -%}
      <span class="rpl-badge">{{ 'products.product.on_sale' | t }}</span>
    {%- endif -%}
  {%- endif -%}
</div>
