{%- comment -%}
  PLACEHOLDER — rebuilt in phase 4 (build spec §9, Templates).
{%- endcomment -%}

<div class="section">
  <div class="page-width stack">
    <h1 class="h1">{{ blog.title | escape }}</h1>

    {%- paginate blog.articles by 12 -%}
      <div class="grid" style="--grid-cols: 3;">
        {%- for article in blog.articles -%}
          <article class="card">
            <a class="media media--landscape" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {%- render 'image-fallback',
                image: article.image,
                alt: article.title,
                sizes: '(min-width: 990px) 33vw, 100vw'
              -%}
            </a>
            <div class="card__body">
              <p class="caption">
                {{- article.published_at | time_tag: format: 'date' -}}
              </p>
              <h2 class="h4">
                <a class="card__link link" href="{{ article.url }}">{{ article.title | escape }}</a>
              </h2>
              <p class="text-muted text-body-sm">{{ article.excerpt_or_content | strip_html | truncatewords: 25 }}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="text-center" aria-label="{{ 'general.pagination.label' | t }}">
          {{- paginate | default_pagination -}}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_blog.name",
  "settings": []
}
{% endschema %}
