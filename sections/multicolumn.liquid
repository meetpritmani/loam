{%- comment -%}
  multicolumn.liquid — the generic 2-4 column row.

  Deliberately plain: image, heading, text, link. This is the section a
  merchant reaches for when nothing purpose-built fits, so it should not
  impose a look of its own beyond the theme's spacing and type.

  Images are optional per block. A column without one collapses to text
  rather than reserving an empty media box, so a mixed row does not end up
  with holes in it.
{%- endcomment -%}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-block-start: {{ section.settings.padding_top | times: 0.6 | round }}px;
    --section-padding-block-end: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    --section-padding-block-start-desktop: {{ section.settings.padding_top }}px;
    --section-padding-block-end-desktop: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section__header{% if section.settings.center_heading %} section__header--center{% endif %} reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="caption">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="section__title h2">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <ul
      class="grid multicolumn multicolumn--{{ section.settings.alignment }}"
      style="--grid-cols: {{ section.settings.columns }}; --grid-cols-tablet: 2; --grid-cols-mobile: 1;"
    >
      {%- for block in section.blocks -%}
        <li
          class="multicolumn__item reveal"
          style="--reveal-delay: {{ forloop.index0 | at_most: 3 | times: 60 }}ms;"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <div class="multicolumn__media media media--{{ section.settings.image_ratio }}">
              {%- render 'image-fallback',
                image: block.settings.image,
                alt: block.settings.heading,
                sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw'
              -%}
            </div>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h3 class="h5">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="rte text-body-sm text-muted">{{ block.settings.text }}</div>
          {%- endif -%}

          {%- if block.settings.link_label != blank -%}
            <a class="button button--tertiary" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
              {{- block.settings.link_label | escape -}}
              {%- render 'icon', icon: 'arrow-right', size: 14 -%}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-paper"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "How to look after them."
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "t:sections.impact_stats.center.label",
      "default": false
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.featured_collection.columns.label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "start", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.product_cards.card_image_ratio.label",
      "options": [
        { "value": "portrait", "label": "t:settings.product_cards.card_image_ratio.options.portrait" },
        { "value": "square", "label": "t:settings.product_cards.card_image_ratio.options.square" },
        { "value": "landscape", "label": "t:settings.product_cards.card_image_ratio.options.landscape" }
      ],
      "default": "landscape"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:general.column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:sections.multicolumn.blocks.column.image.info"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Washing"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Insoles out, cold gentle cycle, air dry away from direct heat. Never the dryer.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.multicolumn.blocks.column.link_label.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.multicolumn.name",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "heading": "Washing",
            "text": "<p>Insoles out, cold gentle cycle, air dry away from direct heat. Never the dryer.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Wearing",
            "text": "<p>Wool moulds to your foot over the first week. Give them a few days before you decide on the fit.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Recycling",
            "text": "<p>Worn through? Send them back with the label in your account and take credit off your next pair.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
