node_modules/
.DS_Store
Thumbs.db
*.log
.shopify/
.env

# Scratch test harnesses must never land in the theme. The seeding scripts of
# §12 are .mjs and DO belong in the repo, so they are negated below — without
# that, `git add -A` silently skips the entire scripts/ tree.
*.mjs
!scripts/**/*.mjs
*profile/

# Demo media. Raw downloads and their optimised output are both large and
# both re-derivable; the buyer gets them through demo-store-export/ instead.
#
# `demo-media-raw/*` rather than `demo-media-raw/`, so the README inside it is
# still reachable — git cannot un-ignore a file inside an ignored *directory*,
# only inside an ignored set of paths.
demo-media-raw/*
!demo-media-raw/README.md
demo-media/

# demo-store-export/ is a build output directory. README.md is the only source
# file in it; everything else — the CSV, the markdown guides, the media, the
# map and the seed log — is generated by `npm run seed` from demo-data.mjs and
# from whatever is in the store. Committing generated copies would give us two
# versions of the same content that drift.
demo-store-export/*
!demo-store-export/README.md

# Internal build docs — not part of the distributable theme
PROGRESS.md

# Build output of `shopify theme package`.
*.zip
