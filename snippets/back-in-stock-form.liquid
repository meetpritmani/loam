{%- comment -%}
  back-in-stock-form.liquid — real demand capture for a sold-out variant.

  No app, no API call the theme makes itself: this is a plain
  {% form 'customer' %}, exactly the mechanism newsletter-form.liquid already
  uses, tagged so the merchant can segment and follow up by hand, through
  Shopify Flow, or through whatever restock app they choose. The theme
  never claims to send the notification itself — §7's ban on app-like
  functionality that needs API access is about the theme silently depending
  on a backend it doesn't have, and native customer tagging isn't that.

  One field, same as every other capture point in the theme (§9.6
  newsletter-form row). The variant id rides along as a tag
  (`restock:{{ variant.id }}`) rather than free text, so a merchant's export
  or Flow trigger can match on it exactly.

  Params:
    variant  (variant, required)
    product  (product, required)
{%- endcomment -%}

{%- if variant != blank and product != blank -%}
  {%- liquid
    assign form_id = 'back-in-stock-' | append: variant.id
    assign field_id = form_id | append: '-email'
    assign message_id = form_id | append: '-message'
    assign restock_tag = 'restock:' | append: variant.id
  -%}

  <details class="back-in-stock">
    <summary class="back-in-stock__summary link-underline">
      {{ 'products.product.back_in_stock_summary' | t }}
    </summary>

    {%- form 'customer', id: form_id, class: 'back-in-stock__form' -%}
      <input type="hidden" name="contact[tags]" value="{{ restock_tag | escape }}">
      <input type="hidden" name="contact[note]" value="{{ product.title | append: ' — ' | append: variant.title | escape }}">

      <div class="back-in-stock__field">
        <label class="visually-hidden" for="{{ field_id }}">
          {{ 'products.product.back_in_stock_label' | t }}
        </label>
        <input
          class="field__input"
          id="{{ field_id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ 'newsletter.placeholder' | t }}"
          autocomplete="email"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="{{ message_id }}"
          {% endif %}
        >
        <button class="button button--secondary" type="submit">
          {{ 'products.product.back_in_stock_submit' | t }}
        </button>
      </div>

      <p class="back-in-stock__message field__hint" id="{{ message_id }}" role="status">
        {%- if form.errors -%}
          <span class="field__error">{{ form.errors.messages.email }}</span>
        {%- elsif form.posted_successfully? -%}
          {%- render 'icon', icon: 'check', size: 14 -%}
          {{ 'products.product.back_in_stock_success' | t }}
        {%- endif -%}
      </p>
    {%- endform -%}
  </details>
{%- endif -%}
