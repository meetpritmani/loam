{%- comment -%}
  newsletter.liquid — email capture.

  Uses Shopify's own {% form 'customer' %} so the address lands in the
  merchant's customer list with no app and no third-party script.

  Success and error states are both handled inline and announced: the result
  message carries role="status", so a shopper using a screen reader is told
  the signup worked instead of being left listening to an unchanged page. On
  error, the input gets aria-invalid and is pointed at the message with
  aria-describedby.
{%- endcomment -%}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-block-start: {{ section.settings.padding_top | times: 0.6 | round }}px;
    --section-padding-block-end: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    --section-padding-block-start-desktop: {{ section.settings.padding_top }}px;
    --section-padding-block-end-desktop: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    <div class="newsletter-section{% if section.settings.center %} newsletter-section--center{% endif %} reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="caption">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="text-muted">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'newsletter-form', class: 'newsletter-section__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">

        <div class="newsletter__field">
          <label class="visually-hidden" for="newsletter-{{ section.id }}">
            {{- 'newsletter.label' | t -}}
          </label>
          <input
            class="field__input newsletter__input"
            id="newsletter-{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ 'newsletter.placeholder' | t }}"
            autocomplete="email"
            required
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="newsletter-message-{{ section.id }}"
            {% endif %}
          >
          <button
            class="newsletter__submit icon-button"
            type="submit"
            aria-label="{{ 'newsletter.submit' | t }}"
          >
            {%- render 'icon', icon: 'arrow-right', size: 18 -%}
          </button>
        </div>

        {%- comment -%}
          The region exists whether or not there is a message, so the height
          is reserved and submitting does not shift the page.
        {%- endcomment -%}
        <p
          class="newsletter-section__message"
          id="newsletter-message-{{ section.id }}"
          role="status"
        >
          {%- if form.errors -%}
            <span class="field__error">{{ form.errors.messages.email }}</span>
          {%- elsif form.posted_successfully? -%}
            <span class="field__hint">
              {%- render 'icon', icon: 'check', size: 14 -%}
              {{ 'newsletter.success' | t }}
            </span>
          {%- endif -%}
        </p>

        {%- if section.settings.fine_print != blank -%}
          <p class="field__hint">{{ section.settings.fine_print | escape }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-sand"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Get first access."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text",
      "default": "New colourways, restocks, and the occasional field note. Two emails a month, no more."
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "t:sections.footer.blocks.newsletter.fine_print.label",
      "default": "Unsubscribe any time."
    },
    {
      "type": "checkbox",
      "id": "center",
      "label": "t:sections.impact_stats.center.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 96
    }
  ],
  "presets": [{ "name": "t:sections.newsletter.name" }]
}
{% endschema %}
