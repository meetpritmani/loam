{%- comment -%}
  main-collection-banner.liquid — the category header.

  §9.4: describes the category in one line and never pushes the first product
  row below the fold on mobile. That is why there is no full-bleed hero option
  here and why the image height is capped — a banner that fills the phone
  screen buys nothing and costs the shopper a scroll before they see a single
  product.

  The description comes from the collection itself, so a merchant writes it
  once in admin rather than twice.
{%- endcomment -%}

{%- liquid
  assign has_image = false
  if section.settings.show_image and collection.featured_image != blank
    assign has_image = true
  endif

  assign description = collection.description
  if section.settings.show_description == false
    assign description = blank
  endif
-%}

<div
  class="section section--tight color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}
      {%- render 'breadcrumbs', class: 'collection-banner__breadcrumbs' -%}
    {%- endif -%}

    <div class="collection-banner{% if has_image %} collection-banner--with-image{% endif %}">
      <div class="collection-banner__text">
        <h1 class="collection-banner__title h2">{{ collection.title | escape }}</h1>

        {%- if description != blank -%}
          <div class="collection-banner__description rte">{{ description }}</div>
        {%- endif -%}
      </div>

      {%- if has_image -%}
        <div class="collection-banner__media media media--landscape">
          {%- render 'image-fallback',
            image: collection.featured_image,
            fallback: 'demo-collection-mens.webp',
            alt: collection.title,
            sizes: '(min-width: 990px) 40vw, 100vw',
            widths: '400, 600, 800, 1000, 1200',
            loading: 'eager'
          -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_collection_banner.name",
  "tag": "section",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-paper"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:sections.main_product.show_breadcrumbs.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.main_collection_banner.show_description.label",
      "info": "t:sections.main_collection_banner.show_description.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.main_collection_banner.show_image.label",
      "info": "t:sections.main_collection_banner.show_image.info",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 24
    }
  ]
}
{% endschema %}
