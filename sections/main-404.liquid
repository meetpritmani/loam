{%- comment -%}
  main-404.liquid — the page that recovers a lost session.

  §9.5 treats this as a conversion surface, not an error screen, and it is
  right to: a 404 is a visitor who wanted something on this store badly
  enough to follow a link to it. The three routes out are all here — search,
  the top collections, and home — and every one of them is above the fold on
  a phone.

  Blocks are collection tiles the merchant picks, so a 404 sends people to
  categories that actually have stock rather than to a generic index. With no
  blocks configured it falls back to the store's own collections, filtered to
  the non-empty ones (§9.5, "collections with zero products hidden").
{%- endcomment -%}

{%- liquid
  assign recovery = settings.cro_empty_cart_collection
  assign recovery_url = recovery.url | default: routes.all_products_collection_url

  assign has_blocks = false
  for block in section.blocks
    if block.settings.collection != blank
      assign has_blocks = true
      break
    endif
  endfor
-%}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="error-page">
      <div class="error-page__intro">
        <p class="caption">{{ '404.title' | t }}</p>
        <h1 class="h2">{{ section.settings.heading | escape }}</h1>
        <p class="text-muted">{{ section.settings.text | escape }}</p>

        {%- comment -%}
          The search box is the fastest route back to whatever they wanted,
          so it is the first thing under the heading rather than something
          they have to go back up to the header to find.
        {%- endcomment -%}
        <form class="error-page__search" action="{{ routes.search_url }}" method="get" role="search">
          <div class="field error-page__field">
            <label class="visually-hidden" for="error-search">{{ 'search.placeholder' | t }}</label>
            <input
              class="field__input"
              id="error-search"
              type="search"
              name="q"
              placeholder="{{ 'search.placeholder' | t }}"
              autocomplete="off"
            >
          </div>
          <button class="button button--primary" type="submit">{{ 'search.submit' | t }}</button>
        </form>

        <div class="cluster error-page__links">
          <a class="link-underline" href="{{ recovery_url }}">{{ 'cart.continue_shopping' | t }}</a>
          <a class="link-underline" href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
        </div>
      </div>

      {%- if has_blocks -%}
        <div class="error-page__collections">
          <h2 class="h6">{{ section.settings.collections_heading | escape }}</h2>
          <ul class="grid" style="--grid-cols: 4; --grid-cols-tablet: 3; --grid-cols-mobile: 2;">
            {%- for block in section.blocks -%}
              {%- if block.settings.collection != blank -%}
                <li {{ block.shopify_attributes }}>
                  {%- render 'card-collection',
                    collection: block.settings.collection,
                    ratio: 'square',
                    sizes: '(min-width: 990px) 22vw, (min-width: 750px) 30vw, 45vw'
                  -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- elsif collections.size > 0 -%}
        <div class="error-page__collections">
          <h2 class="h6">{{ section.settings.collections_heading | escape }}</h2>
          <ul class="grid" style="--grid-cols: 4; --grid-cols-tablet: 3; --grid-cols-mobile: 2;">
            {%- for collection in collections limit: 4 -%}
              {%- if collection.all_products_count > 0 -%}
                <li>
                  {%- render 'card-collection',
                    collection: collection,
                    ratio: 'square',
                    sizes: '(min-width: 990px) 22vw, (min-width: 750px) 30vw, 45vw'
                  -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "tag": "section",
  "class": "section-main-404",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "collection",
      "name": "t:general.collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:general.collection"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-paper"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "That page has moved on."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text",
      "default": "The link you followed does not lead anywhere any more. Search for what you were after, or pick up from one of these."
    },
    {
      "type": "text",
      "id": "collections_heading",
      "label": "t:sections.main_404.collections_heading.label",
      "default": "Start here"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 80
    }
  ]
}
{% endschema %}
