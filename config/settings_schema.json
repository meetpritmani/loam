      {
        "type": "select",
        "id": "animations_hover_effect",
        "label": "t:settings_schema.animations.settings.animations_hover_effect.label",
        "options": [
          {
            "value": "none",
            "label": "t:settings_schema.animations.settings.animations_hover_effect.options__1.label"
          },
          {
            "value": "zoom",
            "label": "t:settings_schema.animations.settings.animations_hover_effect.options__2.label"
          },
          {
            "value": "lift",
            "label": "t:settings_schema.animations.settings.animations_hover_effect.options__3.label"
          }
        ],
        "default": "zoom"
      }
    ]
  },
  {
