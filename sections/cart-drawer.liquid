{%- comment -%}
  cart-drawer.liquid — the cart, as a drawer.

  Rendered statically from theme.liquid on every page (not placed in a
  template), and only when the cart type setting is "drawer".

  Section Rendering API contract
  -----------------------------
  global.js asks Shopify to re-render every element carrying
  `data-cart-root` — this one and, on /cart, the cart page section — then
  swaps in the returned markup. Within each root it replaces the innerHTML
  of `[data-cart-body]` and `[data-cart-footer]`
  ONLY — never the <loam-drawer> element itself. Replacing the custom
  element while it is open would destroy the focus trap, the scroll lock,
  and the reference to whatever opened it, stranding the shopper in a
  drawer they cannot close with the keyboard.

  So: the two data-cart-* wrappers are the contract. Do not remove them, and
  do not move state onto the element that surrounds them.
{%- endcomment -%}

{%- liquid
  assign upsell_products = settings.cro_cart_upsell_products

  assign show_express = false
  if settings.cro_dynamic_checkout and additional_checkout_buttons and template.name != 'cart'
    assign show_express = true
  endif
-%}

<loam-drawer id="cart-drawer" data-cart-root="{{ section.id }}" data-cart-count="{{ cart.item_count }}">
  <div
    class="drawer"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cart-drawer-title"
  >
    <div class="drawer__overlay" data-drawer-close></div>

    <div class="drawer__panel color-{{ section.settings.color_scheme }}">
      <div class="drawer__header">
        <h2 class="h5" id="cart-drawer-title">
          {{ 'cart.title' | t }}
        </h2>
        <button
          class="icon-button"
          type="button"
          data-drawer-close
          aria-label="{{ 'accessibility.close_drawer' | t }}"
        >
          {%- render 'icon', icon: 'close' -%}
        </button>
      </div>

      <cart-items class="drawer__body" data-cart-body>
        {%- if cart.item_count == 0 -%}
          {%- liquid
            assign recovery = settings.cro_empty_cart_collection
            assign recovery_url = recovery.url | default: routes.all_products_collection_url
          -%}
          <div class="cart-drawer__empty stack">
            <p class="text-muted">{{ 'cart.empty' | t }}</p>
            <a class="button button--primary" href="{{ recovery_url }}">
              {{ 'cart.continue_shopping' | t }}
            </a>
          </div>
        {%- else -%}
          {%- render 'free-shipping-bar' -%}
          {%- render 'footprint-counter' -%}

          <ul class="cart-lines">
            {%- for item in cart.items -%}
              {%- render 'cart-line', item: item, context: 'drawer' -%}
            {%- endfor -%}
          </ul>

          {%- comment -%}
            Merchant-picked products only (§9.4). Nothing here comes from
            browsing behaviour or a random collection slice, and nothing is
            ever pre-ticked. Two up rather than the cart page's three — a
            drawer column is roughly half the width.

            It sits inside the scrolling body, below the lines, so it can
            never push the checkout button out of view.
          {%- endcomment -%}
          {%- if upsell_products.size > 0 -%}
            <div class="cart-drawer__upsell">
              <h3 class="h6">{{ 'cart.upsell_title' | t }}</h3>
              <ul class="grid" style="--grid-cols: 2; --grid-cols-tablet: 2; --grid-cols-mobile: 2;">
                {%- for product in upsell_products limit: 2 -%}
                  <li>
                    {%- render 'card-product',
                      product: product,
                      heading_tag: 'h4',
                      show_badges: false,
                      sizes: '160px'
                    -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endif -%}
      </cart-items>

      {%- comment -%}
        The wrapper is rendered unconditionally, empty cart or not. If it
        only existed when the cart had items, the first add-to-cart would
        have nothing to swap into and the totals would never appear until a
        full page load.
      {%- endcomment -%}
      <div class="drawer__footer" data-cart-footer>
        {%- if cart.item_count > 0 -%}
          {%- if settings.cart_show_note -%}
            <details class="cart-drawer__note">
              <summary class="button--tertiary">{{ 'cart.note' | t }}</summary>
              <label class="visually-hidden" for="cart-drawer-note">{{ 'cart.note' | t }}</label>
              <textarea
                class="field__textarea"
                id="cart-drawer-note"
                name="note"
                placeholder="{{ 'cart.note_placeholder' | t }}"
                data-cart-note
              >{{ cart.note }}</textarea>
            </details>
          {%- endif -%}

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="cart-drawer__discounts">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li class="cart-drawer__row text-body-sm">
                  <span class="badge">{{ discount.title | escape }}</span>
                  <span>−{{ discount.total_allocated_amount | money }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="cart-drawer__row cart-drawer__subtotal">
            <span class="h6">{{ 'cart.subtotal' | t }}</span>
            <span class="price">
              {%- if settings.show_currency_code -%}
                {{ cart.total_price | money_with_currency }}
              {%- else -%}
                {{ cart.total_price | money }}
              {%- endif -%}
            </span>
          </div>

          {%- if cart.taxes_included -%}
            <p class="field__hint">{{ 'cart.taxes_included_shipping_note' | t }}</p>
          {%- else -%}
            <p class="field__hint">{{ 'cart.taxes_and_shipping_note' | t }}</p>
          {%- endif -%}

          <form action="{{ routes.cart_url }}" method="post" novalidate>
            <button class="button button--primary button--full" type="submit" name="checkout">
              {{ 'cart.checkout' | t }}
            </button>

            {%- comment -%}
              §9.4 wants express checkout in the drawer, but
              `content_for_additional_checkout_buttons` may only be output
              once per page. On /cart the cart page section owns it, and the
              drawer is rendered there too — so the drawer stands down
              rather than emitting it twice, which breaks the buttons
              outright rather than merely duplicating them.

              The markup itself sits inside an inert <template>, not live in
              the DOM. Shopify's checkout SDK is discovered and fetched by a
              client-side scan for the rendered button, not by this tag
              being present in the Liquid source — so a shopper who already
              has items in cart but never opens this drawer never triggers
              that fetch. global.js clones the template's content into the
              slot the first time the drawer opens (and again after every
              cart update, since Cart.render() replaces this footer with a
              fresh, un-activated template each time).
            {%- endcomment -%}
            {%- if show_express -%}
              <div class="cart-drawer__express" data-express-checkout-slot>
                <template data-express-checkout-template>
                  {{ content_for_additional_checkout_buttons }}
                </template>
              </div>
            {%- endif -%}
          </form>

          <a class="button button--tertiary cart-drawer__view" href="{{ routes.cart_url }}">
            {{ 'cart.view_cart' | t }}
          </a>

          {%- comment -%}
            §9.2 rule 10: trust clustered at the friction point. The drawer
            is the default cart, so without this the returns window and the
            shipping promise never appear next to a checkout button on a
            default install.

            Payment marks are left to the cart page and the PDP: three rows
            of icons inside a drawer footer costs more height than it buys.
          {%- endcomment -%}
          {%- render 'trust-row', class: 'cart-drawer__trust', show_payment: false -%}
        {%- endif -%}

        {%- comment -%}
          App block support in the drawer is a Theme Store requirement (§10),
          and the drawer is the default cart — an app placed only on the cart
          page would never be seen on a default install.

          Last in the footer, below the trust row, so an app can never insert
          itself between the shopper and the checkout button. The CSS collapses
          the wrapper when the block renders nothing.
        {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'custom_liquid' -%}
              <div class="cart-drawer__app" {{ block.shopify_attributes }}>
                {{ block.settings.custom_liquid }}
              </div>
            {%- when '@app' -%}
              <div class="cart-drawer__app" {{ block.shopify_attributes }}>
                {%- render block -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</loam-drawer>

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "custom_liquid",
      "name": "t:sections.custom_liquid.name",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:sections.custom_liquid.custom_liquid.label",
          "info": "t:sections.custom_liquid.custom_liquid.info"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-surface"
    }
  ]
}
{% endschema %}
