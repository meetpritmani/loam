[
  {
    "name": "theme_info",
    "theme_name": "Loam",
    "theme_author": "Loam",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://example.com/loam/docs",
    "theme_support_url": "https://example.com/loam/support"
  },
  {
    "name": "t:settings.colors.name",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:settings.colors.background.label",
            "info": "t:settings.colors.background.info",
            "default": "#F5F4F0"
          },
          {
            "type": "color",
            "id": "surface",
            "label": "t:settings.colors.surface.label",
            "info": "t:settings.colors.surface.info",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:settings.colors.text.label",
            "info": "t:settings.colors.text.info",
            "default": "#101A16"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "t:settings.colors.accent.label",
            "info": "t:settings.colors.accent.info",
            "default": "#2E6B4F"
          },
          {
            "type": "color",
            "id": "sand",
            "label": "t:settings.colors.sand.label",
            "info": "t:settings.colors.sand.info",
            "default": "#E3DED1"
          },
          {
            "type": "color",
            "id": "signal",
            "label": "t:settings.colors.signal.label",
            "info": "t:settings.colors.signal.info",
            "default": "#B23A2F"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:settings.colors.button.label",
            "default": "#101A16"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:settings.colors.button_label.label",
            "default": "#F5F4F0"
          },
          {
            "type": "color",
            "id": "shadow",
            "label": "t:settings.colors.shadow.label",
            "default": "#101A16"
          }
        ],
        "role": {
          "background": "background",
          "text": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text",
          "links": "accent",
          "icons": "text"
        }
      }
    ]
  },
  {
    "name": "t:settings.typography.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings.typography.headings.content"
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "t:settings.typography.heading_font.label",
        "default": "archivo_n7"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "t:settings.typography.heading_scale.label",
        "info": "t:settings.typography.heading_scale.info",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "label": "t:settings.typography.heading_letter_spacing.label",
        "min": -4,
        "max": 6,
        "step": 1,
        "unit": "t:settings.typography.heading_letter_spacing.unit",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "heading_uppercase",
        "label": "t:settings.typography.heading_uppercase.label",
        "default": false
      },
      {
        "type": "header",
        "content": "t:settings.typography.body.content"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "t:settings.typography.body_font.label",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "t:settings.typography.body_scale.label",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "header",
        "content": "t:settings.typography.captions.content"
      },
      {
        "type": "range",
        "id": "caption_letter_spacing",
        "label": "t:settings.typography.caption_letter_spacing.label",
        "info": "t:settings.typography.caption_letter_spacing.info",
        "min": 0,
        "max": 6,
        "step": 1,
        "unit": "t:settings.typography.heading_letter_spacing.unit",
        "default": 1
      }
    ]
  },
  {
    "name": "t:settings.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "t:settings.layout.page_width.label",
        "min": 1200,
        "max": 1800,
        "step": 20,
        "unit": "t:settings.layout.page_width.unit",
        "default": 1440
      },
      {
        "type": "range",
        "id": "page_gutter",
        "label": "t:settings.layout.page_gutter.label",
        "info": "t:settings.layout.page_gutter.info",
        "min": 16,
        "max": 60,
        "step": 2,
        "unit": "t:settings.layout.page_width.unit",
        "default": 24
      },
      {
        "type": "range",
        "id": "grid_gap",
        "label": "t:settings.layout.grid_gap.label",
        "min": 8,
        "max": 48,
        "step": 2,
        "unit": "t:settings.layout.page_width.unit",
        "default": 24
      },
      {
        "type": "range",
        "id": "corner_radius",
        "label": "t:settings.layout.corner_radius.label",
        "info": "t:settings.layout.corner_radius.info",
        "min": 0,
        "max": 16,
        "step": 1,
        "unit": "t:settings.layout.page_width.unit",
        "default": 4
      },
      {
        "type": "checkbox",
        "id": "show_seam_dividers",
        "label": "t:settings.layout.show_seam_dividers.label",
        "info": "t:settings.layout.show_seam_dividers.info",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings.animations.name",
    "settings": [
      {
        "type": "checkbox",
