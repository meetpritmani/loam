{%- comment -%}
  footprint-counter.liquid — running total of custom.carbon_footprint across
  the cart's lines.

  Sums only the lines that actually carry the metafield — a real partial
  total, never a guessed figure for the rest of the cart (§16: no misleading
  data). Renders nothing at all when the setting is off, the cart is empty,
  or not one line has the metafield set: an empty wrapper here would reserve
  space for a number that was never coming.

  Reuses <count-up> (built for impact-stats) rather than a new element —
  the cart drawer swaps this markup in wholesale on every mutation, and
  <count-up> re-running its own connectedCallback on that swap is exactly
  what makes the total animate again each time an item is added or removed.

  Shared by the drawer and the cart page, like free-shipping-bar, so the two
  can never disagree about the total.

  Params: none — reads the global `cart` object directly.
{%- endcomment -%}

{%- liquid
  assign total = 0
  assign tracked_count = 0

  for item in cart.items
    assign footprint = item.product.metafields.custom.carbon_footprint
    if footprint != blank
      assign line_total = footprint | times: item.quantity
      assign total = total | plus: line_total
      assign tracked_count = tracked_count | plus: 1
    endif
  endfor

  assign render_counter = false
  if settings.cart_show_footprint and tracked_count > 0
    assign render_counter = true
  endif
-%}

{%- if render_counter -%}
  <div class="footprint-counter">
    {%- render 'icon', icon: 'leaf', size: 16 -%}
    <p class="footprint-counter__text">
      <span>{{ 'cart.footprint_label' | t }}</span>
      <count-up
        class="footprint-counter__value"
        data-count-to="{{ total }}"
        data-suffix="{{ 'cart.footprint_unit' | t | escape }}"
      >{{ total }}{{ 'cart.footprint_unit' | t }}</count-up>
    </p>
  </div>
{%- endif -%}
