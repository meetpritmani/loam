{%- comment -%}
  Renders a product card for grids (collection, search, recommendations).

  Accepts:
  - product: {Object} product. If blank, renders an onboarding placeholder so
    the Theme Editor never shows an empty grid cell.
  - lazy: {Boolean} false for the first row above the fold. Default true.
  - sizes: {String} sizes attribute for the card image.
  - show_vendor: {Boolean}

  Handles: no image, no price, sold out, subscription-only products, and
  products whose title is the only field present.
{%- endcomment -%}

{%- liquid
  assign card_loading = 'lazy'
  if lazy == false
    assign card_loading = 'eager'
  endif
  assign card_sizes = sizes | default: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign hover_class = ''
  if settings.animations_hover_effect == 'zoom'
    assign hover_class = ' rpl-card--zoom'
  elsif settings.animations_hover_effect == 'lift'
    assign hover_class = ' rpl-card--lift'
  endif
  assign boxed_class = ''
  if settings.card_style == 'card'
    assign boxed_class = ' rpl-card--boxed'
  endif
  assign card_alt = product.featured_media.alt | default: product.title
  assign subscription_label = settings.subscription_badge_text | default: 'Subscribe & save'
-%}

{%- if product == blank -%}
  <div class="rpl-card{{ boxed_class }}">
    <div class="rpl-media rpl-media--ratio">
      {{ 'product-1' | placeholder_svg_tag: 'rpl-media__placeholder' }}
    </div>
    <h3 class="rpl-card__title">{{ 'onboarding.product_title' | t }}</h3>
    <div class="rpl-price">
      <span class="rpl-price__current">{{ 1999 | money }}</span>
    </div>
  </div>
{%- else -%}
  <div class="rpl-card{{ boxed_class }}{{ hover_class }}">
    {% render 'responsive-image',
      image: product.featured_media.preview_image,
      alt: card_alt,
      loading: card_loading,
      sizes: card_sizes,
      widths: '165, 330, 360, 533, 720, 940',
      wrapper_ratio: settings.card_image_ratio,
      placeholder: 'product-1'
    %}

    <div class="rpl-card__content">
      {%- if show_vendor and product.vendor != blank -%}
        <p class="rpl-caption rpl-muted rpl-card__vendor">
          <span class="rpl-visually-hidden">{{ 'products.product.vendor' | t }}</span>
          {{ product.vendor | escape }}
        </p>
      {%- endif -%}

      <h3 class="rpl-card__title">
        <a class="rpl-card__link" href="{{ product.url }}">{{ product.title | escape }}</a>
      </h3>

      {% render 'price', product: product, show_badges: true %}

      {%- if settings.show_selling_plan_savings and product.selling_plan_groups.size > 0 -%}
        <p class="rpl-badge rpl-badge--subtle rpl-card__subscription">
          {% render 'icon', icon: 'refresh' %}
          {{ subscription_label | escape }}
        </p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
