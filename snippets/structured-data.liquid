{%- comment -%}
  structured-data.liquid — JSON-LD for rich results (build spec §7).

  Emitted on every page:
    Organization  — name, url, logo, sameAs, contactPoint
    WebSite       — with a SearchAction pointing at the search route

  Per template:
    product     Product + one Offer per variant, plus BreadcrumbList
    collection  CollectionPage + ItemList (first 12) + BreadcrumbList
    article     BlogPosting

  AggregateRating and Review are emitted ONLY when real review metafields
  carry a non-zero count. Never synthesise them: marking up ratings a store
  does not have is a Google manual-action risk that lands on the buyer, not
  on us. The FAQPage graph is generated by the faq section from its own
  blocks, not here.

  Every interpolated value goes through `| json`, which both quotes and
  escapes it — no bare {{ }} inside these script tags.

  Params: none. Rendered from the <head> of theme.liquid.
{%- endcomment -%}

{%- liquid
  assign social_raw = ''
  assign social_raw = social_raw | append: settings.social_instagram_link | append: '|'
  assign social_raw = social_raw | append: settings.social_facebook_link | append: '|'
  assign social_raw = social_raw | append: settings.social_youtube_link | append: '|'
  assign social_raw = social_raw | append: settings.social_tiktok_link | append: '|'
  assign social_raw = social_raw | append: settings.social_pinterest_link | append: '|'
  assign social_raw = social_raw | append: settings.social_x_link | append: '|'
  assign social_raw = social_raw | append: settings.social_linkedin_link
  assign social_list = social_raw | split: '|'

  comment
    The SearchAction urlTemplate has to contain the literal token
    {search_term_string}. Built here, inside a tag, rather than inline in an
    output tag: Liquid's variable lexer scans a {{ ... }} for its closing
    braces and chokes on a brace-wrapped token in a string literal, which is
    a compile error the local theme-check does not catch.
  endcomment
  assign search_term_token = '{search_term_string}'
  assign search_url_template = shop.url | append: routes.search_url | append: '?q=' | append: search_term_token
-%}

{%- capture same_as -%}
  {%- assign is_first = true -%}
  {%- for social_url in social_list -%}
    {%- if social_url != blank -%}
      {%- unless is_first -%},{%- endunless -%}
      {{- social_url | json -}}
      {%- assign is_first = false -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": {{ shop.url | append: '#organization' | json }},
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }}
        {%- if settings.brand_description != blank -%}
          , "description": {{ settings.brand_description | strip_html | json }}
        {%- endif -%}
        {%- if settings.logo -%}
          , "logo": {
            "@type": "ImageObject",
            "url": {{ settings.logo | image_url: width: 512 | prepend: 'https:' | json }},
            "width": 512,
            "height": {{ 512 | divided_by: settings.logo.aspect_ratio | round | json }}
          }
        {%- endif -%}
        {%- if same_as != blank -%}
          , "sameAs": [{{ same_as | strip }}]
        {%- endif -%}
        {%- if shop.address.phone != blank -%}
          , "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "customer service",
            "telephone": {{ shop.address.phone | json }}
          }
        {%- endif -%}
      },
      {
        "@type": "WebSite",
        "@id": {{ shop.url | append: '#website' | json }},
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }},
        "publisher": { "@id": {{ shop.url | append: '#organization' | json }} },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": {{ search_url_template | json }}
          },
          "query-input": "required name=search_term_string"
        }
      }
    ]
  }
</script>

{%- if request.page_type == 'product' and product != blank -%}
  {%- liquid
    assign product_url = shop.url | append: product.url
    assign rating = product.metafields.reviews.rating.value
    assign rating_count = product.metafields.reviews.rating_count.value | plus: 0
    assign has_reviews = false
    if rating != blank and rating_count > 0
      assign has_reviews = true
    endif
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ product_url | json }},
      "description": {{ product.description | strip_html | truncate: 500 | json }},
      {%- comment -%}
        Omit sku entirely when the variant has none. `| json` on a nil renders
        a literal null, and a null sku is a property Google flags rather than
        ignores.
      {%- endcomment -%}
      {%- if product.selected_or_first_available_variant.sku != blank -%}
        "sku": {{ product.selected_or_first_available_variant.sku | json }},
      {%- endif -%}
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | default: shop.name | json }}
      }
      {%- if product.featured_media -%}
        , "image": [
          {%- for media in product.media limit: 5 -%}
            {%- if media.media_type == 'image' -%}
              {{ media | image_url: width: 1200 | prepend: 'https:' | json }}
              {%- unless forloop.last -%},{%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      {%- endif -%}
      {%- if has_reviews -%}
        , "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": {{ rating.rating | json }},
          "bestRating": {{ rating.scale_max | json }},
          "worstRating": {{ rating.scale_min | json }},
          "ratingCount": {{ rating_count | json }}
        }
      {%- endif -%}
      , "offers": [
        {%- for variant in product.variants -%}
          {
            "@type": "Offer",
            "@id": {{ product_url | append: '?variant=' | append: variant.id | json }},
            "url": {{ product_url | append: '?variant=' | append: variant.id | json }},
            "name": {{ variant.title | json }},
            {%- if variant.sku != blank -%}
              "sku": {{ variant.sku | json }},
            {%- endif -%}
            {%- if variant.barcode != blank -%}
              "gtin": {{ variant.barcode | json }},
            {%- endif -%}
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "itemCondition": "https://schema.org/NewCondition",
            "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'general.breadcrumb.home' | t | json }},
          "item": {{ shop.url | json }}
        }
        {%- if collection != blank -%}
          , {
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ shop.url | append: collection.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": {{ product_url | json }}
          }
        {%- else -%}
          , {
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.title | json }},
            "item": {{ product_url | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'collection' and collection != blank -%}
  {%- assign collection_url = shop.url | append: collection.url -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ collection.title | json }},
      "url": {{ collection_url | json }},
      {%- if collection.description != blank -%}
        "description": {{ collection.description | strip_html | truncate: 500 | json }},
      {%- endif -%}
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count | json }},
        "itemListElement": [
          {%- for item in collection.products limit: 12 -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index | json }},
              "url": {{ shop.url | append: item.url | json }},
              "name": {{ item.title | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'general.breadcrumb.home' | t | json }},
          "item": {{ shop.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ collection_url | json }}
        }
      ]
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'article' and article != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ article.title | strip_html | truncate: 110 | json }},
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": {{ shop.url | append: article.url | json }}
      },
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      {%- if article.excerpt_or_content != blank -%}
        "description": {{ article.excerpt_or_content | strip_html | truncate: 300 | json }},
      {%- endif -%}
      {%- if article.image -%}
        "image": [{{ article.image | image_url: width: 1600 | prepend: 'https:' | json }}],
      {%- endif -%}
      "author": {
        "@type": "Person",
        "name": {{ article.author | default: shop.name | json }}
      },
      "publisher": { "@id": {{ shop.url | append: '#organization' | json }} }
    }
  </script>
{%- endif -%}
