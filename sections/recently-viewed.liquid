{%- comment -%}
  Recently viewed products, tracked client-side via localStorage (the
  server has no idea what a visitor looked at, so this can't be rendered
  server-side on first load). rpl-recently-viewed.js records each product
  view, then — wherever this section is placed — reads that list and
  fetches each product's card individually through
  sections/product-card-fetch.liquid's stable Section Rendering endpoint,
  one request per handle.

  Handles: nothing viewed yet (stays `hidden`, or — if hide_if_empty is
  off — reveals with an empty grid; no flash either way, JS decides after
  reading localStorage), the current product excluded from its own
  "recently viewed" list, a previously-viewed product later unpublished
  (that fetch just returns nothing and is skipped), entries older than 30
  days (filtered out on read).
{%- endcomment -%}

<script src="{{ 'rpl-recently-viewed.js' | asset_url }}" defer="defer"></script>

{% style %}
  #shopify-section-{{ section.id }} .rpl-product-grid {
    --rpl-grid-columns-mobile: 2;
    --rpl-grid-columns-desktop: {{ section.settings.product_count | at_most: 5 }};
  }
{% endstyle %}

<div
  class="rpl-color-{{ section.settings.color_scheme }}"
  data-recently-viewed
  data-count="{{ section.settings.product_count }}"
  data-hide-if-empty="{{ section.settings.hide_if_empty }}"
  hidden
>
  <div class="rpl-container rpl-section">
    {%- if section.settings.heading != blank -%}
      <h2 class="rpl-recently-viewed__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="rpl-grid rpl-product-grid rpl-list-unstyled" data-recently-viewed-grid></ul>
  </div>
</div>

{% stylesheet %}
  .rpl-recently-viewed__heading {
    margin-block-end: var(--rpl-space-md);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.recently_viewed.name",
  "tag": "section",
  "class": "rpl-section-recently-viewed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "Recently viewed"
    },
    {
      "type": "range",
      "id": "product_count",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "t:sections.recently_viewed.settings.product_count.label",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "hide_if_empty",
      "label": "t:sections.recently_viewed.settings.hide_if_empty.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.recently_viewed.name"
    }
  ]
}
{% endschema %}
