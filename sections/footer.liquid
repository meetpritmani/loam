{%- comment -%}
  footer.liquid — menu blocks, newsletter capture, social links, payment
  icons, and the localization selectors.

  Column count is driven by the number of blocks rather than a setting, so a
  merchant who deletes a menu never ends up with an empty column. The bottom
  bar is always present: it carries the copyright, which is not optional.
{%- endcomment -%}

{%- liquid
  assign has_social = false
  if section.settings.show_social
    if settings.social_instagram_link != blank
      assign has_social = true
    elsif settings.social_facebook_link != blank
      assign has_social = true
    elsif settings.social_youtube_link != blank
      assign has_social = true
    elsif settings.social_tiktok_link != blank
      assign has_social = true
    elsif settings.social_pinterest_link != blank
      assign has_social = true
    elsif settings.social_x_link != blank
      assign has_social = true
    elsif settings.social_linkedin_link != blank
      assign has_social = true
    endif
  endif
-%}

{%- if settings.show_seam_dividers -%}
  <hr class="seam seam--inset">
{%- endif -%}

<footer
  class="section footer color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-block-start: {{ section.settings.padding_top | times: 0.6 | round }}px;
    --section-padding-block-end: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    --section-padding-block-start-desktop: {{ section.settings.padding_top }}px;
    --section-padding-block-end-desktop: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__columns">
        {%- for block in section.blocks -%}
          <div class="footer__column footer__column--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading caption">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="footer__links">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a class="link text-body-sm" href="{{ link.url }}">{{ link.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading caption">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte text-body-sm">{{ block.settings.text }}</div>
                {%- endif -%}

              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading caption">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="text-body-sm text-muted">{{ block.settings.text | escape }}</p>
                {%- endif -%}

                {%- assign footer_newsletter_id = 'footer-' | append: block.id -%}
                {%- render 'newsletter-form',
                  id: footer_newsletter_id,
                  class: 'footer__newsletter',
                  fine_print: block.settings.fine_print
                -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      <div class="footer__bottom-start">
        <p class="footer__copyright caption">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}
          {%- if section.settings.copyright_extra != blank %} — {{ section.settings.copyright_extra | escape }}{% endif -%}
        </p>

        {%- comment -%}
          §9.4: footer carries a returns-window line. Deliberately not a
          render of trust-row.liquid here — that snippet supplies its own
          border-block + padding-block for its usual job (a standalone strip
          next to Add to Cart), which duplicates `.footer__bottom`'s own
          border-block-start and re-stacks a double gap. This is one more
          flex child in the bottom-start row the copyright already lives in,
          same caption typography, so it reads as part of that row rather
          than a strip glued on top of it.
        {%- endcomment -%}
        {%- if settings.cro_trust_returns != blank -%}
          <p class="footer__returns caption">
            {%- render 'icon', icon: 'return', size: 14 -%}
            <span>{{ settings.cro_trust_returns | escape }}</span>
          </p>
        {%- endif -%}

        {%- render 'localization-form',
          show_country: section.settings.show_country,
          show_language: section.settings.show_language,
          id_prefix: 'footer'
        -%}
      </div>

      <div class="footer__bottom-end">
        {%- if has_social -%}
          <ul class="footer__social cluster" aria-label="{{ 'footer.follow_us' | t }}">
            {%- if settings.social_instagram_link != blank -%}
              <li>
                <a class="icon-button" href="{{ settings.social_instagram_link }}" aria-label="Instagram">
                  {%- render 'icon', icon: 'instagram', size: 18 -%}
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
              <li>
                <a class="icon-button" href="{{ settings.social_facebook_link }}" aria-label="Facebook">
                  {%- render 'icon', icon: 'facebook', size: 18 -%}
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
              <li>
                <a class="icon-button" href="{{ settings.social_youtube_link }}" aria-label="YouTube">
                  {%- render 'icon', icon: 'youtube', size: 18 -%}
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
              <li>
                <a class="icon-button" href="{{ settings.social_tiktok_link }}" aria-label="TikTok">
                  {%- render 'icon', icon: 'tiktok', size: 18 -%}
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}
              <li>
                <a class="icon-button" href="{{ settings.social_pinterest_link }}" aria-label="Pinterest">
                  {%- render 'icon', icon: 'pinterest', size: 18 -%}
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_x_link != blank -%}
              <li>
                <a class="icon-button" href="{{ settings.social_x_link }}" aria-label="X">
                  {%- render 'icon', icon: 'x', size: 18 -%}
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_linkedin_link != blank -%}
              <li>
                <a class="icon-button" href="{{ settings.social_linkedin_link }}" aria-label="LinkedIn">
                  {%- render 'icon', icon: 'linkedin', size: 18 -%}
                </a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- comment -%}
          Theme Store requirement: a Follow on Shop entry point, via
          Shopify's own filter rather than a themed button — same reasoning
          as <shopify-account> above, the branded control is not ours to
          reskin. Independent of has_social: the merchant's own social
          links can be empty and this still has something real to do.

          Captured rather than printed directly: the filter renders an
          empty string on any store where Shop following is not currently
          eligible (this dev store included), and an empty wrapper div is
          exactly the DOM litter §6's "no bare fallback" reasoning already
          argues against elsewhere in the theme.
        {%- endcomment -%}
        {%- capture shop_follow_button -%}
          {%- if shop.customer_accounts_enabled -%}
            {{ shop | login_button: action: 'follow' }}
          {%- endif -%}
        {%- endcapture -%}
        {%- if shop_follow_button != blank -%}
          <div class="footer__shop-follow">{{ shop_follow_button }}</div>
        {%- endif -%}

        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <ul class="footer__payment" aria-label="{{ 'footer.payment_methods' | t }}">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-paper"
    },
    {
      "type": "header",
      "content": "t:sections.footer.bottom_bar.content"
    },
    {
      "type": "text",
      "id": "copyright_extra",
      "label": "t:sections.footer.copyright_extra.label",
      "info": "t:sections.footer.copyright_extra.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:sections.footer.show_social.label",
      "info": "t:sections.footer.show_social.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country",
      "label": "t:sections.announcement_bar.show_country.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "t:sections.announcement_bar.show_language.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "t:settings.layout.page_width.unit",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.footer_menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:labels.text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Fernway"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Shoes made from merino wool, eucalyptus fibre, and sugarcane foam. Built to be worn out, then recycled.</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Get first access."
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "New colourways, restocks, and the occasional field note. Two emails a month, no more."
        },
        {
          "type": "text",
          "id": "fine_print",
          "label": "t:sections.footer.blocks.newsletter.fine_print.label",
          "default": "Unsubscribe any time."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.footer.name",
      "blocks": [
        { "type": "text" },
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Help" } },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
