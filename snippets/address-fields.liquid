{%- comment -%}
  Renders the field set shared by the "add address" and "edit address" forms.

  Accepts:
  - address: {Object} the address being edited (customer.new_address for a new one).
  - id_prefix: {String} unique prefix so every label/input pair has a unique id
    when several address forms are on the page at once.

  The country <select> carries the saved country in `data-default-country`;
  rpl-customer.js applies it, because Liquid's country_option_tags can only
  pre-select the shop's own country.
{%- endcomment -%}

{%- liquid
  assign prefix = id_prefix | default: 'Address'
-%}

<div class="rpl-address-fields">
  <div class="rpl-field">
    <label class="rpl-field__label" for="{{ prefix }}FirstName">{{ 'customer.addresses.first_name' | t }}</label>
    <input
      class="rpl-input"
      type="text"
      id="{{ prefix }}FirstName"
      name="address[first_name]"
      value="{{ address.first_name }}"
      autocomplete="given-name"
    >
  </div>

  <div class="rpl-field">
    <label class="rpl-field__label" for="{{ prefix }}LastName">{{ 'customer.addresses.last_name' | t }}</label>
    <input
      class="rpl-input"
      type="text"
      id="{{ prefix }}LastName"
      name="address[last_name]"
      value="{{ address.last_name }}"
      autocomplete="family-name"
    >
  </div>

  <div class="rpl-field rpl-address-fields__full">
    <label class="rpl-field__label" for="{{ prefix }}Company">{{ 'customer.addresses.company' | t }}</label>
    <input
      class="rpl-input"
      type="text"
      id="{{ prefix }}Company"
      name="address[company]"
      value="{{ address.company }}"
      autocomplete="organization"
    >
  </div>

  <div class="rpl-field rpl-address-fields__full">
    <label class="rpl-field__label" for="{{ prefix }}Address1">{{ 'customer.addresses.address1' | t }}</label>
    <input
      class="rpl-input"
      type="text"
      id="{{ prefix }}Address1"
      name="address[address1]"
      value="{{ address.address1 }}"
      autocomplete="address-line1"
    >
  </div>

  <div class="rpl-field rpl-address-fields__full">
    <label class="rpl-field__label" for="{{ prefix }}Address2">{{ 'customer.addresses.address2' | t }}</label>
    <input
      class="rpl-input"
      type="text"
      id="{{ prefix }}Address2"
      name="address[address2]"
      value="{{ address.address2 }}"
      autocomplete="address-line2"
    >
  </div>

  <div class="rpl-field">
    <label class="rpl-field__label" for="{{ prefix }}City">{{ 'customer.addresses.city' | t }}</label>
    <input
      class="rpl-input"
      type="text"
      id="{{ prefix }}City"
      name="address[city]"
      value="{{ address.city }}"
      autocomplete="address-level2"
    >
  </div>

  <div class="rpl-field">
    <label class="rpl-field__label" for="{{ prefix }}Zip">{{ 'customer.addresses.zip' | t }}</label>
    <input
      class="rpl-input"
      type="text"
      id="{{ prefix }}Zip"
      name="address[zip]"
      value="{{ address.zip }}"
      autocomplete="postal-code"
    >
  </div>

  <div class="rpl-field">
    <label class="rpl-field__label" for="{{ prefix }}Country">{{ 'customer.addresses.country' | t }}</label>
    <select
      class="rpl-select"
      id="{{ prefix }}Country"
      name="address[country]"
      autocomplete="country"
      data-address-country
      data-default-country="{{ address.country | escape }}"
    >
      {{ country_option_tags }}
    </select>
  </div>

  <div class="rpl-field" data-address-province-wrapper>
    <label class="rpl-field__label" for="{{ prefix }}Province">{{ 'customer.addresses.province' | t }}</label>
    <input
      class="rpl-input"
      type="text"
      id="{{ prefix }}Province"
      name="address[province]"
      value="{{ address.province }}"
      autocomplete="address-level1"
      data-address-province
    >
  </div>

  <div class="rpl-field">
    <label class="rpl-field__label" for="{{ prefix }}Phone">{{ 'customer.addresses.phone' | t }}</label>
    <input
      class="rpl-input"
      type="tel"
      id="{{ prefix }}Phone"
      name="address[phone]"
      value="{{ address.phone }}"
      autocomplete="tel"
    >
  </div>

  <div class="rpl-field rpl-address-fields__full">
    <label class="rpl-address-fields__default" for="{{ prefix }}SetDefault">
      <input
        type="checkbox"
        id="{{ prefix }}SetDefault"
        name="address[default]"
        value="1"
        {% if address.id == customer.default_address.id %}
          checked
        {% endif %}
      >
      <span>{{ 'customer.addresses.set_default' | t }}</span>
    </label>
  </div>
</div>
