      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "t:settings_schema.cart.settings.show_vendor.label",
        "default": false
      }
    ]
  },
  {
    "name": "t:settings_schema.subscriptions.name",
    "settings": [
