{%- comment -%}
  icon.liquid — every SVG in the theme comes from here. No section inlines
  its own SVG, so the icon set stays consistent and a stroke-weight change
  is a one-line edit.

  All icons are drawn on a 24x24 grid as 1.5px strokes (the weight is set in
  base.css, not per-path, so `.icon--sm` and `.icon--lg` stay optically
  even). `star` and `star-half` are the only filled icons.

  Every icon is decorative: aria-hidden and focusable="false". If an icon is
  the only content of a control, the control carries the aria-label.

  Params:
    icon    (string, required) — icon name, see the `case` below
    class   (string, optional) — extra classes on the <svg>
    size    (number, optional) — px override for --icon-size

  Usage:
    {% render 'icon', icon: 'cart' %}
    {% render 'icon', icon: 'chevron-down', class: 'accordion__icon' %}
    {% render 'icon', icon: 'star', size: 14 %}
{%- endcomment -%}

{%- liquid
  assign classes = 'icon'
  if icon == 'star' or icon == 'star-half'
    assign classes = classes | append: ' icon--filled'
  endif
  if class != blank
    assign classes = classes | append: ' ' | append: class
  endif
-%}

<svg
  class="{{ classes }}"
  {% if size %}style="--icon-size: {{ size }}px;"{% endif %}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  role="presentation"
>
  {%- case icon -%}
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/>
      <path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/>
    {%- when 'arrow-left' -%}
      <path d="M19 12H5"/>
      <path d="M11 6 5 12l6 6"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14"/>
      <path d="m13 6 6 6-6 6"/>
    {%- when 'cart' -%}
      <path d="M6 8h12l-1 12H7L6 8Z"/>
      <path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'check' -%}
      <path d="m5 13 4.5 4.5L19 7"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/>
      <path d="M12 7.5V12l3 2"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-left' -%}
      <path d="m15 6-6 6 6 6"/>
    {%- when 'chevron-right' -%}
      <path d="m9 6 6 6-6 6"/>
    {%- when 'chevron-up' -%}
      <path d="m6 15 6-6 6 6"/>
    {%- when 'close' -%}
      <path d="m6 6 12 12"/>
      <path d="m18 6-12 12"/>
    {%- when 'droplet' -%}
      <path d="M12 3.5c3 3.7 5.5 6.6 5.5 9.6a5.5 5.5 0 0 1-11 0c0-3 2.5-5.9 5.5-9.6Z"/>
    {%- when 'email' -%}
      <rect x="3" y="5" width="18" height="14" rx="1.5"/>
      <path d="m3.5 6.5 8.5 6 8.5-6"/>
    {%- when 'external' -%}
      <path d="M14 4h6v6"/>
      <path d="M20 4 11 13"/>
      <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
    {%- when 'filter' -%}
      <path d="M4 7h16"/>
      <path d="M7 12h10"/>
      <path d="M10 17h4"/>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="8.5"/>
      <path d="M3.5 12h17"/>
      <path d="M12 3.5c2.2 2.4 3.4 5.4 3.4 8.5s-1.2 6.1-3.4 8.5c-2.2-2.4-3.4-5.4-3.4-8.5S9.8 5.9 12 3.5Z"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.4-7.5-9.2A4.3 4.3 0 0 1 12 8a4.3 4.3 0 0 1 7.5 2.8C19.5 15.6 12 20 12 20Z"/>
    {%- when 'leaf' -%}
      <path d="M20 4c0 8-4.7 12-10 12a5 5 0 0 1 0-10c4 0 6-1 10-2Z"/>
      <path d="M12.5 11.5 5 20"/>
    {%- when 'menu' -%}
      <path d="M4 7h16"/>
      <path d="M4 12h16"/>
      <path d="M4 17h16"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'pause' -%}
      <path d="M9 5v14"/>
      <path d="M15 5v14"/>
    {%- when 'phone' -%}
      <path d="M7.5 3.5h-2A2 2 0 0 0 3.5 5.7c.4 4.1 2.2 7.9 5 10.8 2.9 2.8 6.7 4.6 10.8 5a2 2 0 0 0 2.2-2v-2a1.5 1.5 0 0 0-1.3-1.5l-2.6-.4a1.5 1.5 0 0 0-1.5.7l-.8 1.3a13 13 0 0 1-5.9-5.9l1.3-.8a1.5 1.5 0 0 0 .7-1.5l-.4-2.6a1.5 1.5 0 0 0-1.5-1.3Z"/>
    {%- when 'play' -%}
      <path d="M8 5.5 19 12 8 18.5V5.5Z"/>
    {%- when 'plus' -%}
      <path d="M12 5v14"/>
      <path d="M5 12h14"/>
    {%- when 'quote' -%}
      <path d="M10 6c-3 1.4-4.5 3.8-4.5 7.2V18H10v-5.5H7.2c0-2 .9-3.5 2.8-4.4Z"/>
      <path d="M19 6c-3 1.4-4.5 3.8-4.5 7.2V18H19v-5.5h-2.8c0-2 .9-3.5 2.8-4.4Z"/>
    {%- when 'recycle' -%}
      <path d="m7.5 9-2.7 4.6a1.5 1.5 0 0 0 1.3 2.3h3"/>
      <path d="M13.2 5.4 16 10"/>
      <path d="M9.6 5.9a1.5 1.5 0 0 1 2.6 0"/>
      <path d="M18 10.5 20.2 14a1.5 1.5 0 0 1-1.3 2.3h-9"/>
      <path d="m11.5 14-2 2.3 2 2.2"/>
      <path d="M8 9 5.6 7.6"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/>
      <path d="m16 16 4 4"/>
    {%- when 'shield' -%}
      <path d="M12 3.5 19 6v6c0 4-3 7-7 8.5C8 19 5 16 5 12V6l7-2.5Z"/>
      <path d="m9 12 2 2 4-4"/>
    {%- when 'star' -%}
      <path d="m12 3.8 2.6 5.2 5.8.8-4.2 4.1 1 5.7-5.2-2.7-5.2 2.7 1-5.7-4.2-4.1 5.8-.8L12 3.8Z"/>
    {%- when 'star-half' -%}
      <path d="m12 3.8 2.6 5.2 5.8.8-4.2 4.1 1 5.7-5.2-2.7V3.8Z"/>
    {%- when 'alert' -%}
      <path d="M12 4.5 2.5 20h19L12 4.5Z"/>
      <path d="M12 10v4"/>
      <path d="M12 17.2v.1"/>

    {%- when 'return' -%}
      <path d="M9 5 4.5 9.5 9 14"/>
      <path d="M4.5 9.5H15a4.5 4.5 0 0 1 0 9h-4"/>

    {%- when 'truck' -%}
      <path d="M3 7h11v9H3V7Z"/>
      <path d="M14 10h3.5l2.5 3v3H14v-6Z"/>
      <circle cx="7" cy="18" r="1.8"/>
      <circle cx="17" cy="18" r="1.8"/>
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="4"/>
      <path d="M12 2.5v2"/>
      <path d="M12 19.5v2"/>
      <path d="M2.5 12h2"/>
      <path d="M19.5 12h2"/>
      <path d="m5.3 5.3 1.4 1.4"/>
      <path d="m17.3 17.3 1.4 1.4"/>
      <path d="m18.7 5.3-1.4 1.4"/>
      <path d="m6.7 17.3-1.4 1.4"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8.5"/>
  {%- endcase -%}
</svg>
