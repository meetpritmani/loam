{%- comment -%}
  meta-tags.liquid — title, canonical, description, Open Graph, Twitter card
  and pagination hints (build spec §7).

  JSON-LD is deliberately NOT here — it has a different consumer (search
  engines vs. social unfurls) and lives in structured-data.liquid.

  On rel="prev" / rel="next": only `prev` is emitted. A layout has no access
  to the `paginate` object, so the total page count is unknowable here —
  `prev` is always provable from `current_page`, `next` is not, and pointing
  `next` at a page that 404s is worse for crawlers than omitting it. Shopify's
  own `canonical_url` already resolves paginated URLs correctly.

  Params: none. Rendered from the <head> of every layout.
{%- endcomment -%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_description = page_description | default: shop.description | default: settings.brand_description | default: shop.name
  assign og_image = page_image | default: settings.share_image

  case request.page_type
    when 'product'
      assign og_type = 'product'
    when 'article'
      assign og_type = 'article'
    when 'blog'
      assign og_type = 'blog'
    when 'password'
      assign og_type = 'website'
      assign og_url = request.origin
    else
      assign og_type = 'website'
  endcase

  assign current_tags_joined = current_tags | join: ', '
-%}

<title>
  {{- page_title -}}
  {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags_joined }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link rel="canonical" href="{{ canonical_url }}">

{%- if current_page > 1 -%}
  {%- liquid
    assign prev_page = current_page | minus: 1
    assign prev_url = request.path | append: '?page=' | append: prev_page
    if prev_page == 1
      assign prev_url = request.path
    endif
  -%}
  <link rel="prev" href="{{ prev_url }}">
{%- endif -%}

{%- comment -%}
  Same fallback chain as `og_description` (line 20), not just the bare
  per-page value. A page with no description of its own — the homepage,
  chiefly — still has `shop.description` or `settings.brand_description`
  to fall back to, and there is no reason the social-share description
  gets that fallback while the actual SEO meta description does not.
{%- endcomment -%}
<meta name="description" content="{{ og_description | escape }}">

{%- for scheme in settings.color_schemes limit: 1 -%}
  <meta name="theme-color" content="{{ scheme.settings.background }}">
{%- endfor -%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code }}">

{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
  {%- if og_image.alt != blank -%}
    <meta property="og:image:alt" content="{{ og_image.alt | escape }}">
  {%- endif -%}
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
{%- endif -%}

{%- if request.page_type == 'article' -%}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  {%- if article.author != blank -%}
    <meta property="article:author" content="{{ article.author | escape }}">
  {%- endif -%}
{%- endif -%}

<meta name="twitter:card" content="{% if og_image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_image -%}
  <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif -%}
