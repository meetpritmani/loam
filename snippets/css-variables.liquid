{%- comment -%}
  Renders the merchant-configurable half of the design-token layer.

  Everything here depends on theme settings, so it cannot live in a static
  stylesheet. It is inlined in the document head (before critical-css) so the
  first paint already has the correct palette and type — no flash, no CLS.

  Static tokens and critical rules live in snippets/critical-css.liquid.
{%- endcomment -%}

{%- liquid
  assign body_font = settings.type_body_font
  assign body_font_bold = body_font | font_modify: 'weight', 'bolder'
  assign body_font_italic = body_font | font_modify: 'style', 'italic'
  assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
  assign heading_font = settings.type_heading_font
  assign heading_font_bold = heading_font | font_modify: 'weight', 'bolder'
-%}

<style data-rpl-variables>
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}
  {{ body_font_italic | font_face: font_display: 'swap' }}
  {{ body_font_bold_italic | font_face: font_display: 'swap' }}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ heading_font_bold | font_face: font_display: 'swap' }}

  {%- for scheme in settings.color_schemes -%}
    {%- if forloop.first -%}:root,{%- endif -%}
    .rpl-color-{{ scheme.id }} {
      --rpl-color-background: {{ scheme.settings.background.red }} {{ scheme.settings.background.green }} {{ scheme.settings.background.blue }};
      {% if scheme.settings.background_gradient != blank %}
        --rpl-gradient-background: {{ scheme.settings.background_gradient }};
      {% else %}
        --rpl-gradient-background: {{ scheme.settings.background }};
      {% endif %}
      --rpl-color-foreground: {{ scheme.settings.text.red }} {{ scheme.settings.text.green }} {{ scheme.settings.text.blue }};
      --rpl-color-button: {{ scheme.settings.button.red }} {{ scheme.settings.button.green }} {{ scheme.settings.button.blue }};
      --rpl-color-button-text: {{ scheme.settings.button_label.red }} {{ scheme.settings.button_label.green }} {{ scheme.settings.button_label.blue }};
      --rpl-color-secondary-button-text: {{ scheme.settings.secondary_button_label.red }} {{ scheme.settings.secondary_button_label.green }} {{ scheme.settings.secondary_button_label.blue }};
      --rpl-color-shadow: {{ scheme.settings.shadow.red }} {{ scheme.settings.shadow.green }} {{ scheme.settings.shadow.blue }};

      color: rgb(var(--rpl-color-foreground));
      background-color: rgb(var(--rpl-color-background));
    }
  {%- endfor -%}

  body,
  .rpl-color-scheme {
    background: var(--rpl-gradient-background);
  }

  :root {
    --rpl-font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --rpl-font-body-style: {{ body_font.style }};
    --rpl-font-body-weight: {{ body_font.weight }};
    --rpl-font-body-weight-bold: {{ body_font.weight | plus: 300 | at_most: 1000 }};
    --rpl-font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};

    --rpl-font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --rpl-font-heading-style: {{ heading_font.style }};
    --rpl-font-heading-weight: {{ heading_font.weight }};
    --rpl-font-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --rpl-font-heading-transform: {{ settings.heading_transform }};

    --rpl-page-width: {{ settings.page_width }}px;
    --rpl-spacing-sections: {{ settings.spacing_sections }}px;
    --rpl-grid-gap-horizontal: {{ settings.spacing_grid_horizontal }}px;
    --rpl-grid-gap-vertical: {{ settings.spacing_grid_vertical }}px;

    --rpl-buttons-radius: {{ settings.buttons_radius }}px;
    --rpl-buttons-border-width: {{ settings.buttons_border_thickness }}px;
    --rpl-buttons-shadow-opacity: {{ settings.buttons_shadow_opacity | divided_by: 100.0 }};

    --rpl-card-radius: {{ settings.card_radius }}px;
    --rpl-card-border-width: {{ settings.card_border_thickness }}px;
    --rpl-card-shadow-opacity: {{ settings.card_shadow_opacity | divided_by: 100.0 }};

    --rpl-media-radius: {{ settings.media_radius }}px;
  }
</style>
