{%- comment -%}
  Customer testimonials, grid or carousel (shares the same [data-carousel]
  scroll-snap enhancement as collection-list.liquid — no duplicated carousel
  logic).

  Handles: 0 blocks (renders nothing), a block with no photo (falls back to
  no avatar, not a broken image), no product tag, rating of 1-5, many
  blocks.
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} .rpl-testimonials__grid {
    --rpl-grid-columns-mobile: 1;
    --rpl-grid-columns-desktop: {{ section.settings.columns_desktop }};
  }
{% endstyle %}

{%- if section.blocks.size > 0 -%}
  <div class="rpl-color-{{ section.settings.color_scheme }}">
    <div class="rpl-container rpl-section">
      {%- if section.settings.heading != blank -%}
        <h2 class="rpl-testimonials__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.layout == 'carousel' -%}
        <div class="rpl-testimonials__carousel-wrap" data-carousel>
          <ul
            class="rpl-list-unstyled rpl-testimonials__carousel"
            data-carousel-track
            tabindex="0"
            role="region"
            aria-label="{{ section.settings.heading | default: 'Testimonials' | escape }}"
          >
            {%- for block in section.blocks -%}
              <li data-carousel-item {{ block.shopify_attributes }}>
                {% render 'testimonial-card', block: block %}
              </li>
            {%- endfor -%}
          </ul>

          <button type="button" class="rpl-icon-button rpl-testimonials__arrow rpl-testimonials__arrow--prev" data-carousel-prev>
            <span class="rpl-visually-hidden">{{ 'general.slideshow.previous_slide' | t }}</span>
            {% render 'icon', icon: 'chevron-left' %}
          </button>
          <button type="button" class="rpl-icon-button rpl-testimonials__arrow rpl-testimonials__arrow--next" data-carousel-next>
            <span class="rpl-visually-hidden">{{ 'general.slideshow.next_slide' | t }}</span>
            {% render 'icon', icon: 'chevron-right' %}
          </button>
        </div>
      {%- else -%}
        <ul class="rpl-grid rpl-testimonials__grid rpl-list-unstyled">
          {%- for block in section.blocks -%}
            <li class="rpl-reveal" {{ block.shopify_attributes }}>
              {% render 'testimonial-card', block: block %}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .rpl-testimonials__heading {
    margin-block-end: var(--rpl-space-md);
    text-align: center;
  }

  .rpl-testimonials__carousel-wrap {
    position: relative;
  }

  .rpl-testimonials__carousel {
    display: flex;
    gap: var(--rpl-grid-gap-horizontal);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--rpl-space-sm);
    padding-block-end: var(--rpl-space-2xs);
  }

  .rpl-testimonials__carousel > li {
    flex: 0 0 auto;
    width: min(85vw, 22rem);
    scroll-snap-align: start;
  }

  .rpl-testimonials__arrow {
    position: absolute;
    top: 40%;
    z-index: 1;
    background-color: rgb(var(--rpl-color-background));
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.15);
    opacity: 0;
    transition: opacity var(--rpl-duration-fast) var(--rpl-ease);
  }

  .rpl-testimonials__carousel-wrap:hover .rpl-testimonials__arrow,
  .rpl-testimonials__carousel-wrap:focus-within .rpl-testimonials__arrow {
    opacity: 1;
  }

  .rpl-testimonials__arrow--prev {
    inset-inline-start: var(--rpl-space-2xs);
  }

  .rpl-testimonials__arrow--next {
    inset-inline-end: var(--rpl-space-2xs);
  }

  @media (hover: none) {
    .rpl-testimonials__arrow {
      display: none;
    }
  }

  .rpl-testimonial-card {
    display: flex;
    flex-direction: column;
    gap: var(--rpl-space-2xs);
    height: 100%;
    padding: var(--rpl-space-sm);
    border-radius: var(--rpl-card-radius);
    border: var(--rpl-card-border-width) solid rgb(var(--rpl-color-foreground) / 0.15);
  }

  .rpl-testimonial-card__stars {
    display: flex;
    gap: 2px;
  }

  .rpl-testimonial-card__stars .rpl-icon {
    width: 1rem;
    height: 1rem;
    color: rgb(var(--rpl-color-foreground));
  }

  .rpl-testimonial-card__star--empty {
    opacity: 0.25;
  }

  .rpl-testimonial-card__quote {
    margin: 0;
    flex: 1 0 auto;
  }

  .rpl-testimonial-card__author {
    display: flex;
    align-items: center;
    gap: var(--rpl-space-2xs);
  }

  .rpl-testimonial-card__avatar {
    flex: 0 0 auto;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--rpl-radius-full);
    overflow: hidden;
  }

  .rpl-testimonial-card__name {
    margin: 0;
    font-weight: var(--rpl-font-body-weight-bold);
  }

  .rpl-testimonial-card__product {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "class": "rpl-section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "What customers are saying"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.collection_list_section.settings.layout.label",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.collection_list_section.settings.layout.options__1.label"
        },
        {
          "value": "carousel",
          "label": "t:sections.collection_list_section.settings.layout.options__2.label"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.all.columns_desktop.label",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.testimonials.blocks.testimonial.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "t:sections.testimonials.blocks.testimonial.settings.photo.label"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "t:sections.testimonials.blocks.testimonial.settings.quote.label",
          "default": "<p>This changed how I shop for essentials completely — never running out, and the subscription pricing actually saves me money.</p>"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "t:sections.testimonials.blocks.testimonial.settings.rating.label",
          "default": 5
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.testimonials.blocks.testimonial.settings.name.label",
          "default": "Jamie L."
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.testimonials.blocks.testimonial.settings.product.label"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:sections.testimonials.name",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial",
          "settings": {
            "name": "Priya K.",
            "quote": "<p>The refill reminders alone are worth it. I haven't had to think about reordering in months.</p>"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "name": "Sam T.",
            "quote": "<p>Fast shipping, great packaging, and the products are exactly as described.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
